{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["src/main/index.ts", "src/preload/index.cts", "src/renderer/src/main.tsx", "electron.vite.config.ts", "scripts/**/*.ts", "workers/*/src/index.ts", "workers/feedback-viewer/src/viewer.ts"],
			"project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}", "workers/*/src/**/*.ts", "!workers/*/src/worker-configuration.d.ts"]
		},
		"packages/arroxy-control": {"project": ["src/**/*.ts", "tests/**/*.ts"]},
		"packages/arroxy-mcp": {"entry": ["src/cli.ts"], "project": ["src/**/*.ts", "tests/**/*.ts"]},
		"packages/yt-dlp-bridge": {"project": ["src/**/*.ts", "tests/**/*.ts"]},
		"packages/ytdlp-errors": {"project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs", "*.config.ts"]}
	},
	"ignore": ["src/renderer/src/components/ui/**"],
	"ignoreExportsUsedInFile": {"interface": true, "type": true},
	"ignoreDependencies": ["@fontsource/jetbrains-mono", "@fontsource/noto-sans-khmer", "@fontsource/poppins", "@iconify-json/logos", "@iconify-json/simple-icons", "shadcn", "tw-animate-css", "tailwindcss", "@svgr/plugin-jsx"],
	"ignoreBinaries": ["msgmerge", "taskkill", "ditto", "robocopy", "hdiutil", "terminal-notifier", "shellcheck"],
	"ignoreUnresolved": ["~icons/.*"]
}
