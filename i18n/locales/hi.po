msgstr "{{title}} तैयार नहीं हो सका"

msgctxt "notifications.quickDownload.notAdded"
msgid "Couldn't add that link — try again"
msgstr "वह लिंक नहीं जोड़ा जा सका — फिर कोशिश करें"

#. Plural form "one" for hi: used for counts like 0, 1.
msgctxt "notifications.quickDownload.review_one"
