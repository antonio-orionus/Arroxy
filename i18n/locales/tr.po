msgid "yt-dlp docs (issue #10927)"
msgstr "yt-dlp belgeleri (issue #10927)"

msgctxt "wizard.formats.cookiesError.dpapi.explanation"
msgid "Chrome 127 and newer encrypts cookies in a way other apps can't read on Windows. Try one of the workarounds below."
msgstr "Chrome 127 ve daha yenisi çerezleri Windows’ta diğer uygulamaların okuyamayacağı şekilde şifreler. Aşağıdaki geçici çözümlerden birini dene."

msgctxt "wizard.formats.cookiesError.dpapi.fixFileBody"
msgid "Export cookies from Chrome with a browser extension, then switch this app to File mode and pick the exported file."
msgstr "Chrome’dan bir tarayıcı uzantısıyla çerezleri dışa aktar, sonra bu uygulamayı Dosya moduna geçirip dışa aktarılan dosyayı seç."

msgctxt "wizard.formats.cookiesError.dpapi.fixFileLabel"
msgid "Export cookies.txt"
msgstr "cookies.txt dışa aktar"

msgctxt "wizard.formats.cookiesError.dpapi.fixFirefoxBody"
msgid "Firefox doesn't use App-Bound Encryption. Open cookies settings and pick Firefox from the browser list."
msgstr "Firefox App-Bound Encryption kullanmaz. Çerez ayarlarını aç ve tarayıcı listesinden Firefox’u seç."

msgctxt "wizard.formats.cookiesError.dpapi.fixFirefoxLabel"
msgid "Switch to Firefox"
msgstr "Firefox’a geç"

msgctxt "wizard.formats.cookiesError.dpapi.fixUnsafeBody"
msgid "Add --disable-features=LockProfileCookieDatabase to Chrome's launch shortcut. Warning: this invalidates previously encrypted cookies, so you'll be signed out of every site and need to log in again."
msgstr "Chrome başlatma kısayoluna --disable-features=LockProfileCookieDatabase ekle. Uyarı: bu, daha önce şifrelenmiş çerezleri geçersiz kılar; tüm sitelerden çıkış yapılır ve yeniden giriş yapman gerekir."

msgctxt "wizard.formats.cookiesError.dpapi.fixUnsafeLabel"
msgid "Launch Chrome with App-Bound Encryption disabled"
msgstr "Chrome’u App-Bound Encryption devre dışı başlat"

msgctxt "wizard.formats.cookiesError.dpapi.heading"
msgid "Chrome cookies blocked by Windows encryption"
msgstr "Chrome çerezleri Windows şifrelemesi tarafından engellendi"

msgctxt "wizard.formats.cookiesError.explanationBrowser"
msgid "Cookies are read directly from the browser. If the browser is currently running, its cookie database may be locked (Chromium-family). The browser must also be signed in to YouTube. Try closing the browser, switching to a different browser, switching to File mode, or turning cookies off."
msgstr "Çerezler doğrudan tarayıcıdan okunur. Tarayıcı şu anda çalışıyorsa çerez veritabanı kilitli olabilir (Chromium ailesi). Tarayıcıda YouTube oturumu da açık olmalıdır. Tarayıcıyı kapatmayı, farklı bir tarayıcıya geçmeyi, Dosya moduna geçmeyi veya çerezleri kapatmayı dene."

msgctxt "wizard.formats.cookiesError.explanationFile"
msgid "Your cookies file might be empty, expired, or in the wrong format (Arroxy needs a Netscape cookies.txt file). Try re-exporting cookies, picking a different file, switching to Browser mode, or turning cookies off."
msgstr "Çerez dosyan boş, süresi dolmuş veya yanlış biçimde olabilir (Arroxy bir Netscape cookies.txt dosyasına ihtiyaç duyar). Çerezleri yeniden dışa aktarmayı, farklı bir dosya seçmeyi, Tarayıcı moduna geçmeyi veya çerezleri kapatmayı dene."

msgctxt "wizard.formats.cookiesError.exploreOffer.body"
msgid "Sign in with Explore and Arroxy will retry it."
msgstr "Keşfet'te oturum aç, Arroxy yeniden denesin."

msgctxt "wizard.formats.cookiesError.exploreOffer.cta"
msgid "Sign in with Explore"
msgstr "Keşfet'te oturum aç"

msgctxt "wizard.formats.cookiesError.exploreOffer.heading"
msgid "This video may need a YouTube account"
msgstr "Bu video bir YouTube hesabı gerektirebilir"

msgctxt "wizard.formats.cookiesError.exploreReuse.body"
msgid "You're signed in to Explore, but downloads aren't using that sign-in right now."
msgstr "Keşfet'te oturum açtın ama indirmeler şu anda bu oturumu kullanmıyor."

msgctxt "wizard.formats.cookiesError.exploreReuse.cta"
msgid "Use my Explore sign-in and retry"
msgstr "Keşfet oturumumu kullan ve yeniden dene"

msgctxt "wizard.formats.cookiesError.exploreReuse.heading"
msgid "This video may need a YouTube account"
msgstr "Bu video bir YouTube hesabı gerektirebilir"

msgctxt "wizard.formats.cookiesError.exploreSignedIn.body"
msgid "If this video needs an account, Arroxy uses your Explore sign-in automatically. It may be unavailable for another reason."
msgstr "Bu video hesap gerektiriyorsa Arroxy, Keşfet oturumunu otomatik olarak kullanır. Başka bir nedenle kullanılamıyor olabilir."

