msgctxt "playlistPresets.mp4Cap"
msgid "H.264 above 1080p is not available on YouTube — capped to 1080p automatically"
msgstr "H.264 بالاتر از 1080p در YouTube در دسترس نیست — به‌طور خودکار به 1080p محدود شد"

msgctxt "playlistPresets.tier.1080"
msgid "Up to 1080p"
msgstr "تا 1080p"

msgctxt "playlistPresets.tier.144"
msgid "Up to 144p"
msgstr "تا 144p"

msgctxt "playlistPresets.tier.1440"
msgid "Up to 1440p"
msgstr "تا 1440p"

msgctxt "playlistPresets.tier.2160"
msgid "Up to 4K"
msgstr "تا 4K"

msgctxt "playlistPresets.tier.240"
msgid "Up to 240p"
msgstr "تا 240p"

msgctxt "playlistPresets.tier.360"
msgid "Up to 360p"
msgstr "تا 360p"

msgctxt "playlistPresets.tier.480"
msgid "Up to 480p"
msgstr "تا 480p"

msgctxt "playlistPresets.tier.720"
msgid "Up to 720p"
msgstr "تا 720p"

msgctxt "playlistPresets.tier.best"
msgid "Best quality"
msgstr "بهترین کیفیت"

msgctxt "playlistPresets.tierDesc.1080"
msgid "Capped at 1080p, falls back to lower per item"
msgstr "محدود به 1080p؛ برای هر مورد در صورت نیاز وضوح پایین‌تری انتخاب می‌شود"

msgctxt "playlistPresets.tierDesc.144"
msgid "Smallest possible files"
msgstr "کوچک‌ترین فایل‌های ممکن"

msgctxt "playlistPresets.tierDesc.1440"
msgid "Capped at 2K, falls back to lower per item"
msgstr "محدود به 2K؛ برای هر مورد در صورت نیاز وضوح پایین‌تری انتخاب می‌شود"

msgctxt "playlistPresets.tierDesc.2160"
msgid "Capped at 2160p, falls back to lower per item"
msgstr "محدود به 2160p؛ برای هر مورد در صورت نیاز وضوح پایین‌تری انتخاب می‌شود"

msgctxt "playlistPresets.tierDesc.240"
msgid "Very small files, low quality"
msgstr "فایل‌های بسیار کوچک، کیفیت پایین"

msgctxt "playlistPresets.tierDesc.360"
msgid "Small files for tight bandwidth"
msgstr "فایل‌های کوچک برای پهنای باند محدود"

msgctxt "playlistPresets.tierDesc.480"
msgid "Low bandwidth"
msgstr "پهنای باند کم"

msgctxt "playlistPresets.tierDesc.720"
msgid "Smaller files, broad compatibility"
msgstr "فایل‌های کوچک‌تر، سازگاری گسترده"

msgctxt "playlistPresets.tierDesc.best"
msgid "Highest available video + audio per item"
msgstr "بالاترین کیفیت ویدیو و صدای موجود برای هر مورد"

msgctxt "playlistPresets.type.audio"
msgid "Audio"
msgstr "صدا"

msgctxt "playlistPresets.type.video"
msgid "Video"
msgstr "ویدیو"

msgctxt "playlistPresets.videoFormat.best"
msgid "Best native"
msgstr "بهترین نسخهٔ اصلی"

msgctxt "playlistPresets.videoFormat.mp4"
msgid "Smart TV H.264 MP4"
msgstr "MP4 با H.264 برای تلویزیون هوشمند"

msgctxt "playlistPresets.videoFormatDesc.best"
msgid "Best available container and codecs per item"
msgstr "بهترین محفظه و کدک‌های موجود برای هر مورد"

msgctxt "playlistPresets.videoFormatDesc.mp4"
msgid "Prefer H.264 video + AAC audio in MP4 when possible"
msgstr "در صورت امکان، ویدیوی H.264 و صدای AAC در MP4 ترجیح داده شود"

