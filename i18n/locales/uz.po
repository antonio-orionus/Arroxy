msgstr "Yangi profil"

msgctxt "wizard.url.profile.panelDescription"
msgid "Create, select, edit, or remove reusable download setups."
msgstr "Qayta ishlatiladigan yuklab olish sozlamalarini yarating, tanlang, tahrirlang yoki olib tashlang."

msgctxt "wizard.url.profile.panelTitle"
msgid "Download Profiles"
msgstr "Yuklab olish profillari"

msgctxt "wizard.url.profile.remove"
msgid "Remove"
msgstr "Olib tashlash"

msgctxt "wizard.url.profile.reset"
msgid "Reset"
msgstr "Qayta tiklash"

msgctxt "wizard.url.profile.switchAria"
msgid "Switch download profile: {{profileName}}"
msgstr "Yuklab olish profilini almashtirish: {{profileName}}"

msgctxt "wizard.url.profile.switchTitle"
msgid "Switch download profile"
msgstr "Yuklab olish profilini almashtirish"

msgctxt "wizard.url.proxy.clear"
msgid "Clear"
msgstr "Tozalash"

msgctxt "wizard.url.proxy.description"
msgid "Route traffic through a proxy — useful for geo-restricted content."
msgstr "Trafikni proksi orqali yo'naltirish — geo-cheklangan kontent uchun foydali."

msgctxt "wizard.url.proxy.label"
msgid "Proxy URL"
msgstr "Proxy URL"

msgctxt "wizard.url.proxy.placeholder"
msgid "http://host:port"
msgstr "http://host:port"

msgctxt "wizard.url.quickBulkAllFailed"
msgid "None of those URLs could be prepared"
msgstr "Bu URLlarning hech birini tayyorlab bo‘lmadi"

msgctxt "wizard.url.quickDownload"
msgid "Quick Download"
msgstr "Tez yuklab olish"

msgctxt "wizard.url.quickDownloadTooltip"
msgid "Will download using: {{profileName}}"
msgstr "{{profileName}} orqali yuklab olinadi"

msgctxt "wizard.url.quickFailed"
msgid "Couldn't add this one: {{error}}"
msgstr "Buni qo‘shib bo‘lmadi: {{error}}"

#. Plural form "one" for uz: used for counts like 1.
msgctxt "wizard.url.quickPartialFailed_one"
msgid "Queued what worked. {{count}} URL could not be prepared."
msgstr "Ishlagani navbatga qo‘shildi. {{count}} ta URL tayyorlanmadi."

#. Plural form "other" for uz: used for counts like 0, 2, 3, 4, 5, 6.
msgctxt "wizard.url.quickPartialFailed_other"
msgid "Queued what worked. {{count}} URLs could not be prepared."
msgstr "Ishlaganlari navbatga qo‘shildi. {{count}} ta URL tayyorlanmadi."

msgctxt "wizard.url.quickPrepareFailed"
msgid "Queue item could not be prepared"
msgstr "Navbat elementi tayyorlanmadi"

msgctxt "wizard.url.quickPreparing"
msgid "Preparing"
msgstr "Tayyorlanmoqda"

msgctxt "wizard.url.quickProbeFailed"
msgid "Probe failed"
msgstr "Tekshiruv muvaffaqiyatsiz"

msgctxt "wizard.url.quickQueued"
msgid "Added to queue"
msgstr "Navbatga qo‘shildi"

msgctxt "wizard.url.quickSingleOnly"
msgid "Paste a video, playlist, channel, or search URL to get started."
msgstr "Boshlash uchun video, pleylist, kanal yoki qidiruv URL manzilini joylang."

msgctxt "wizard.url.settings.behaviorDescription"
msgid "Global behavior that affects profile-driven downloads too."
msgstr "Profillar orqali boshqariladigan yuklamalarga ham taʼsir qiluvchi global xatti-harakat."

msgctxt "wizard.url.settings.behaviorHeading"
msgid "Download behavior"
msgstr "Yuklash xatti-harakati"

msgctxt "wizard.url.settings.inputHeading"
msgid "Input"
msgstr "Kiritish"

msgctxt "wizard.url.style.aurora.description"
msgid "Glass panels over a moving sky. Needs graphics acceleration."
msgstr "Harakatlanuvchi osmon ustidagi shishasimon panellar. Grafik tezlatish kerak."

msgctxt "wizard.url.style.aurora.label"
msgid "Aurora"
msgstr "Aurora"

msgctxt "wizard.url.style.minimal.description"
msgid "Solid, quiet surfaces. Runs light on any computer."
msgstr "Zich, sokin yuzalar. Istalgan kompyuterda yengil ishlaydi."

msgctxt "wizard.url.style.minimal.label"
msgid "Minimal"
msgstr "Minimalistik"

msgctxt "wizard.url.style.modeDescription"
msgid "Both styles come in light and dark."
msgstr "Ikkala uslub ham yorug' va qorong'i variantda mavjud."

msgctxt "wizard.url.style.modeLabel"
msgid "Style"
msgstr "Uslub"

msgctxt "wizard.url.style.panelDescription"
msgid "How Arroxy looks. Switch between light and dark in the footer."
msgstr "Arroxy ko'rinishini sozlang. Yorug' va qorong'i rejim o'rtasida pastki qatorda almashtiring."

msgctxt "wizard.url.style.panelTitle"
msgid "Appearance"
msgstr "Ko'rinish"

msgctxt "wizard.url.style.unavailableNotice"
msgid "{{style}} needs graphics acceleration, which isn't available right now, so Arroxy is showing {{fallback}}."
msgstr "{{style}} uchun grafik tezlatish kerak, hozir u mavjud emas, shuning uchun Arroxy {{fallback}} uslubini ko'rsatmoqda."

msgctxt "wizard.url.tabs.profiles"
msgid "Profiles"
msgstr "Profillar"

msgctxt "wizard.url.tabs.settings"
msgid "Settings"
msgstr "Sozlamalar"
