msgid "Back"
msgstr "Orqaga"

msgctxt "common.cancel"
msgid "Cancel"
msgstr "Bekor qilish"

msgctxt "common.continue"
msgid "Continue"
msgstr "Davom etish"

msgctxt "common.dismiss"
msgid "Dismiss"
msgstr "Yopish"

msgctxt "common.loading"
msgid "Loading"
msgstr "Yuklanmoqda…"

msgctxt "common.retry"
