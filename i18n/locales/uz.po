msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Ruxsat berish"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube ba'zi eski videolarni sun'iy intellekt yordamida yaratilgan o'lchamlarda taklif qiladi. “O'tkazib yuborish” asl oqimlarni saqlaydi; kattalashtirilgan oqimni baribir qo'lda tanlashingiz mumkin."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "SI kattalashtirgan oqimlar"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "O'tkazib yuborish"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Fikr-mulohaza"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Arroxy yoqdimi? Fikringizni bilmoqchiman! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Jurnallar"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Diagnostika faylini saqlash"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Jurnallar va ilova ma'lumotlarini Yuklanmalar jildidagi bitta faylga to'playdi, uni GitHub issue'ga biriktirish mumkin. Foydalanuvchi jildingiz nomi olib tashlanadi; video havolalari va sarlavhalari qoladi."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Yangi: bu yerda Aurora yoki Minimalistik uslubini tanlang"

msgctxt "app.theme"
msgid "Theme"
msgstr "Mavzu"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Kattalashtirish"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Kichraytirish"

