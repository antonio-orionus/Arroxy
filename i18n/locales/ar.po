msgctxt "wizard.url.networkPacing.summary"
msgid "Waits: {{requests}} between checks, {{downloads}} before media starts, {{subtitles}} before subtitle files."
msgstr "انتظار: {{requests}} بين الفحوصات، {{downloads}} قبل بدء الوسائط، {{subtitles}} قبل ملفات الترجمة."

msgctxt "wizard.url.networkPacing.tooltip"
msgid "These waits happen inside each download. How many downloads run at the same time is set separately, under Downloads at once."
msgstr "تحدث هذه الانتظارات داخل كل تنزيل. عدد التنزيلات التي تعمل في الوقت نفسه يُضبط بشكل منفصل ضمن «التنزيلات في وقت واحد»."

msgctxt "wizard.url.networkPacing.tooltips.balanced"
msgid "Default. Adds short pauses between requests and before media starts."
msgstr "الافتراضي. يضيف توقفات قصيرة بين الطلبات وقبل بدء الوسائط."

msgctxt "wizard.url.networkPacing.tooltips.careful"
msgid "Adds longer pauses for large playlists or networks that frequently hit limits."
msgstr "يضيف توقفات أطول لقوائم التشغيل الكبيرة أو الشبكات التي تصل إلى الحدود بشكل متكرر."

msgctxt "wizard.url.networkPacing.tooltips.custom"
msgid "Tune the advanced per-download controls yourself."
msgstr "اضبط بنفسك عناصر التحكم المتقدمة لكل تنزيل."

msgctxt "wizard.url.networkPacing.tooltips.off"
msgid "Uses only the small baseline pauses Arroxy keeps for media and subtitles."
msgstr "يستخدم فقط التوقفات الأساسية الصغيرة التي يحتفظ بها Arroxy للوسائط والترجمات."

msgctxt "wizard.url.networkPacing.units.seconds"
msgid "sec"
msgstr "ث"

