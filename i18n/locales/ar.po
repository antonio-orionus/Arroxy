msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "السماح"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "يعرض YouTube بعض الفيديوهات القديمة بأحجام صنعها بالذكاء الاصطناعي. يُبقي «تخطي» على التدفقات الأصلية؛ ولا يزال بإمكانك اختيار تدفق مُكبَّر يدويًا."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "تدفقات مُكبَّرة بالذكاء الاصطناعي"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "تخطي"

