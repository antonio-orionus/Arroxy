msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "Questo video ha limiti di età e non può essere scaricato senza un account connesso."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy auto-updates yt-dlp on launch, so the fix lands automatically once upstream ships it."
msgstr "È scattata la protezione anti-bot. È molto probabile che l'IP in uso sia segnalato (intervallo di data center o uscita VPN affollata). Cambia IP o scegli un altro endpoint VPN e riprova. Se il problema persiste, potrebbe trattarsi di una modifica temporanea del sito: Arroxy aggiorna automaticamente yt-dlp all'avvio, quindi la correzione arriverà appena verrà pubblicata a monte."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream and yt-dlp gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "Il server ha continuato a interrompere il download a metà e yt-dlp ha rinunciato dopo vari tentativi. Di solito accade con i formati video più grandi (4K HDR/VP9 ad alto bitrate). Riprova, cambia rete/VPN oppure scegli un formato a risoluzione inferiore."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. yt-dlp can't strip DRM, so the file can't be downloaded."
msgstr "Questo video è protetto da DRM. yt-dlp non può rimuovere il DRM, quindi il file non può essere scaricato."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "Questo video non è disponibile nella tua area geografica."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "Il tuo indirizzo IP sembra essere bloccato. Riprova più tardi o usa una VPN."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video requires a signed-in account. Set up a cookies.txt (Settings → Cookies) and retry."
msgstr "Questo video richiede un account connesso. Configura un cookies.txt (Impostazioni → Cookie) e riprova."

msgctxt "errors.ytdlp.missingDependency"
msgid "yt-dlp could not find ffmpeg or ffprobe. Repair the bundled binaries or set an FFmpeg location, then retry."
msgstr "yt-dlp non ha trovato ffmpeg o ffprobe. Ripara i binari inclusi oppure imposta il percorso di FFmpeg, quindi riprova."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "Errore di rete. Controlla la connessione e riprova."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "Spazio su disco insufficiente. Libera spazio e riprova."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. yt-dlp's extractor may have drifted. Arroxy auto-updates yt-dlp on launch — retry in a few minutes once the fix ships."
msgstr "Impossibile analizzare la risposta del sito. L'estrattore di yt-dlp potrebbe non essere più aggiornato. Arroxy aggiorna automaticamente yt-dlp all'avvio: riprova tra qualche minuto, quando sarà disponibile la correzione."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "yt-dlp finished downloading but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "yt-dlp ha completato il download, ma la post-elaborazione (unione/mux/conversione) non è riuscita. Spesso è un problema temporaneo di ffmpeg: riprova e, se persiste, prova una diversa combinazione di formati."

msgctxt "errors.ytdlp.rateLimit"
msgid "Site is rate-limiting requests. Wait a minute then retry."
msgstr "Il sito sta limitando le richieste. Attendi un minuto e riprova."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "Questo video non è disponibile: potrebbe essere privato, eliminato o bloccato nella tua area geografica."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "Download non riuscito. Consulta l'output non elaborato qui sotto."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "That URL isn't supported by yt-dlp. Try a different link from any of yt-dlp's supported sites."
msgstr "Questo URL non è supportato da yt-dlp. Prova un altro link da uno dei siti supportati da yt-dlp."

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "Scegli come denominare i file scaricati. Fai clic su un token per inserirlo. Usa / per ordinare i download in cartelle."

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "Inserisci un modello per il nome file."

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "Rimuovi la / in più: ogni cartella deve avere un nome."

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "Rimuovi i caratteri non consentiti nei nomi file: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "Questo nome di cartella non è consentito. Evita . e .. e nomi riservati come CON."

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "Aggiungi {title} o {id} al nome file, così ogni download avrà un nome univoco."

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} non può essere usato per denominare una cartella: la qualità non è nota finché il download non inizia."

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "{ o } senza corrispondenza: racchiudi i token in questo modo: {title}."

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "Il modello è troppo lungo."

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "Token sconosciuto {{token}}."

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "Senza {id}, Arroxy non può rilevare gli elementi della playlist già scaricati né generare playlist .m3u."

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "Modello del nome file"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "Non disponibile perché il modello del nome file non include {id} oppure ordina i download in cartelle."

