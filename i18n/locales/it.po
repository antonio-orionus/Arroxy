msgstr "Download in background… Posso fare più cose insieme 😎"

msgctxt "wizard.url.mascotCollection"
msgid "Quick queues loaded items with {{profileName}}. Interactive lets you inspect or select items first."
msgstr "Download rapido mette in coda gli elementi caricati con {{profileName}}. Download interattivo ti permette di esaminare o selezionare prima gli elementi."

msgctxt "wizard.url.mascotIdle"
msgid "Drop a link and let Arroxy pull it ✨"
msgstr "Inserisci un link e lascia fare ad Arroxy ✨"

msgctxt "wizard.url.mascotMixed"
msgid "This link points at one video inside a collection. Arroxy will ask which one you want before probing."
msgstr "Questo link punta a un solo video all’interno di una raccolta. Arroxy ti chiederà quale vuoi prima di analizzarlo."

msgctxt "wizard.url.mascotPreparing"
msgid "{{quickDownload}} is reading this link and applying {{profileName}}."
msgstr "{{quickDownload}} sta leggendo questo link e applicando {{profileName}}."

msgctxt "wizard.url.mascotQueued"
msgid "The queue is handling this download. You can paste another link while it works."
msgstr "La coda sta gestendo questo download. Puoi incollare un altro link mentre lavora."

msgctxt "wizard.url.mascotSingle"
msgid "Quick starts one download with {{profileName}}. Use Interactive for one-off changes."
msgstr "Download rapido avvia un download con {{profileName}}. Usa Download interattivo per modifiche una tantum."

msgctxt "wizard.url.nativeAudioPreference.compatible"
msgid "Compatible stereo"
msgstr "Stereo compatibile"

msgctxt "wizard.url.nativeAudioPreference.description"
msgid "Stereo or surround when a profile picks native audio. A profile can override it."
msgstr "Stereo o surround quando un profilo sceglie l'audio originale. Un profilo può sostituirla."

msgctxt "wizard.url.nativeAudioPreference.label"
