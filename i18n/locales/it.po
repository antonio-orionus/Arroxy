msgstr "es. 750K o 1,5M"

msgctxt "wizard.url.limitRate.description"
msgid "Cap bandwidth for media downloads. Request pacing below is usually the stronger rate-limit lever."
msgstr "Limita la larghezza di banda dei download multimediali. La cadenza delle richieste qui sotto è di solito lo strumento più efficace contro i limiti di frequenza."

msgctxt "wizard.url.limitRate.invalid"
