msgstr "မလုပ်တော့ပါ"

msgctxt "wizard.url.clipboard.replacedLink"
msgid "Replaced with copied link"
msgstr "ကူးယူထားသော လင့်ခ်ဖြင့် အစားထိုးခဲ့သည်"

