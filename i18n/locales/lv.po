msgstr "Lūdzu, uzgaidiet, līdz pārbaude beidzas — atskaņošanas saraksti un meklēšanas rezultāti var aizņemt kādu laiku."

msgctxt "wizard.formats.marker.aiDubbed"
msgid "AI dubbed"
msgstr "Ar MI dublēts"

msgctxt "wizard.formats.marker.aiUpscaled"
msgid "AI upscaled"
msgstr "Ar MI uzlabots"

msgctxt "wizard.formats.marker.audioDescription"
