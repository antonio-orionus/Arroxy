msgstr "Nyuso imara na tulivu. Inafanya kazi kwa wepesi kwenye kompyuta yoyote."

msgctxt "wizard.url.style.minimal.label"
msgid "Minimal"
msgstr "Rahisi"

msgctxt "wizard.url.style.modeDescription"
msgid "Both styles come in light and dark."
msgstr "Mitindo yote miwili ina toleo la mwanga na la giza."

msgctxt "wizard.url.style.modeLabel"
msgid "Style"
msgstr "Mtindo"

msgctxt "wizard.url.style.panelDescription"
msgid "How Arroxy looks. Switch between light and dark in the footer."
msgstr "Jinsi Arroxy inavyoonekana. Badilisha kati ya mwanga na giza chini ya dirisha."

msgctxt "wizard.url.style.panelTitle"
msgid "Appearance"
msgstr "Mwonekano"

msgctxt "wizard.url.style.unavailableNotice"
msgid "{{style}} needs graphics acceleration, which isn't available right now, so Arroxy is showing {{fallback}}."
msgstr "{{style}} inahitaji uongezaji kasi wa michoro, ambao haupatikani sasa hivi, kwa hiyo Arroxy inaonyesha {{fallback}}."

msgctxt "wizard.url.tabs.profiles"
msgid "Profiles"
msgstr "Wasifu"

msgctxt "wizard.url.tabs.settings"
msgid "Settings"
msgstr "Mipangilio"
