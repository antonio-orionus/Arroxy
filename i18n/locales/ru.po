msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Разрешать"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube предлагает некоторые старые видео в размерах, созданных с помощью ИИ. «Пропускать» оставляет исходные потоки; увеличенный поток всё равно можно выбрать вручную."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Потоки, увеличенные ИИ"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Пропускать"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Обратная связь"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Нравится Arroxy? Я бы хотел услышать твой отзыв! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Журналы"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Сохранить файл диагностики"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Собирает журналы и сведения о приложении в один файл в папке «Загрузки», готовый к прикреплению к issue на GitHub. Имя папки пользователя удаляется; ссылки и названия видео сохраняются."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Новое: выберите Aurora или Минимализм здесь"

msgctxt "app.theme"
msgid "Theme"
msgstr "Тема"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Увеличить"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Уменьшить"

