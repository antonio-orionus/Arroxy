msgid "GPLv3 · by Antonio Orionus"
msgstr "GPLv3 · от Antonio Orionus"

msgctxt "about.openTitle"
msgid "About Arroxy"
msgstr "Относно Arroxy"

msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "Бърза и удобна програма за изтегляне от YouTube и над 2000 други сайта."

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "Преглед на известията за трети страни"

msgctxt "about.websiteLink"
msgid "Website"
msgstr "Уебсайт"

msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Разрешаване"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube предлага някои стари видеа в размери, създадени с ИИ. „Пропускане“ запазва оригиналните потоци; увеличен поток пак можете да изберете ръчно."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Потоци, увеличени с ИИ"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Пропускане"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Отзиви"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Харесва ли ви Arroxy? Ще се радвам да чуя мнението ви! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Дневници"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Запазване на диагностичен файл"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Събира дневниците и данните за приложението в един файл в „Изтегляния“, готов за прикачване към проблем в GitHub. Името на вашата потребителска папка се премахва; връзките и заглавията на видеата остават."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Ново: изберете Aurora или Минимален тук"

msgctxt "app.theme"
msgid "Theme"
msgstr "Тема"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Увеличаване"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Намаляване"

