msgstr "Estereoa edo inguruko audioa, profil batek jatorrizko audioa aukeratzen duenean. Profil batek gainidatzi dezake."

msgctxt "wizard.url.nativeAudioPreference.label"
msgid "Native audio preference"
msgstr "Jatorrizko audioaren lehentasuna"

msgctxt "wizard.url.nativeAudioPreference.surround"
msgid "Prefer surround / Dolby"
msgstr "Lehenetsi inguruko audioa / Dolby"

msgctxt "wizard.url.networkPacing.description"
msgid "Add small waits during each download so Arroxy does not hit the site too aggressively. Values are in seconds."
msgstr "Gehitu itxaronaldi txikiak deskarga bakoitzean, Arroxy-k gunea gehiegi ez estutzeko. Balioak segundotan daude."

msgctxt "wizard.url.networkPacing.fields.maxSleepInterval"
msgid "Pause before media starts: max"
msgstr "Eten multimedia hasi aurretik: gehienez"

msgctxt "wizard.url.networkPacing.fields.sleepInterval"
msgid "Pause before media starts: min"
msgstr "Eten multimedia hasi aurretik: gutxienez"

msgctxt "wizard.url.networkPacing.fields.sleepRequests"
msgid "Wait between metadata checks"
msgstr "Itxaron metadatu-egiaztapenen artean"

msgctxt "wizard.url.networkPacing.fields.sleepSubtitles"
msgid "Wait before subtitle files"
msgstr "Itxaron azpititulu-fitxategien aurretik"

msgctxt "wizard.url.networkPacing.heading"
msgid "Gentle downloads"
msgstr "Deskarga leunak"

msgctxt "wizard.url.networkPacing.presetLabel"
msgid "How cautious should Arroxy be?"
msgstr "Zenbateko kontuz ibili behar du Arroxy-k?"

msgctxt "wizard.url.networkPacing.presets.balanced"
msgid "Balanced"
msgstr "Orekatua"

msgctxt "wizard.url.networkPacing.presets.careful"
msgid "Careful"
msgstr "Zuhurra"

msgctxt "wizard.url.networkPacing.presets.custom"
msgid "Custom"
msgstr "Pertsonalizatua"

msgctxt "wizard.url.networkPacing.presets.off"
msgid "Off"
msgstr "Desaktibatuta"

msgctxt "wizard.url.networkPacing.summary"
msgid "Waits: {{requests}} between checks, {{downloads}} before media starts, {{subtitles}} before subtitle files."
msgstr "Itxaronaldiak: {{requests}} egiaztapenen artean, {{downloads}} multimedia hasi aurretik, {{subtitles}} azpititulu-fitxategien aurretik."

msgctxt "wizard.url.networkPacing.tooltip"
msgid "These waits happen inside each download. How many downloads run at the same time is set separately, under Downloads at once."
msgstr "Itxaronaldi hauek deskarga bakoitzaren barruan gertatzen dira. Aldi berean zenbat deskarga exekutatzen diren bereizita ezartzen da, Aldi berako deskargak atalean."

msgctxt "wizard.url.networkPacing.tooltips.balanced"
msgid "Default. Adds short pauses between requests and before media starts."
msgstr "Lehenetsia. Eten labur batzuk gehitzen ditu eskaeren artean eta multimedia hasi aurretik."

msgctxt "wizard.url.networkPacing.tooltips.careful"
msgid "Adds longer pauses for large playlists or networks that frequently hit limits."
msgstr "Eten luzeagoak gehitzen ditu erreprodukzio-zerrenda handietarako edo maiz mugetara iristen diren sareetarako."

msgctxt "wizard.url.networkPacing.tooltips.custom"
msgid "Tune the advanced per-download controls yourself."
msgstr "Doitu zuk zeuk deskarga bakoitzeko kontrol aurreratuak."

msgctxt "wizard.url.networkPacing.tooltips.off"
msgid "Uses only the small baseline pauses Arroxy keeps for media and subtitles."
msgstr "Arroxy-k multimedia eta azpitituluetarako gordetzen dituen oinarrizko eten txikiak soilik erabiltzen ditu."

