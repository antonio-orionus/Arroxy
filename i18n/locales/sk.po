msgstr "Vložte odkaz a nechajte Arroxy, nech ho stiahne ✨"

msgctxt "wizard.url.mascotMixed"
msgid "This link points at one video inside a collection. Arroxy will ask which one you want before probing."
msgstr "Tento odkaz ukazuje na jedno video v kolekcii. Arroxy sa pred zisťovaním podrobností opýta, ktoré chcete."

msgctxt "wizard.url.mascotPreparing"
msgid "{{quickDownload}} is reading this link and applying {{profileName}}."
msgstr "{{quickDownload}} číta tento odkaz a používa profil {{profileName}}."

msgctxt "wizard.url.mascotQueued"
msgid "The queue is handling this download. You can paste another link while it works."
msgstr "Toto sťahovanie spracúva rad. Kým pracuje, môžete vložiť ďalší odkaz."

msgctxt "wizard.url.mascotSingle"
msgid "Quick starts one download with {{profileName}}. Use Interactive for one-off changes."
msgstr "Rýchle sťahovanie spustí jedno sťahovanie s profilom {{profileName}}. Pre jednorazové zmeny použite Interaktívne."

msgctxt "wizard.url.nativeAudioPreference.compatible"
