msgctxt "wizard.url.mascotCollection"
msgid "Quick queues loaded items with {{profileName}}. Interactive lets you inspect or select items first."
msgstr "Rýchle sťahovanie zaradí načítané položky do radu s profilom {{profileName}}. Interaktívne vám umožní položky najprv skontrolovať alebo vybrať."

msgctxt "wizard.url.mascotIdle"
