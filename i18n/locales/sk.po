msgid "Website"
msgstr "Webová stránka"

msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Povoliť"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube ponúka niektoré staré videá vo veľkostiach, ktoré vytvoril pomocou AI. Možnosť Preskočiť ponechá pôvodné streamy; zväčšený stream si môžete stále vybrať ručne."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Streamy zväčšené pomocou AI"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Preskočiť"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Spätná väzba"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Páči sa vám Arroxy? Rád by som sa dozvedel váš názor! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Protokoly"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Uložiť diagnostický súbor"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Uloží vaše protokoly a údaje o aplikácii do jedného súboru v priečinku Stiahnuté súbory, pripraveného na priloženie k hláseniu na GitHube. Názov vášho používateľského priečinka sa odstráni; odkazy na videá a názvy zostanú."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Novinka: tu si môžete vybrať Aurora alebo Minimal"

msgctxt "app.theme"
msgid "Theme"
msgstr "Motív"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Priblížiť"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Oddialiť"

