msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "Rýchly a prívetivý nástroj na sťahovanie z YouTube a viac ako 2000 ďalších webov."

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "Zobraziť upozornenia o softvéri tretích strán"

