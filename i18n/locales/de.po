msgstr "Zoom auf 100% zurücksetzen"

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "Lege fest, wie heruntergeladene Dateien benannt werden. Klicke auf einen Platzhalter, um ihn einzufügen. Nutze /, um Downloads in Ordner zu sortieren."

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "Gib eine Dateinamenvorlage ein."

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "Entferne das überzählige / — jeder Ordner braucht einen Namen."

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "Entferne Zeichen, die in Dateinamen nicht erlaubt sind: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "Dieser Ordnername ist nicht erlaubt. Vermeide . und .. sowie reservierte Namen wie CON."

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "Füge {title} oder {id} zum Dateinamen hinzu, damit jeder Download einen eigenen Namen erhält."

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} kann keinen Ordner benennen — die Qualität steht erst beim Start des Downloads fest."

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "Nicht geschlossene { oder } — schreibe Platzhalter wie {title}."

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "Die Vorlage ist zu lang."

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "Unbekannter Platzhalter {{token}}."

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "Ohne {id} kann Arroxy bereits heruntergeladene Playlist-Einträge nicht erkennen und keine .m3u-Playlists erstellen."

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "Dateinamenvorlage"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "Nicht verfügbar, weil deine Dateinamenvorlage entweder {id} nicht enthält oder Downloads in Ordner sortiert."

msgctxt "filenameTemplate.previewPlaylist"
msgid "In a playlist"
msgstr "In einer Wiedergabeliste"

msgctxt "filenameTemplate.previewSingle"
msgid "Single video"
msgstr "Einzelnes Video"

msgctxt "filenameTemplate.profileOverrideDescription"
msgid "Leave empty to inherit the global template."
msgstr "Leer lassen, um die globale Vorlage zu übernehmen."

msgctxt "filenameTemplate.profileOverrideLabel"
msgid "Filename template"
msgstr "Dateinamenvorlage"

msgctxt "fileType.auto"
msgid "Auto"
msgstr "Auto"

msgctxt "fileType.autoValue"
msgid "Auto (.{{ext}})"
msgstr "Auto (.{{ext}})"

msgctxt "fileType.description.auto"
msgid "The picked streams decide the file type."
msgstr "Die gewählten Streams bestimmen den Dateityp."

msgctxt "fileType.description.mkv"
msgid "Holds any codec. Some TVs and phones can't open it."
msgstr "Nimmt jeden Codec auf. Manche Fernseher und Handys können MKV nicht öffnen."

msgctxt "fileType.description.mp4"
msgid "Plays almost everywhere. VP9 in an MP4 won't play video in QuickTime."
msgstr "Läuft fast überall. VP9 in MP4 lässt sich in QuickTime nicht als Video abspielen."

msgctxt "fileType.description.webm"
msgid "Open format for browsers. Holds only VP9 or AV1 with Opus."
msgstr "Offenes Format für Browser. Enthält nur VP9 oder AV1 mit Opus."

msgctxt "fileType.mkv"
msgid "MKV"
msgstr "MKV"

