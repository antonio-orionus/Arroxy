msgid "Will download using: {{profileName}}"
msgstr "Prenos bo uporabil profil: {{profileName}}"

msgctxt "wizard.url.quickFailed"
msgid "Couldn't add this one: {{error}}"
msgstr "Tega ni bilo mogoče dodati: {{error}}"

#. Plural form "few" for sl: used for counts like 3, 4, 103, 104.
msgctxt "wizard.url.quickPartialFailed_few"
msgid "Queued what worked. {{count}} URLs could not be prepared."
msgstr "V vrsto je dodano, kar je uspelo. Naslovov URL, ki jih ni bilo mogoče pripraviti: {{count}}."

#. Plural form "one" for sl: used for counts like 1, 101.
msgctxt "wizard.url.quickPartialFailed_one"
msgid "Queued what worked. {{count}} URL could not be prepared."
msgstr "V vrsto je dodano, kar je uspelo. Naslovov URL, ki jih ni bilo mogoče pripraviti: {{count}}."

#. Plural form "other" for sl: used for counts like 0, 5, 6, 7, 8, 9.
msgctxt "wizard.url.quickPartialFailed_other"
msgid "Queued what worked. {{count}} URLs could not be prepared."
msgstr "V vrsto je dodano, kar je uspelo. Naslovov URL, ki jih ni bilo mogoče pripraviti: {{count}}."

#. Plural form "two" for sl: used for counts like 2, 102.
msgctxt "wizard.url.quickPartialFailed_two"
msgid "Queued what worked. {{count}} URLs could not be prepared."
msgstr "V vrsto je dodano, kar je uspelo. Naslovov URL, ki jih ni bilo mogoče pripraviti: {{count}}."

msgctxt "wizard.url.quickPrepareFailed"
msgid "Queue item could not be prepared"
msgstr "Elementa vrste ni bilo mogoče pripraviti"

msgctxt "wizard.url.quickPreparing"
msgid "Preparing"
msgstr "Priprava"

msgctxt "wizard.url.quickProbeFailed"
