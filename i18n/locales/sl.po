msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Arroxy deluje naprej in dokonča aktivne prenose. To lahko pozneje spremenite v naprednih nastavitvah."

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "Skrij v sistemsko vrstico"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "Naj se ob zapiranju Arroxy skrije v sistemsko vrstico?"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "Zapri program"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "Ne sprašuj več"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "Prekliči prenose in zapri"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "Začasno ustavite, da nadaljujete pozneje, ali prekličite in zavrzite napredek."

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "Nadaljuj s prenosom"

#. Plural form "few" for sl: used for counts like 3, 4, 103, 104.
msgctxt "dialogs.quitWithActiveDownloads.message_few"
msgid "{{count}} downloads in progress"
msgstr "{{count}} prenosi potekajo"

#. Plural form "one" for sl: used for counts like 1, 101.
msgctxt "dialogs.quitWithActiveDownloads.message_one"
msgid "{{count}} download in progress"
msgstr "{{count}} prenos poteka"

#. Plural form "other" for sl: used for counts like 0, 5, 6, 7, 8, 9.
msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "{{count}} prenosov poteka"

#. Plural form "two" for sl: used for counts like 2, 102.
msgctxt "dialogs.quitWithActiveDownloads.message_two"
msgid "{{count}} downloads in progress"
msgstr "{{count}} prenosa potekata"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "Začasno ustavi prenose in zapri"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "Proces upodabljanja se je zrušil ({{reason}}). Znova naložite in poskusite znova."

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "V programu Arroxy je prišlo do težave"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "Zapri program"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "Znova naloži"

msgctxt "donate.copied"
msgid "Copied!"
msgstr "Kopirano!"

msgctxt "donate.copyAddress"
msgid "Copy address"
msgstr "Kopiraj naslov"

msgctxt "donate.description"
msgid "Arroxy is free and open-source, with no ads or paid tier. Donations are optional and buy no influence over the roadmap."
msgstr "Arroxy je brezplačen in odprtokoden, brez oglasov in plačljive različice. Donacije so neobvezne in ne dajejo vpliva na razvojni načrt."

msgctxt "donate.footerLabel"
msgid "Donate"
msgstr "Doniraj"

msgctxt "donate.footerTooltip"
msgid "Support Arroxy"
msgstr "Podprite Arroxy"

msgctxt "donate.qrAlt"
msgid "{{coin}} donation address QR code"
msgstr "QR-koda naslova za donacije v {{coin}}"

msgctxt "donate.title"
msgid "Support Arroxy"
msgstr "Podprite Arroxy"

msgctxt "donate.warning"
msgid "Crypto payments are irreversible. Send only on the network shown, and compare the whole address."
msgstr "Plačila s kriptovalutami so nepovratna. Pošiljajte samo v prikazanem omrežju in primerjajte celoten naslov."

msgctxt "errors.noSubtitlesIn"
msgid "This video has no subtitles in {{languages}}."
msgstr "Ta videoposnetek nima podnapisov v jezikih: {{languages}}."

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "Ta videoposnetek je starostno omejen in ga ni mogoče prenesti brez prijavljenega računa."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy updates its download engine on launch, so the fix lands automatically once it ships."
msgstr "Sprožena je bila zaščita pred boti. Vaš naslov IP je najverjetneje označen (razpon podatkovnega centra ali obremenjen izhod VPN). Zamenjajte naslov IP ali izberite drugo končno točko VPN in poskusite znova. Če še vedno ne deluje, gre morda za začasno spremembo na strani spletnega mesta — Arroxy ob zagonu posodobi svoj mehanizem za prenos, zato bo popravek samodejno prispel, ko bo izdan."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream, and Arroxy gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "Strežnik je med prenosom večkrat prekinil povezavo, Arroxy pa je po ponovnih poskusih obupal. To se najpogosteje zgodi pri največjih video formatih (4K HDR / VP9 z visoko bitno hitrostjo). Poskusite znova, zamenjajte omrežje ali VPN oziroma izberite format z nižjo ločljivostjo."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. Arroxy can't remove DRM, so the file can't be downloaded."
msgstr "Ta videoposnetek je zaščiten z DRM. Arroxy ne more odstraniti DRM, zato datoteke ni mogoče prenesti."

msgctxt "errors.ytdlp.formatUnavailable"
msgid "This video no longer offers the format you picked. Paste the link again and pick from the formats it offers now."
msgstr "Ta videoposnetek ne ponuja več formata, ki ste ga izbrali. Znova prilepite povezavo in izberite med formati, ki jih ponuja zdaj."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "Ta videoposnetek v vaši regiji ni na voljo."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "Videti je, da je vaš naslov IP blokiran. Poskusite znova pozneje ali uporabite VPN."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "Ta videoposnetek zahteva prijavljen račun."

msgctxt "errors.ytdlp.missingDependency"
msgid "Arroxy could not find FFmpeg or FFprobe. Run setup again or set an FFmpeg location, then retry the download."
msgstr "Arroxy ni našel programa FFmpeg ali FFprobe. Znova zaženite namestitev ali nastavite mesto programa FFmpeg, nato znova poskusite prenos."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "Omrežna napaka. Preverite povezavo in poskusite znova."

msgctxt "errors.ytdlp.noSubtitles"
msgid "This video has no subtitles in the requested languages."
msgstr "Ta videoposnetek nima podnapisov v zahtevanih jezikih."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "Na disku ni dovolj prostora. Sprostite prostor in poskusite znova."

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Arroxy ne more pisati v mapo za prenose. Morda je samo za branje, na zaklenjenem pogonu ali blokirana z nastavitvami zasebnosti vašega sistema. Izberite drugo mapo ali dovolite dostop, nato poskusite znova."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. The site may have changed how it serves videos. Arroxy updates its download engine on launch — retry in a few minutes once the fix ships."
msgstr "Odgovora spletnega mesta ni bilo mogoče razčleniti. Spletno mesto je morda spremenilo način ponujanja videoposnetkov. Arroxy ob zagonu posodobi svoj mehanizem za prenos — poskusite znova čez nekaj minut, ko bo popravek izdan."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "The download finished, but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "Prenos je končan, vendar poobdelava (združevanje / multipleksiranje / pretvorba) ni uspela. Pogosto gre za začasno težavo s programom ffmpeg — poskusite znova, če pa se ponavlja, izberite drugo kombinacijo formatov."

msgctxt "errors.ytdlp.rateLimit"
msgid "The site is rate-limiting requests from this connection."
msgstr "Spletno mesto omejuje število zahtev s te povezave."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "Ta videoposnetek ni na voljo — morda je zaseben, izbrisan ali omejen na določeno regijo."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "Prenos ni uspel. Glejte neobdelan izpis spodaj."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "Arroxy doesn't support this URL. Try a link from a different site."
msgstr "Arroxy tega naslova URL ne podpira. Poskusite s povezavo z drugega spletnega mesta."

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "Preverite povezavo in poskusite znova."

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "Ta stran se ni naložila"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "Odpri nastavitve"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "Preverite proxy v nastavitvah in poskusite znova."

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "Razišči se ne more povezati prek vašega proxyja"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "Poskusi znova"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "Z desno tipko miške kliknite katero koli povezavo do videoposnetka, seznama predvajanja ali kanala na strani, da ga prenesete z aktivnim profilom, izberete drug profil ali odprete postopni potek."

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "Z desnim klikom na povezavo jo prenesite"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "Kopiraj povezavo"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "Prenesi z"

msgctxt "explore.newBadge"
msgid "New"
msgstr "Novo"

msgctxt "explore.notice.body"
msgid "Find a video on YouTube or any other site and download it from here — no copying links. Sign in to a site here to download videos that need an account."
msgstr "Poiščite videoposnetek na YouTubu ali katerem koli drugem spletnem mestu in ga prenesite kar tukaj — brez kopiranja povezav. Tu se prijavite v spletno mesto, da lahko prenesete videoposnetke, ki zahtevajo račun."

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "Naprej"

msgctxt "explore.notice.riskBody"
msgid "Sites like YouTube may flag — and sometimes ban — accounts used with download tools like Arroxy. Use an account you can afford to lose, not your main one."
msgstr "Spletna mesta, kot je YouTube, lahko račune, ki se uporabljajo z orodji za prenos, kot je Arroxy, označijo in jih včasih tudi prepovejo. Uporabite račun, ki si ga lahko privoščite izgubiti, ne glavnega."

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "Prijavite se s sekundarnim računom"

msgctxt "explore.notice.title"
msgid "Browse the web right inside Arroxy"
msgstr "Brskajte po spletu kar v programu Arroxy"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "Prenosi uporabljajo piškotke vašega brskalnika, ne prijave v Razišči."

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "Prenosi uporabljajo vašo datoteko s piškotki, ne prijave v Razišči."

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "Ne zdaj"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "Piškotki so izklopljeni, zato prenosi ne uporabljajo vaše prijave v Razišči."

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "Uporabi prijavo v Razišči"

msgctxt "explore.settings.description"
msgid "Browse YouTube or any other site inside Arroxy, and sign in for videos that need an account."
msgstr "Brskajte po YouTubu ali katerem koli drugem spletnem mestu v programu Arroxy in se prijavite za videoposnetke, ki zahtevajo račun."

msgctxt "explore.settings.idleUnload"
msgid "Free memory while away"
msgstr "Sprosti pomnilnik ob odsotnosti"

msgctxt "explore.settings.idleUnloadDescription"
msgid "After 5 minutes on another tab, closes the YouTube home or search page. Coming back reloads it, which takes a few seconds."
msgstr "Po 5 minutah na drugem zavihku zapre domačo stran ali stran z iskanjem na YouTubu. Ob vrnitvi se znova naloži, kar traja nekaj sekund."

msgctxt "explore.settings.searchEngine"
msgid "Search engine"
msgstr "Iskalnik"

msgctxt "explore.settings.searchEngineDescription"
msgid "Where text typed in the address bar is searched. Links open as typed."
msgstr "Kje se išče besedilo, vpisano v naslovno vrstico. Povezave se odprejo, kot so vpisane."

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "Pokaži zavihek Razišči"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "Če ga izklopite, prenosi prav tako prenehajo uporabljati vašo prijavo v Razišči."

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "Odjava iz Razišči"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "Odjava"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your sign-ins and browsing data in Explore, on every site. Downloads that need an account will fail until you sign in again."
msgstr "S tem izbrišete prijave in podatke brskanja v Razišči za vsa spletna mesta. Prenosi, ki zahtevajo račun, ne bodo uspeli, dokler se ne prijavite znova."

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "Se odjavite iz Razišči?"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your sign-ins and browsing data in Explore, on every site."
msgstr "Izbriše prijave in podatke brskanja v Razišči za vsa spletna mesta."

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "Razišči"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "Razišči"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "YouTube se lahko upira blokatorjem oglasov pri prijavljenih računih."

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "Blokator oglasov"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "Blokator oglasov: izklopljen — kliknite za vklop"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "Blokator oglasov: vklopljen — kliknite za izklop"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "Blokator oglasov: zaganja se — kliknite za izklop"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "Blokator oglasov: ni na voljo, njegovih filtrirnih seznamov ni bilo mogoče prenesti — kliknite za izklop"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
msgstr "Naslov"

msgctxt "explore.toolbar.addressPlaceholder"
msgid "Search {{engine}} or open any site (Vimeo, Instagram…)"
msgstr "Iščite v {{engine}} ali odprite katero koli spletno mesto (Vimeo, Instagram …)"

msgctxt "explore.toolbar.aria"
msgid "Explore browser controls"
msgstr "Kontrolniki brskalnika Razišči"

msgctxt "explore.toolbar.back"
msgid "Back"
msgstr "Nazaj"

msgctxt "explore.toolbar.compactLayout"
msgid "Compact layout"
msgstr "Strnjena postavitev"

msgctxt "explore.toolbar.downloadWithProfile"
msgid "Download · {{profileName}}"
msgstr "Prenesi · {{profileName}}"

msgctxt "explore.toolbar.forward"
msgid "Forward"
msgstr "Naprej"

msgctxt "explore.toolbar.fullLayout"
msgid "Show full layout"
msgstr "Pokaži polno postavitev"

msgctxt "explore.toolbar.grabUnavailable"
msgid "Open a video, playlist, or channel to download it"
msgstr "Odprite videoposnetek, seznam predvajanja ali kanal, da ga prenesete"

msgctxt "explore.toolbar.home"
msgid "YouTube home"
msgstr "Domača stran YouTuba"

msgctxt "explore.toolbar.interactiveHint"
msgid "Interactive Download: choose format, subtitles and more…"
msgstr "Interaktivni prenos: izberite format, podnapise in drugo …"

msgctxt "explore.toolbar.refusedHint"
msgid "Explore can't open that address."
msgstr "Razišči ne more odpreti tega naslova."

msgctxt "explore.toolbar.reload"
msgid "Reload"
msgstr "Znova naloži"

msgctxt "explore.toolbar.searchTooLong"
msgid "That search is too long."
msgstr "To iskanje je predolgo."

msgctxt "explore.toolbar.zoom.hint"
msgid "Page zoom: {{percent}}%"
msgstr "Povečava strani: {{percent}} %"

msgctxt "explore.toolbar.zoom.in"
msgid "Zoom in"
msgstr "Povečaj"

msgctxt "explore.toolbar.zoom.label"
msgid "Page zoom"
msgstr "Povečava strani"

msgctxt "explore.toolbar.zoom.out"
msgid "Zoom out"
msgstr "Pomanjšaj"

msgctxt "explore.toolbar.zoom.percent"
msgid "Zoom percent"
msgstr "Odstotek povečave"

msgctxt "explore.toolbar.zoom.reset"
msgid "Reset zoom to 100%"
msgstr "Ponastavi povečavo na 100 %"

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "Izberite, kako se poimenujejo prenesene datoteke. Kliknite žeton, da ga vstavite. Z znakom / razvrstite prenose v mape."

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "Vnesite predlogo imena datoteke."

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "Odstranite odvečni znak / — vsaka mapa potrebuje ime."

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "Odstranite znake, ki v imenih datotek niso dovoljeni: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "To ime mape ni dovoljeno. Izogibajte se . in .. ter rezerviranim imenom, kot je CON."

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "V ime datoteke dodajte {title} ali {id}, da vsak prenos dobi svoje ime."

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} ne more poimenovati mape — kakovost ni znana, dokler se prenos ne začne."

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "Neujemajoč { ali } — žetone, kot je {title}, ovijte v zavite oklepaje."

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
