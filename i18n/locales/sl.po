msgstr "Kako Arroxy izgleda. Med svetlo in temno različico preklopite v nogi."

msgctxt "wizard.url.style.panelTitle"
msgid "Appearance"
msgstr "Videz"

msgctxt "wizard.url.style.unavailableNotice"
msgid "{{style}} needs graphics acceleration, which isn't available right now, so Arroxy is showing {{fallback}}."
msgstr "{{style}} zahteva grafično pospeševanje, ki trenutno ni na voljo, zato Arroxy prikazuje {{fallback}}."

