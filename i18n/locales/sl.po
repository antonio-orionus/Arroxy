msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Dovoli"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube nekatere stare videoposnetke ponuja v velikostih, ki jih je ustvarila umetna inteligenca. Z možnostjo Preskoči ohranite izvirne tokove; povečanega lahko še vedno izberete ročno."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Toki, povečani z umetno inteligenco"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Preskoči"

