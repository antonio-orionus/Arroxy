msgctxt "wizard.url.style.aurora.description"
msgid "Glass panels over a moving sky. Needs graphics acceleration."
msgstr "Скляні панелі на тлі рухомого неба. Потрібне графічне прискорення."

msgctxt "wizard.url.style.aurora.label"
msgid "Aurora"
msgstr "Aurora"

msgctxt "wizard.url.style.minimal.description"
msgid "Solid, quiet surfaces. Runs light on any computer."
msgstr "Суцільні, спокійні поверхні. Легко працює на будь-якому комп'ютері."

msgctxt "wizard.url.style.minimal.label"
