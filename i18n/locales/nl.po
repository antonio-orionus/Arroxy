msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Arroxy blijft actief en rondt actieve downloads af. Je kunt dit later wijzigen in de geavanceerde instellingen."

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "Naar systeemvak"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "Arroxy naar het systeemvak verbergen bij het sluiten?"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "Afsluiten"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "Niet meer vragen"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "Downloads annuleren en afsluiten"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "Pauzeer om later te hervatten, of annuleer om de voortgang te verwijderen."

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "Doorgaan met downloaden"

#. Plural form "one" for nl: used for counts like 1.
msgctxt "dialogs.quitWithActiveDownloads.message_one"
msgid "{{count}} download in progress"
msgstr "{{count}} download bezig"

#. Plural form "other" for nl: used for counts like 0, 2, 3, 4, 5, 6.
msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "{{count}} downloads bezig"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "Downloads pauzeren en afsluiten"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "Het renderproces is gecrasht ({{reason}}). Laad opnieuw om het nogmaals te proberen."

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "Er is een probleem opgetreden in Arroxy"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "Afsluiten"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "Opnieuw laden"

msgctxt "donate.copied"
msgid "Copied!"
msgstr "Gekopieerd!"

msgctxt "donate.copyAddress"
msgid "Copy address"
msgstr "Adres kopiëren"

msgctxt "donate.description"
msgid "Arroxy is free and open-source, with no ads or paid tier. Donations are optional and buy no influence over the roadmap."
msgstr "Arroxy is gratis en open source, zonder advertenties of betaald abonnement. Donaties zijn vrijwillig en geven geen invloed op de roadmap."

msgctxt "donate.footerLabel"
msgid "Donate"
msgstr "Doneren"

msgctxt "donate.footerTooltip"
msgid "Support Arroxy"
msgstr "Steun Arroxy"

msgctxt "donate.qrAlt"
msgid "{{coin}} donation address QR code"
msgstr "QR-code van het {{coin}}-donatieadres"

msgctxt "donate.title"
msgid "Support Arroxy"
msgstr "Steun Arroxy"

msgctxt "donate.warning"
msgid "Crypto payments are irreversible. Send only on the network shown, and compare the whole address."
msgstr "Cryptobetalingen zijn onomkeerbaar. Verstuur alleen via het getoonde netwerk en vergelijk het hele adres."

msgctxt "errors.noSubtitlesIn"
msgid "This video has no subtitles in {{languages}}."
msgstr "Deze video heeft geen ondertitels in {{languages}}."

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "Deze video heeft een leeftijdsbeperking en kan niet worden gedownload zonder aangemeld account."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy updates its download engine on launch, so the fix lands automatically once it ships."
msgstr "Botbeveiliging geactiveerd. Het IP-adres dat je gebruikt is waarschijnlijk gemarkeerd (datacenterbereik of drukbezet VPN-uitgangspunt). Wijzig je IP-adres of kies een ander VPN-eindpunt en probeer het opnieuw. Blijft het mislukken, dan gaat het mogelijk om een tijdelijke wijziging aan de kant van de site — Arroxy werkt de downloadengine bij het opstarten bij, dus de oplossing komt automatisch zodra die uitkomt."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream, and Arroxy gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "De server verbrak de download steeds halverwege en Arroxy gaf het op na meerdere pogingen. Dit gebeurt meestal bij de grootste videoformaten (4K HDR / VP9 met hoge bitrate). Probeer het opnieuw, wissel van netwerk/VPN of kies een formaat met lagere resolutie."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. Arroxy can't remove DRM, so the file can't be downloaded."
msgstr "Deze video is beveiligd met DRM. Arroxy kan DRM niet verwijderen, dus het bestand kan niet worden gedownload."

msgctxt "errors.ytdlp.formatUnavailable"
msgid "This video no longer offers the format you picked. Paste the link again and pick from the formats it offers now."
msgstr "Deze video biedt het formaat dat je koos niet meer aan. Plak de link opnieuw en kies uit de formaten die nu beschikbaar zijn."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "Deze video is niet beschikbaar in jouw regio."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "Je IP-adres lijkt te zijn geblokkeerd. Probeer het later opnieuw of gebruik een VPN."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "Voor deze video is een aangemeld account nodig."

msgctxt "errors.ytdlp.missingDependency"
msgid "Arroxy could not find FFmpeg or FFprobe. Run setup again or set an FFmpeg location, then retry the download."
msgstr "Arroxy kon FFmpeg of FFprobe niet vinden. Voer de installatie opnieuw uit of stel een FFmpeg-locatie in en probeer de download daarna opnieuw."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "Netwerkfout. Controleer je verbinding en probeer het opnieuw."

msgctxt "errors.ytdlp.noSubtitles"
msgid "This video has no subtitles in the requested languages."
msgstr "Deze video heeft geen ondertitels in de gevraagde talen."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "Onvoldoende schijfruimte. Maak ruimte vrij en probeer het opnieuw."

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Arroxy kan niet naar de downloadmap schrijven. De map is mogelijk alleen-lezen, staat op een vergrendelde schijf of wordt geblokkeerd door de privacyinstellingen van je systeem. Kies een andere map of sta toegang toe en probeer het opnieuw."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. The site may have changed how it serves videos. Arroxy updates its download engine on launch — retry in a few minutes once the fix ships."
msgstr "Het antwoord van de site kon niet worden verwerkt. De site heeft mogelijk gewijzigd hoe video’s worden aangeboden. Arroxy werkt de downloadengine bij het opstarten bij — probeer het over een paar minuten opnieuw zodra de oplossing er is."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "The download finished, but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "De download is voltooid, maar de nabewerking (samenvoegen / muxen / converteren) is mislukt. Vaak is dit een tijdelijk ffmpeg-probleem — probeer het opnieuw en probeer een andere combinatie van formaten als het blijft mislukken."

msgctxt "errors.ytdlp.rateLimit"
msgid "The site is rate-limiting requests from this connection."
msgstr "De site beperkt het aantal verzoeken vanaf deze verbinding."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "Deze video is niet beschikbaar — mogelijk is hij privé, verwijderd of vergrendeld voor jouw regio."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "Download mislukt. Zie de onbewerkte uitvoer hieronder."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "Arroxy doesn't support this URL. Try a link from a different site."
msgstr "Arroxy ondersteunt deze URL niet. Probeer een link van een andere site."

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "Controleer je verbinding en probeer het opnieuw."

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "Deze pagina is niet geladen"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "Instellingen openen"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "Controleer de proxy in de instellingen en probeer het opnieuw."

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "Verkennen kan geen verbinding maken via je proxy"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "Opnieuw proberen"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "Klik met de rechtermuisknop op een video-, afspeellijst- of kanaallink op de pagina om te downloaden met je actieve profiel, een ander profiel te kiezen of de stapsgewijze flow te openen."

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "Klik met rechts op een link om te downloaden"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "Link kopiëren"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "Downloaden met"

msgctxt "explore.newBadge"
msgid "New"
msgstr "Nieuw"

msgctxt "explore.notice.body"
msgid "Find a video on YouTube or any other site and download it from here — no copying links. Sign in to a site here to download videos that need an account."
msgstr "Zoek een video op YouTube of een andere site en download hem hier — zonder links te kopiëren. Meld je hier aan bij een site om video’s te downloaden waarvoor een account nodig is."

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "Doorgaan"

msgctxt "explore.notice.riskBody"
msgid "Sites like YouTube may flag — and sometimes ban — accounts used with download tools like Arroxy. Use an account you can afford to lose, not your main one."
msgstr "Sites zoals YouTube kunnen accounts die met downloadtools als Arroxy worden gebruikt markeren — en soms blokkeren. Gebruik een account dat je kunt missen, niet je hoofdaccount."

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "Meld je aan met een tweede account"

msgctxt "explore.notice.title"
msgid "Browse the web right inside Arroxy"
msgstr "Surf over het web, direct in Arroxy"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "Downloads gebruiken de cookies van je browser, niet je aanmelding in Verkennen."

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "Downloads gebruiken je cookiebestand, niet je aanmelding in Verkennen."

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "Niet nu"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "Cookies staan uit, dus downloads gebruiken je aanmelding in Verkennen niet."

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "Aanmelding in Verkennen gebruiken"

msgctxt "explore.settings.description"
msgid "Browse YouTube or any other site inside Arroxy, and sign in for videos that need an account."
msgstr "Surf op YouTube of een andere site in Arroxy en meld je aan voor video’s waarvoor een account nodig is."

msgctxt "explore.settings.idleUnload"
msgid "Free memory while away"
msgstr "Geheugen vrijgeven bij afwezigheid"

msgctxt "explore.settings.idleUnloadDescription"
msgid "After 5 minutes on another tab, closes the YouTube home or search page. Coming back reloads it, which takes a few seconds."
msgstr "Na 5 minuten op een ander tabblad wordt de YouTube-startpagina of zoekpagina gesloten. Bij terugkeer wordt hij opnieuw geladen, wat een paar seconden duurt."

msgctxt "explore.settings.searchEngine"
msgid "Search engine"
msgstr "Zoekmachine"

msgctxt "explore.settings.searchEngineDescription"
msgid "Where text typed in the address bar is searched. Links open as typed."
msgstr "Waar tekst uit de adresbalk wordt gezocht. Links worden geopend zoals ingetypt."

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "Tabblad Verkennen tonen"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "Als je dit uitschakelt, gebruiken downloads ook je aanmelding in Verkennen niet meer."

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "Afmelden bij Verkennen"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "Afmelden"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your sign-ins and browsing data in Explore, on every site. Downloads that need an account will fail until you sign in again."
msgstr "Hiermee worden je aanmeldingen en browsegegevens in Verkennen gewist, voor alle sites. Downloads waarvoor een account nodig is, mislukken tot je je opnieuw aanmeldt."

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "Afmelden bij Verkennen?"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your sign-ins and browsing data in Explore, on every site."
msgstr "Wist je aanmeldingen en browsegegevens in Verkennen, voor alle sites."

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "Verkennen"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "Verkennen"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "YouTube kan bij aangemelde accounts bezwaren hebben tegen advertentieblokkers."

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "Advertentieblokkering"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "Advertentieblokkering: uit — klik om in te schakelen"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "Advertentieblokkering: aan — klik om uit te schakelen"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "Advertentieblokkering: starten — klik om uit te schakelen"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "Advertentieblokkering: niet beschikbaar, de filterlijsten konden niet worden gedownload — klik om uit te schakelen"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
msgstr "Adres"

msgctxt "explore.toolbar.addressPlaceholder"
msgid "Search {{engine}} or open any site (Vimeo, Instagram…)"
msgstr "Zoek op {{engine}} of open een site (Vimeo, Instagram…)"

msgctxt "explore.toolbar.aria"
msgid "Explore browser controls"
msgstr "Browserbediening van Verkennen"

msgctxt "explore.toolbar.back"
msgid "Back"
msgstr "Terug"

msgctxt "explore.toolbar.compactLayout"
msgid "Compact layout"
msgstr "Compacte weergave"

msgctxt "explore.toolbar.downloadWithProfile"
msgid "Download · {{profileName}}"
msgstr "Downloaden · {{profileName}}"

msgctxt "explore.toolbar.forward"
msgid "Forward"
msgstr "Vooruit"

msgctxt "explore.toolbar.fullLayout"
msgid "Show full layout"
msgstr "Volledige weergave tonen"

msgctxt "explore.toolbar.grabUnavailable"
msgid "Open a video, playlist, or channel to download it"
msgstr "Open een video, afspeellijst of kanaal om te downloaden"

msgctxt "explore.toolbar.home"
msgid "YouTube home"
msgstr "YouTube-startpagina"

msgctxt "explore.toolbar.interactiveHint"
msgid "Interactive Download: choose format, subtitles and more…"
msgstr "Interactief downloaden: kies formaat, ondertitels en meer…"

msgctxt "explore.toolbar.refusedHint"
msgid "Explore can't open that address."
msgstr "Verkennen kan dat adres niet openen."

msgctxt "explore.toolbar.reload"
msgid "Reload"
msgstr "Opnieuw laden"

msgctxt "explore.toolbar.searchTooLong"
msgid "That search is too long."
msgstr "Die zoekopdracht is te lang."

msgctxt "explore.toolbar.zoom.hint"
msgid "Page zoom: {{percent}}%"
msgstr "Paginazoom: {{percent}}%"

msgctxt "explore.toolbar.zoom.in"
msgid "Zoom in"
msgstr "Inzoomen"

msgctxt "explore.toolbar.zoom.label"
msgid "Page zoom"
msgstr "Paginazoom"

msgctxt "explore.toolbar.zoom.out"
msgid "Zoom out"
msgstr "Uitzoomen"

msgctxt "explore.toolbar.zoom.percent"
msgid "Zoom percent"
msgstr "Zoompercentage"

msgctxt "explore.toolbar.zoom.reset"
msgid "Reset zoom to 100%"
msgstr "Zoom terugzetten naar 100%"

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "Kies hoe gedownloade bestanden worden genoemd. Klik op een token om het in te voegen. Gebruik / om downloads in mappen te sorteren."

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "Voer een sjabloon voor de bestandsnaam in."

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "Verwijder de extra / — elke map heeft een naam nodig."

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "Verwijder tekens die niet zijn toegestaan in bestandsnamen: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "Die mapnaam is niet toegestaan. Vermijd . en .. en gereserveerde namen zoals CON."

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "Voeg {title} of {id} toe aan de bestandsnaam zodat elke download een eigen naam krijgt."

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} kan geen map een naam geven — de kwaliteit is pas bekend zodra de download start."

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "Niet-overeenkomende { of } — plaats tokens zoals {title} tussen accolades."

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "Het sjabloon is te lang."

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "Onbekend token {{token}}."

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "Zonder {id} kan Arroxy reeds gedownloade afspeellijstitems niet herkennen en geen .m3u-afspeellijsten maken."

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "Sjabloon voor bestandsnaam"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "Niet beschikbaar omdat je sjabloon voor de bestandsnaam {id} niet bevat of downloads in mappen sorteert."

msgctxt "filenameTemplate.previewPlaylist"
msgid "In a playlist"
msgstr "In een afspeellijst"

msgctxt "filenameTemplate.previewSingle"
msgid "Single video"
msgstr "Enkele video"

msgctxt "filenameTemplate.profileOverrideDescription"
msgid "Leave empty to inherit the global template."
msgstr "Laat leeg om het algemene sjabloon over te nemen."

msgctxt "filenameTemplate.profileOverrideLabel"
msgid "Filename template"
msgstr "Sjabloon voor bestandsnaam"

msgctxt "fileType.auto"
msgid "Auto"
msgstr "Automatisch"

msgctxt "fileType.autoValue"
msgid "Auto (.{{ext}})"
msgstr "Automatisch (.{{ext}})"

msgctxt "fileType.description.auto"
msgid "The picked streams decide the file type."
msgstr "De gekozen streams bepalen het bestandstype."

msgctxt "fileType.description.mkv"
msgid "Holds any codec. Some TVs and phones can't open it."
msgstr "Kan elke codec bevatten. Sommige tv’s en telefoons kunnen het niet openen."

msgctxt "fileType.description.mp4"
msgid "Plays almost everywhere. VP9 in an MP4 won't play video in QuickTime."
msgstr "Speelt vrijwel overal af. VP9 in een MP4 wordt in QuickTime zonder beeld afgespeeld."

msgctxt "fileType.description.webm"
