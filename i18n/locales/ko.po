msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Arroxy는 계속 실행되며 진행 중인 다운로드를 완료합니다. 나중에 고급 설정에서 변경할 수 있습니다."

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "트레이로 숨기기"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "닫을 때 Arroxy를 시스템 트레이로 숨길까요?"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "종료"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "다시 묻지 않기"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "다운로드 취소 후 종료"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "나중에 다시 시작하려면 일시 중지하고, 진행 상황을 버리려면 취소하세요."

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "계속 다운로드"

msgctxt "dialogs.quitWithActiveDownloads.message_one"
msgid "{{count}} download in progress"
msgstr "{{count}}개 다운로드 진행 중"

msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "{{count}}개 다운로드 진행 중"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "다운로드 일시 중지 후 종료"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "렌더러 프로세스가 중단되었습니다({{reason}}). 다시 시도하려면 새로고침하세요."

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "Arroxy에 문제가 발생했습니다"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "종료"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "새로고침"

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "이 동영상은 연령 제한이 있어 로그인한 계정 없이는 다운로드할 수 없습니다."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy auto-updates yt-dlp on launch, so the fix lands automatically once upstream ships it."
msgstr "봇 보호가 작동했습니다. 사용 중인 IP가 데이터센터 대역이거나 사용자가 많은 VPN 출구라 차단되었을 가능성이 큽니다. IP를 바꾸거나 다른 VPN 엔드포인트를 선택한 뒤 다시 시도하세요. 계속 실패한다면 사이트의 일시적인 변경 때문일 수 있습니다. Arroxy는 시작할 때 yt-dlp를 자동 업데이트하므로 업스트림에서 수정본이 배포되면 자동으로 적용됩니다."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream and yt-dlp gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "서버가 다운로드 도중 연결을 계속 끊어 yt-dlp가 재시도 후 포기했습니다. 주로 가장 큰 동영상 형식(4K HDR/고비트레이트 VP9)에서 발생합니다. 다시 시도하거나 네트워크/VPN을 바꾸거나 더 낮은 해상도의 형식을 선택하세요."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. yt-dlp can't strip DRM, so the file can't be downloaded."
msgstr "이 동영상은 DRM으로 보호됩니다. yt-dlp는 DRM을 제거할 수 없으므로 파일을 다운로드할 수 없습니다."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "이 동영상은 현재 지역에서 볼 수 없습니다."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "IP 주소가 차단된 것 같습니다. 나중에 다시 시도하거나 VPN을 사용하세요."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video requires a signed-in account. Set up a cookies.txt (Settings → Cookies) and retry."
msgstr "이 동영상은 로그인한 계정이 필요합니다. cookies.txt(설정 → 쿠키)를 설정하고 다시 시도하세요."

msgctxt "errors.ytdlp.missingDependency"
msgid "yt-dlp could not find ffmpeg or ffprobe. Repair the bundled binaries or set an FFmpeg location, then retry."
msgstr "yt-dlp에서 ffmpeg 또는 ffprobe를 찾을 수 없습니다. 번들 바이너리를 복구하거나 FFmpeg 위치를 설정한 뒤 다시 시도하세요."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "네트워크 오류입니다. 연결을 확인하고 다시 시도하세요."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "디스크 공간이 부족합니다. 공간을 확보하고 다시 시도하세요."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. yt-dlp's extractor may have drifted. Arroxy auto-updates yt-dlp on launch — retry in a few minutes once the fix ships."
msgstr "사이트의 응답을 분석할 수 없습니다. yt-dlp 추출기가 사이트 변경을 따라가지 못했을 수 있습니다. Arroxy는 시작 시 yt-dlp를 자동 업데이트하므로 수정본이 배포된 뒤 몇 분 후 다시 시도하세요."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "yt-dlp finished downloading but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "yt-dlp가 다운로드를 완료했지만 후처리(병합/먹싱/변환)에 실패했습니다. 일시적인 ffmpeg 문제인 경우가 많으니 다시 시도하고, 문제가 계속되면 다른 형식 조합을 사용해 보세요."

msgctxt "errors.ytdlp.rateLimit"
msgid "Site is rate-limiting requests. Wait a minute then retry."
msgstr "사이트에서 요청 속도를 제한하고 있습니다. 잠시 기다렸다가 다시 시도하세요."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "이 동영상을 사용할 수 없습니다. 비공개이거나 삭제되었거나 지역 제한이 있을 수 있습니다."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "다운로드에 실패했습니다. 아래 원시 출력을 확인하세요."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "That URL isn't supported by yt-dlp. Try a different link from any of yt-dlp's supported sites."
msgstr "이 URL은 yt-dlp에서 지원하지 않습니다. yt-dlp가 지원하는 다른 사이트의 링크를 사용해 보세요."

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "다운로드한 파일의 이름 지정 방식을 선택하세요. 토큰을 클릭해 삽입하고 /를 사용해 다운로드를 폴더로 분류하세요."

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "파일 이름 템플릿을 입력하세요."

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "여분의 /를 제거하세요. 모든 폴더에는 이름이 필요합니다."

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "파일 이름에 사용할 수 없는 문자를 제거하세요: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "이 폴더 이름은 사용할 수 없습니다. . 및 .. 그리고 CON 같은 예약어를 피하세요."

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "각 다운로드에 고유한 이름이 지정되도록 파일 이름에 {title} 또는 {id}를 추가하세요."

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution}은 폴더 이름으로 사용할 수 없습니다. 다운로드가 시작될 때까지 화질을 알 수 없기 때문입니다."

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "일치하지 않는 { 또는 }가 있습니다. {title}처럼 토큰을 감싸세요."

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "템플릿이 너무 깁니다."

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "알 수 없는 토큰 {{token}}입니다."

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "{id}가 없으면 Arroxy는 이미 다운로드한 재생목록 항목을 감지하거나 .m3u 재생목록을 만들 수 없습니다."

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "파일 이름 템플릿"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "파일 이름 템플릿에 {id}가 없거나 다운로드를 폴더로 분류하므로 사용할 수 없습니다."

msgctxt "filenameTemplate.previewPlaylist"
msgid "In a playlist"
msgstr "재생목록에서"

msgctxt "filenameTemplate.previewSingle"
msgid "Single video"
msgstr "단일 동영상"

msgctxt "filenameTemplate.profileOverrideDescription"
msgid "Leave empty to inherit the global template."
msgstr "전역 템플릿을 사용하려면 비워 두세요."

msgctxt "filenameTemplate.profileOverrideLabel"
msgid "Filename template"
msgstr "파일 이름 템플릿"

msgctxt "formatLabel.audioFallback"
msgid "Audio"
msgstr "오디오"

msgctxt "formatLabel.audioOnlyDot"
msgid "Audio only · {{audio}}"
msgstr "오디오만 · {{audio}}"

msgctxt "formatLabel.videoDot"
msgid "{{resolution}} · {{audio}}"
msgstr "{{resolution}} · {{audio}}"

msgctxt "language.label"
msgid "Language"
msgstr "언어"

msgctxt "notifications.filenameFolderTooDeep"
msgid "This folder is too deep for your system. The download may still fail — pick a shorter folder."
msgstr "이 폴더의 경로가 시스템에서 허용하는 것보다 너무 깊습니다. 다운로드가 실패할 수 있으니 더 짧은 폴더를 선택하세요."

msgctxt "notifications.filenameTemplateCannotFit"
msgid "This video's name can't fit every part of your template, so the default name was used."
msgstr "이 동영상 이름이 템플릿의 모든 부분에 맞지 않아 기본 이름을 사용했습니다."

msgctxt "notifications.folderSelectFailed"
msgid "Could not open the folder picker."
msgstr "폴더 선택기를 열 수 없습니다."

msgctxt "notifications.hotkey.alreadyQueued"
msgid "Already in the queue — no copy added"
msgstr "이미 대기열에 있음 — 사본을 추가하지 않았습니다"

msgctxt "notifications.hotkey.busy"
msgid "Still working on the previous link"
msgstr "이전 링크를 처리하는 중입니다"

msgctxt "notifications.hotkey.invalidClipboard"
msgid "No link on your clipboard — copy one first"
msgstr "클립보드에 링크가 없습니다. 먼저 링크를 복사하세요"

msgctxt "notifications.hotkey.multipleUrls"
msgid "Multiple links copied — use Bulk URLs in Arroxy"
msgstr "여러 링크가 복사되었습니다. Arroxy의 URL 일괄 추가를 사용하세요"

msgctxt "notifications.hotkey.needsReview"
msgid "That link needs a quick review — open Arroxy and paste it again"
msgstr "이 링크는 간단한 확인이 필요합니다. Arroxy를 열고 다시 붙여넣으세요"

msgctxt "notifications.hotkey.queued"
msgid "Download queued from clipboard"
msgstr "클립보드에서 다운로드를 대기열에 추가했습니다"

msgctxt "notifications.hotkey.submissionFailed"
msgid "Could not add that link — try again in Arroxy"
msgstr "링크를 추가할 수 없습니다. Arroxy에서 다시 시도하세요"

msgctxt "notifications.playlistFolderRejected"
msgid "That folder can't be used for this playlist."
msgstr "이 폴더는 이 재생목록에 사용할 수 없습니다."

msgctxt "notifications.settingsSaveFailed"
msgid "Could not save your settings."
msgstr "설정을 저장할 수 없습니다."

msgctxt "notifications.shellActionFailed"
msgid "Could not open that."
msgstr "열 수 없습니다."

msgctxt "notifications.warmupFailed"
msgid "Setup did not finish. Some downloads may fail until it does."
msgstr "설정이 완료되지 않았습니다. 완료될 때까지 일부 다운로드가 실패할 수 있습니다."

msgctxt "playlistPresets.audioFormat.best"
msgid "Audio (best)"
msgstr "오디오(최고)"

msgctxt "playlistPresets.audioFormat.m4a"
msgid "M4A"
msgstr "M4A"

msgctxt "playlistPresets.audioFormat.mp3"
msgid "MP3"
msgstr "MP3"

msgctxt "playlistPresets.audioFormat.opus"
msgid "Opus"
msgstr "Opus"

msgctxt "playlistPresets.audioFormatBitrate"
msgid "Audio ({{format}} {{kbps}}K)"
msgstr "오디오({{format}} {{kbps}}K)"

msgctxt "playlistPresets.audioFormatDesc.best"
msgid "Native best audio, no re-encode"
msgstr "최상의 원본 오디오, 재인코딩 없음"

msgctxt "playlistPresets.audioFormatDesc.m4a"
msgid "Convert to M4A (AAC)"
msgstr "M4A(AAC)로 변환"

msgctxt "playlistPresets.audioFormatDesc.mp3"
msgid "Convert to MP3"
msgstr "MP3로 변환"

msgctxt "playlistPresets.audioFormatDesc.opus"
msgid "Convert to Opus"
msgstr "Opus로 변환"

msgctxt "playlistPresets.mp4Cap"
msgid "H.264 above 1080p is not available on YouTube — capped to 1080p automatically"
msgstr "YouTube에서는 1080p를 초과하는 H.264를 사용할 수 없어 자동으로 1080p로 제한됩니다"

msgctxt "playlistPresets.tier.1080"
msgid "Up to 1080p"
msgstr "최대 1080p"

msgctxt "playlistPresets.tier.144"
msgid "Up to 144p"
msgstr "최대 144p"

msgctxt "playlistPresets.tier.1440"
msgid "Up to 1440p"
msgstr "최대 1440p"

msgctxt "playlistPresets.tier.2160"
msgid "Up to 4K"
msgstr "최대 4K"

msgctxt "playlistPresets.tier.240"
msgid "Up to 240p"
msgstr "최대 240p"

msgctxt "playlistPresets.tier.360"
msgid "Up to 360p"
msgstr "최대 360p"

msgctxt "playlistPresets.tier.480"
msgid "Up to 480p"
msgstr "최대 480p"

msgctxt "playlistPresets.tier.720"
msgid "Up to 720p"
msgstr "최대 720p"

msgctxt "playlistPresets.tier.best"
msgid "Best quality"
msgstr "최고 화질"

msgctxt "playlistPresets.tierDesc.1080"
msgid "Capped at 1080p, falls back to lower per item"
msgstr "1080p로 제한되며 항목별로 더 낮은 화질을 사용합니다"

msgctxt "playlistPresets.tierDesc.144"
msgid "Smallest possible files"
msgstr "가능한 가장 작은 파일"

msgctxt "playlistPresets.tierDesc.1440"
msgid "Capped at 2K, falls back to lower per item"
msgstr "2K로 제한되며 항목별로 더 낮은 화질을 사용합니다"

msgctxt "playlistPresets.tierDesc.2160"
msgid "Capped at 2160p, falls back to lower per item"
msgstr "2160p로 제한되며 항목별로 더 낮은 화질을 사용합니다"

msgctxt "playlistPresets.tierDesc.240"
msgid "Very small files, low quality"
msgstr "매우 작은 파일, 낮은 화질"

msgctxt "playlistPresets.tierDesc.360"
msgid "Small files for tight bandwidth"
msgstr "제한된 대역폭을 위한 작은 파일"

msgctxt "playlistPresets.tierDesc.480"
msgid "Low bandwidth"
msgstr "낮은 대역폭"

msgctxt "playlistPresets.tierDesc.720"
msgid "Smaller files, broad compatibility"
msgstr "더 작은 파일, 높은 호환성"

msgctxt "playlistPresets.tierDesc.best"
msgid "Highest available video + audio per item"
msgstr "항목별 최고 품질의 동영상과 오디오"

msgctxt "playlistPresets.type.audio"
msgid "Audio"
msgstr "오디오"

