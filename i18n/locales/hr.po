msgstr "Na čekanju"

msgctxt "wizard.playlist.durationUnknown"
msgid "live"
msgstr "uživo"

msgctxt "wizard.playlist.heading"
msgid "Playlist items"
msgstr "Stavke popisa za reprodukciju"

