msgstr "Unesite početak kao h:mm:ss, m:ss ili sekunde."

msgctxt "wizard.part.error.startNotBeforeEnd"
msgid "The start must come before the end."
msgstr "Početak mora biti prije kraja."

msgctxt "wizard.part.exactCut.hint"
msgid "Off: each cut lands on the nearest keyframe, which can be a few seconds from the time you typed."
msgstr "Isključeno: svaki rez pada na najbliži ključni kadar, što može biti nekoliko sekundi od vremena koje ste upisali."

msgctxt "wizard.part.exactCut.label"
msgid "Exact cut (re-encodes, slower)"
msgstr "Točan rez (ponovno kodira, sporije)"

msgctxt "wizard.part.length"
msgid "{{length}} of {{duration}}"
msgstr "{{length}} od {{duration}}"

msgctxt "wizard.part.part"
msgid "Part"
msgstr "Dio"

msgctxt "wizard.part.rangeLabel"
msgid "Part of the video"
msgstr "Dio videozapisa"

msgctxt "wizard.part.start"
msgid "Start"
msgstr "Početak"

msgctxt "wizard.part.subtitlesFullLength"
msgid "whole video"
msgstr "cijeli videozapis"

msgctxt "wizard.part.summary"
msgid "Part {{start}}–{{end}}"
msgstr "Dio {{start}}–{{end}}"

msgctxt "wizard.part.switchLabel"
msgid "How much of the video"
msgstr "Koliki dio videozapisa"

msgctxt "wizard.part.timeHint"
msgid "h:mm:ss, m:ss or seconds"
msgstr "h:mm:ss, m:ss ili sekunde"

msgctxt "wizard.part.totalEstimate"
msgid "Part, estimated"
msgstr "Dio, procjena"

msgctxt "wizard.part.unavailableDuration"
msgid "This video doesn't report its length, so it can only be downloaded whole."
msgstr "Ovaj videozapis ne prijavljuje svoju duljinu pa se može preuzeti samo cijeli."

msgctxt "wizard.part.unavailableSubtitles"
msgid "Subtitles always cover the whole video."
msgstr "Titlovi uvijek obuhvaćaju cijeli videozapis."

msgctxt "wizard.part.urlStart"
msgid "Your link starts at {{time}}"
msgstr "Vaša poveznica počinje u {{time}}"

msgctxt "wizard.part.useUrlStart"
msgid "Use as start"
msgstr "Koristi kao početak"

msgctxt "wizard.part.whole"
msgid "Whole video"
msgstr "Cijeli videozapis"

msgctxt "wizard.part.wholeTrack"
msgid "Whole track"
msgstr "Cijeli zapis"

msgctxt "wizard.playlist.allRemovedDescription"
msgid "Restore them to continue."
msgstr "Vratite ih da biste nastavili."

msgctxt "wizard.playlist.allRemovedTitle"
msgid "Every item was removed"
msgstr "Sve su stavke uklonjene"

msgctxt "wizard.playlist.alreadyDownloaded"
msgid "Already downloaded"
msgstr "Već preuzeto"

msgctxt "wizard.playlist.bulkHeading"
msgid "Bulk URLs"
msgstr "Više URL-ova"

msgctxt "wizard.playlist.bulkMetadataOptional"
msgid "No need to wait — files queued now still get their real names when they download."
msgstr "Nema potrebe čekati — datoteke koje sada stavite u red ipak dobivaju prave nazive pri preuzimanju."

msgctxt "wizard.playlist.bulkMetadataResolving"
msgid "Fetching video details… {{done}}/{{total}}"
msgstr "Dohvaćanje pojedinosti o videozapisima… {{done}}/{{total}}"

msgctxt "wizard.playlist.bulkRowFailed"
msgid "Details unavailable"
msgstr "Pojedinosti nisu dostupne"

msgctxt "wizard.playlist.bulkRowResolving"
msgid "Fetching details"
