msgctxt "about.openTitle"
msgid "About Arroxy"
msgstr "Giới thiệu về Arroxy"

msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "Trình tải xuống nhanh, thân thiện cho YouTube và hơn 2000 trang web khác."

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "Xem thông báo bên thứ ba"

msgctxt "about.websiteLink"
msgid "Website"
msgstr "Trang web"

msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Cho phép"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube cung cấp một số video cũ ở các kích thước được tạo bằng AI. Bỏ qua sẽ giữ các luồng gốc; bạn vẫn có thể tự chọn một luồng đã nâng cấp."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Luồng nâng cấp bằng AI"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Bỏ qua"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Phản hồi"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Bạn thích Arroxy không? Tôi rất muốn nghe ý kiến của bạn! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Nhật ký"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Lưu tệp chẩn đoán"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Gom nhật ký và thông tin ứng dụng vào một tệp trong thư mục Tải xuống, sẵn sàng đính kèm vào issue trên GitHub. Tên thư mục người dùng của bạn sẽ được xóa; liên kết và tiêu đề video vẫn được giữ lại."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Mới: chọn Aurora hoặc Tối giản tại đây"

msgctxt "app.theme"
msgid "Theme"
msgstr "Giao diện"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Phóng to"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Thu nhỏ"

msgctxt "common.back"
msgid "Back"
msgstr "Quay lại"

msgctxt "common.cancel"
msgid "Cancel"
msgstr "Hủy"

msgctxt "common.continue"
msgid "Continue"
msgstr "Tiếp tục"

msgctxt "common.dismiss"
msgid "Dismiss"
msgstr "Đóng"

msgctxt "common.loading"
msgid "Loading"
msgstr "Đang tải…"

msgctxt "common.retry"
msgid "Retry"
msgstr "Thử lại"

msgctxt "common.startOver"
msgid "Start over"
msgstr "Bắt đầu lại"

msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Arroxy vẫn tiếp tục chạy và hoàn thành các tải xuống đang hoạt động. Thay đổi điều này sau trong cài đặt Nâng cao."

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "Ẩn xuống khay"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "Ẩn Arroxy xuống khay hệ thống khi đóng?"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "Thoát"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "Không hỏi lại"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "Hủy tải xuống & Thoát"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "Tạm dừng để tiếp tục sau, hoặc hủy để bỏ tiến trình."

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "Tiếp tục tải xuống"

#. Plural form "other" for vi: used for counts like 0, 1, 2, 3, 4, 5.
msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "{{count}} tải xuống đang tiến hành"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "Tạm dừng tải và thoát"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "Tiến trình renderer bị crash ({{reason}}). Tải lại để thử lại."

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "Arroxy đã gặp sự cố"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "Thoát"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "Tải lại"

msgctxt "donate.copied"
msgid "Copied!"
msgstr "Đã sao chép!"

msgctxt "donate.copyAddress"
msgid "Copy address"
msgstr "Sao chép địa chỉ"

msgctxt "donate.description"
msgid "Arroxy is free and open-source, with no ads or paid tier. Donations are optional and buy no influence over the roadmap."
msgstr "Arroxy miễn phí và mã nguồn mở, không quảng cáo, không gói trả phí. Quyên góp là tùy chọn và không mang lại ảnh hưởng đến lộ trình phát triển."

msgctxt "donate.footerLabel"
msgid "Donate"
msgstr "Ủng hộ"

msgctxt "donate.footerTooltip"
msgid "Support Arroxy"
msgstr "Ủng hộ Arroxy"

msgctxt "donate.qrAlt"
msgid "{{coin}} donation address QR code"
msgstr "Mã QR địa chỉ quyên góp {{coin}}"

msgctxt "donate.title"
msgid "Support Arroxy"
msgstr "Ủng hộ Arroxy"

msgctxt "donate.warning"
msgid "Crypto payments are irreversible. Send only on the network shown, and compare the whole address."
msgstr "Thanh toán bằng tiền mã hóa không thể hoàn lại. Chỉ gửi qua mạng được hiển thị và so sánh toàn bộ địa chỉ."

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "Video này bị giới hạn độ tuổi và không thể tải xuống nếu không có tài khoản đã đăng nhập."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy updates its download engine on launch, so the fix lands automatically once it ships."
msgstr "Đã kích hoạt bảo vệ bot. Địa chỉ IP bạn đang dùng rất có thể đã bị gắn cờ (dải địa chỉ trung tâm dữ liệu hoặc điểm thoát VPN bận). Hãy đổi IP hoặc chọn điểm kết nối VPN khác rồi thử lại. Nếu vẫn thất bại, đây có thể là thay đổi tạm thời từ phía trang web — Arroxy cập nhật bộ máy tải xuống khi khởi động, vì vậy bản sửa lỗi sẽ tự động áp dụng ngay khi được phát hành."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream, and Arroxy gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "Máy chủ liên tục ngắt kết nối giữa chừng và Arroxy đã bỏ cuộc sau nhiều lần thử lại. Lỗi này thường xảy ra với các định dạng video lớn nhất (4K HDR / VP9 bitrate cao). Hãy thử lại, đổi mạng/VPN, hoặc chọn định dạng độ phân giải thấp hơn."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. Arroxy can't remove DRM, so the file can't be downloaded."
msgstr "Video này được bảo vệ bởi DRM. Arroxy không thể gỡ DRM, vì vậy tệp không thể được tải xuống."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "Video này không có sẵn ở khu vực của bạn."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "Địa chỉ IP của bạn dường như bị YouTube chặn. Hãy thử lại sau hoặc dùng VPN."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "Video này cần một tài khoản đã đăng nhập."

msgctxt "errors.ytdlp.missingDependency"
msgid "Arroxy could not find FFmpeg or FFprobe. Run setup again or set an FFmpeg location, then retry the download."
msgstr "Arroxy không tìm thấy FFmpeg hoặc FFprobe. Hãy chạy lại thiết lập hoặc chọn vị trí FFmpeg, rồi thử tải lại."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "Lỗi mạng. Hãy kiểm tra kết nối và thử lại."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "Không đủ dung lượng đĩa. Hãy giải phóng dung lượng rồi thử lại."

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Arroxy không thể ghi vào thư mục tải xuống. Thư mục có thể chỉ cho phép đọc, nằm trên ổ đĩa bị khóa, hoặc bị chặn bởi cài đặt quyền riêng tư của hệ thống. Hãy chọn thư mục khác hoặc cho phép truy cập rồi thử lại."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. The site may have changed how it serves videos. Arroxy updates its download engine on launch — retry in a few minutes once the fix ships."
msgstr "Không thể phân tích phản hồi từ trang web. Trang web có thể đã thay đổi cách cung cấp video. Arroxy cập nhật bộ máy tải xuống khi khởi động — hãy thử lại sau vài phút khi bản sửa lỗi được phát hành."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "The download finished, but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "Đã tải xong nhưng quá trình xử lý hậu kỳ (gộp / mux / chuyển đổi) bị lỗi. Thường đây là sự cố tạm thời của ffmpeg — hãy thử lại, và nếu vẫn lỗi thì thử một tổ hợp định dạng khác."

msgctxt "errors.ytdlp.rateLimit"
msgid "The site is rate-limiting requests from this connection."
msgstr "Trang web đang giới hạn yêu cầu từ kết nối này."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "Video này không khả dụng — có thể là riêng tư, đã bị xóa hoặc bị chặn theo khu vực."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "Tải xuống thất bại. Xem đầu ra thô bên dưới."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "Arroxy doesn't support this URL. Try a link from a different site."
msgstr "Arroxy không hỗ trợ URL này. Hãy thử liên kết từ một trang web khác."

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "Hãy kiểm tra kết nối của bạn rồi thử lại."

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "Trang này không tải được"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "Mở Cài đặt"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "Hãy kiểm tra proxy trong Cài đặt rồi thử lại."

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "Tab Khám phá không thể kết nối qua proxy của bạn"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "Thử lại"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "Nhấp chuột phải vào bất kỳ liên kết video, danh sách phát hoặc kênh nào trên trang để tải xuống bằng hồ sơ đang dùng, chọn hồ sơ khác hoặc mở Tải tương tác."

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "Nhấp chuột phải vào liên kết để tải xuống"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "Sao chép liên kết"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "Tải xuống với"

msgctxt "explore.newBadge"
msgid "New"
msgstr "Mới"

msgctxt "explore.notice.body"
msgid "Find a video, playlist, or channel and download it from here — no copying links. Sign in to YouTube here to download videos that need an account."
msgstr "Tìm video, danh sách phát hoặc kênh và tải xuống ngay tại đây — không cần sao chép liên kết. Đăng nhập YouTube tại đây để tải các video cần tài khoản."

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "Tiếp tục"

msgctxt "explore.notice.riskBody"
msgid "YouTube may flag — and sometimes ban — accounts used with download tools like Arroxy. Use an account you can afford to lose, not your main one."
msgstr "YouTube có thể gắn cờ — và đôi khi cấm — các tài khoản dùng với công cụ tải xuống như Arroxy. Hãy dùng tài khoản bạn có thể chấp nhận mất, không phải tài khoản chính."

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "Đăng nhập bằng tài khoản phụ"

msgctxt "explore.notice.title"
msgid "Browse YouTube right inside Arroxy"
msgstr "Duyệt YouTube ngay trong Arroxy"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "Tải xuống dùng cookies của trình duyệt, không dùng đăng nhập Khám phá của bạn."

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "Tải xuống dùng tệp cookies của bạn, không dùng đăng nhập Khám phá."

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "Để sau"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "Cookies đang tắt nên tải xuống không dùng đăng nhập Khám phá của bạn."

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "Dùng đăng nhập Khám phá"

msgctxt "explore.settings.description"
msgid "Browse YouTube inside Arroxy and sign in for videos that need an account."
msgstr "Duyệt YouTube trong Arroxy và đăng nhập để xem các video cần tài khoản."

msgctxt "explore.settings.idleUnload"
msgid "Free memory while away"
msgstr "Giải phóng bộ nhớ khi vắng mặt"

msgctxt "explore.settings.idleUnloadDescription"
msgid "After 5 minutes on another tab, closes the YouTube home or search page. Coming back reloads it, which takes a few seconds."
msgstr "Sau 5 phút ở thẻ khác, đóng trang chủ hoặc trang tìm kiếm YouTube. Khi quay lại, trang sẽ tải lại, mất vài giây."

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "Hiện tab Khám phá"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "Tắt tab này cũng khiến tải xuống ngừng dùng đăng nhập Khám phá của bạn."

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "Đăng xuất khỏi Khám phá"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "Đăng xuất"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your YouTube sign-in and browsing data in Explore. Downloads that need an account will fail until you sign in again."
msgstr "Thao tác này xóa đăng nhập YouTube và dữ liệu duyệt web của bạn trong Khám phá. Các lượt tải cần tài khoản sẽ thất bại cho đến khi bạn đăng nhập lại."

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "Đăng xuất khỏi Khám phá?"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your YouTube sign-in and browsing data in Explore."
msgstr "Xóa đăng nhập YouTube và dữ liệu duyệt web của bạn trong Khám phá."

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "Khám phá"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "Khám phá"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "YouTube có thể chống lại trình chặn quảng cáo với các tài khoản đã đăng nhập."

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "Trình chặn quảng cáo"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "Trình chặn quảng cáo: tắt — nhấp để bật"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "Trình chặn quảng cáo: bật — nhấp để tắt"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "Trình chặn quảng cáo: đang khởi động — nhấp để tắt"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "Trình chặn quảng cáo: không khả dụng, không tải được danh sách bộ lọc — nhấp để tắt"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
msgstr "Địa chỉ"

msgctxt "explore.toolbar.addressPlaceholder"
msgid "Search YouTube or open any site (Vimeo, Instagram…)"
msgstr "Tìm trên YouTube hoặc mở bất kỳ trang web nào (Vimeo, Instagram…)"

msgctxt "explore.toolbar.aria"
msgid "Explore browser controls"
msgstr "Điều khiển trình duyệt Khám phá"

msgctxt "explore.toolbar.back"
msgid "Back"
msgstr "Quay lại"

msgctxt "explore.toolbar.compactLayout"
msgid "Compact layout"
msgstr "Bố cục thu gọn"

msgctxt "explore.toolbar.downloadWithProfile"
msgid "Download · {{profileName}}"
msgstr "Tải xuống · {{profileName}}"

msgctxt "explore.toolbar.forward"
msgid "Forward"
msgstr "Tiến tới"

msgctxt "explore.toolbar.fullLayout"
msgid "Show full layout"
msgstr "Hiện bố cục đầy đủ"

msgctxt "explore.toolbar.grabUnavailable"
msgid "Open a video, playlist, or channel to download it"
msgstr "Mở một video, danh sách phát hoặc kênh để tải xuống"

msgctxt "explore.toolbar.home"
msgid "YouTube home"
msgstr "Trang chủ YouTube"

msgctxt "explore.toolbar.interactiveHint"
msgid "Interactive Download: choose format, subtitles and more…"
msgstr "Tải tương tác: chọn định dạng, phụ đề và hơn thế…"

msgctxt "explore.toolbar.refusedHint"
msgid "Explore can't open that address."
msgstr "Tab Khám phá không thể mở địa chỉ đó."

msgctxt "explore.toolbar.reload"
msgid "Reload"
msgstr "Tải lại"

msgctxt "explore.toolbar.searchTooLong"
msgid "That search is too long."
msgstr "Cụm tìm kiếm quá dài."

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "Chọn cách đặt tên tệp đã tải. Nhấp vào một token để chèn. Dùng / để sắp xếp tệp tải về vào các thư mục."

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "Hãy nhập mẫu tên tệp."

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "Bỏ dấu / thừa — mỗi thư mục đều cần một tên."

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "Bỏ các ký tự không được phép trong tên tệp: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
