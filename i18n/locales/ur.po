msgstr "زبان"

#. Plural form "one" for ur: used for counts like 1.
msgctxt "notifications.exploreSignInRetrying_one"
msgid "Signed in with Explore — retrying 1 link"
msgstr "دریافت کے ذریعے سائن ان ہو گیا — 1 لنک دوبارہ آزمایا جا رہا ہے"

#. Plural form "other" for ur: used for counts like 0, 2, 3, 4, 5, 6.
