msgstr "یہ فولڈر آپ کے سسٹم کے لیے بہت گہرا ہے۔ ڈاؤن لوڈ پھر بھی ناکام ہو سکتا ہے — چھوٹا فولڈر منتخب کریں۔"

msgctxt "notifications.filenameTemplateCannotFit"
msgid "This video's name can't fit every part of your template, so the default name was used."
msgstr "اس ویڈیو کا نام آپ کے ٹیمپلیٹ کے ہر حصے میں نہیں سماتا، اس لیے پہلے سے طے شدہ نام استعمال کیا گیا۔"

msgctxt "notifications.folderSelectFailed"
