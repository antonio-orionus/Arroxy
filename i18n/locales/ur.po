msgstr "Arroxy ابھی شروع ہو رہا ہے — ذرا دیر بعد دوبارہ کوشش کریں"

msgctxt "notifications.hotkey.cookiesSetup"
msgid "Finish setting up cookies in Arroxy, then try again"
msgstr "Arroxy میں Cookies کی سیٹ اپ مکمل کریں، پھر دوبارہ کوشش کریں"

msgctxt "notifications.hotkey.invalidClipboard"
msgid "No link on your clipboard — copy one first"
msgstr "کلپ بورڈ میں کوئی لنک نہیں — پہلے ایک کاپی کریں"

msgctxt "notifications.hotkey.multipleUrls"
msgid "Multiple links copied — use Bulk URLs in Arroxy"
msgstr "متعدد لنکس کاپی ہو گئے — Arroxy میں “متعدد URLs” استعمال کریں"

msgctxt "notifications.hotkey.needsReview"
msgid "That link needs your choice — see Downloads in Arroxy"
msgstr "اس لنک کے لیے آپ کا انتخاب درکار ہے — Arroxy میں Downloads دیکھیں"

msgctxt "notifications.hotkey.queued"
msgid "Download queued from clipboard"
msgstr "کلپ بورڈ سے ڈاؤن لوڈ شامل کر دیا گیا"

msgctxt "notifications.hotkey.submissionFailed"
msgid "Could not add that link — try again in Arroxy"
msgstr "یہ لنک شامل نہیں ہو سکا — Arroxy میں دوبارہ کوشش کریں"

msgctxt "notifications.playlistFolderRejected"
msgid "That folder can't be used for this playlist."
msgstr "یہ فولڈر اس پلے لسٹ کے لیے استعمال نہیں ہو سکتا۔"

