msgstr "آگے"

msgctxt "explore.toolbar.fullLayout"
msgid "Show full layout"
msgstr "مکمل لے آؤٹ دکھائیں"

msgctxt "explore.toolbar.grabUnavailable"
msgid "Open a video, playlist, or channel to download it"
msgstr "ڈاؤن لوڈ کرنے کے لیے کوئی ویڈیو، پلے لسٹ یا چینل کھولیں"

msgctxt "explore.toolbar.home"
msgid "YouTube home"
msgstr "YouTube ہوم"

msgctxt "explore.toolbar.interactiveHint"
msgid "Interactive Download: choose format, subtitles and more…"
msgstr "انٹرایکٹو ڈاؤن لوڈ: فارمیٹ، سب ٹائٹلز اور مزید چنیں…"

msgctxt "explore.toolbar.refusedHint"
msgid "Explore can't open that address."
msgstr "دریافت یہ پتا نہیں کھول سکتا۔"

msgctxt "explore.toolbar.reload"
msgid "Reload"
msgstr "ری لوڈ"

msgctxt "explore.toolbar.searchTooLong"
msgid "That search is too long."
msgstr "یہ تلاش بہت لمبی ہے۔"

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "منتخب کریں کہ ڈاؤن لوڈ کی گئی فائلوں کے نام کیسے رکھے جائیں۔ شامل کرنے کے لیے کسی ٹوکن پر کلک کریں۔ ڈاؤن لوڈز کو فولڈرز میں ترتیب دینے کے لیے / استعمال کریں۔"

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "فائل نام ٹیمپلیٹ درج کریں۔"

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "اضافی / ہٹائیں — ہر فولڈر کا نام ہونا چاہیے۔"

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "وہ حروف ہٹائیں جو فائل کے ناموں میں اجازت یافتہ نہیں: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "یہ فولڈر نام قابل قبول نہیں۔ . اور .. اور CON جیسے محفوظ ناموں سے گریز کریں۔"

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "فائل کے نام میں {title} یا {id} شامل کریں تاکہ ہر ڈاؤن لوڈ کا اپنا نام ہو۔"

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} کسی فولڈر کا نام نہیں بن سکتا — معیار ڈاؤن لوڈ شروع ہونے پر ہی معلوم ہوتا ہے۔"

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "بغیر جوڑ کی { یا } — ٹوکن {title} کی طرح لکھیں۔"

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "ٹیمپلیٹ بہت طویل ہے۔"

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "نامعلوم ٹوکن {{token}}۔"

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "{id} کے بغیر Arroxy پہلے سے ڈاؤن لوڈ شدہ پلے لسٹ آئٹمز کا پتہ نہیں لگا سکتا اور نہ .m3u پلے لسٹ بنا سکتا ہے۔"

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "فائل نام ٹیمپلیٹ"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "دستیاب نہیں کیونکہ آپ کے فائل نام ٹیمپلیٹ میں یا تو {id} نہیں ہے یا وہ ڈاؤن لوڈز کو فولڈرز میں ترتیب دیتا ہے۔"

msgctxt "filenameTemplate.previewPlaylist"
msgid "In a playlist"
msgstr "پلے لسٹ میں"

msgctxt "filenameTemplate.previewSingle"
msgid "Single video"
msgstr "واحد ویڈیو"

msgctxt "filenameTemplate.profileOverrideDescription"
msgid "Leave empty to inherit the global template."
msgstr "عالمی ٹیمپلیٹ استعمال کرنے کے لیے خالی چھوڑ دیں۔"

msgctxt "filenameTemplate.profileOverrideLabel"
msgid "Filename template"
msgstr "فائل نام ٹیمپلیٹ"

msgctxt "fileType.auto"
msgid "Auto"
msgstr "آٹو"

msgctxt "fileType.autoValue"
msgid "Auto (.{{ext}})"
msgstr "آٹو (.{{ext}})"

msgctxt "fileType.description.auto"
msgid "The picked streams decide the file type."
msgstr "منتخب اسٹریمز فائل کی قسم طے کرتی ہیں۔"

msgctxt "fileType.description.mkv"
msgid "Holds any codec. Some TVs and phones can't open it."
msgstr "کوئی بھی کوڈیک رکھ سکتی ہے۔ کچھ ٹی وی اور فون اسے نہیں کھول سکتے۔"

msgctxt "fileType.description.mp4"
msgid "Plays almost everywhere. VP9 in an MP4 won't play video in QuickTime."
msgstr "تقریباً ہر جگہ چلتی ہے۔ MP4 میں VP9 کی ویڈیو QuickTime میں نہیں چلتی۔"

msgctxt "fileType.description.webm"
msgid "Open format for browsers. Holds only VP9 or AV1 with Opus."
msgstr "براؤزرز کے لیے اوپن فارمیٹ۔ صرف Opus کے ساتھ VP9 یا AV1 رکھ سکتی ہے۔"

msgctxt "fileType.mkv"
msgid "MKV"
msgstr "MKV"

msgctxt "fileType.mp4"
msgid "MP4"
msgstr "MP4"

msgctxt "fileType.mp4CaveatAv1"
msgid "AV1 in an MP4 needs a recent Mac to play in QuickTime. H.264 plays everywhere."
msgstr "MP4 میں AV1 کو QuickTime میں چلانے کے لیے نیا Mac چاہیے۔ H.264 ہر جگہ چلتا ہے۔"

msgctxt "fileType.mp4CaveatVp9"
msgid "VP9 in an MP4 won't play video in QuickTime. H.264 plays everywhere."
msgstr "MP4 میں VP9 کی ویڈیو QuickTime میں نہیں چلتی۔ H.264 ہر جگہ چلتا ہے۔"

msgctxt "fileType.profileMark"
msgid "Profile"
msgstr "پروفائل"

msgctxt "fileType.smartTvNoWebm"
msgid "WebM isn't offered with Smart TV: it can't hold H.264."
msgstr "سمارٹ TV کے ساتھ WebM دستیاب نہیں: یہ H.264 نہیں رکھ سکتی۔"

msgctxt "fileType.webm"
msgid "WebM"
msgstr "WebM"

msgctxt "fileType.webmBlocked"
msgid "WebM can't hold {{codec}}. Choose MKV or MP4."
msgstr "WebM میں {{codec}} نہیں آ سکتا۔ MKV یا MP4 منتخب کریں۔"

msgctxt "formatLabel.audioFallback"
msgid "Audio"
msgstr "آڈیو"

msgctxt "formatLabel.audioOnlyDot"
msgid "Audio only · {{audio}}"
msgstr "صرف آڈیو · {{audio}}"

msgctxt "formatLabel.videoDot"
msgid "{{resolution}} · {{audio}}"
msgstr "{{resolution}} · {{audio}}"

msgctxt "hdrPreference.auto"
msgid "Auto"
msgstr "آٹو"

msgctxt "hdrPreference.description"
msgid "Auto picks HDR when this screen can show it, otherwise SDR. HDR looks washed out on regular screens."
msgstr "اگر یہ اسکرین HDR دکھا سکے تو آٹو HDR چنتا ہے، ورنہ SDR۔ عام اسکرینوں پر HDR پھیکا دکھتا ہے۔"

msgctxt "hdrPreference.hdr"
msgid "HDR"
msgstr "HDR"

msgctxt "hdrPreference.label"
msgid "HDR video"
