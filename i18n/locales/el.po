msgctxt "about.button"
msgid "About"
msgstr "Σχετικά"

msgctxt "about.githubLink"
msgid "GitHub"
msgstr "GitHub"

msgctxt "about.licenseLine"
msgid "GPLv3 · by Antonio Orionus"
msgstr "GPLv3 · από Antonio Orionus"

msgctxt "about.openTitle"
msgid "About Arroxy"
msgstr "Σχετικά με το Arroxy"

msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "Γρήγορο και φιλικό πρόγραμμα λήψης για το YouTube και 2000+ άλλους ιστότοπους."

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "Προβολή ανακοινώσεων τρίτων"

msgctxt "about.websiteLink"
msgid "Website"
msgstr "Ιστότοπος"

msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Επιτρέπεται"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "Το YouTube προσφέρει ορισμένα παλιά βίντεο σε μεγέθη που δημιούργησε με ΤΝ. Η «Παράλειψη» κρατά τις αρχικές ροές· μπορείτε ακόμη να επιλέξετε χειροκίνητα μια ροή με αναβάθμιση."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Ροές με αναβάθμιση ΤΝ"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Παράλειψη"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Σχόλια"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Σου αρέσει το Arroxy; Θα χαρώ να ακούσω τη γνώμη σου! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Αρχεία καταγραφής"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Αποθήκευση αρχείου διαγνωστικών"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Συγκεντρώνει τα αρχεία καταγραφής και τις λεπτομέρειες της εφαρμογής σε ένα αρχείο στον φάκελο Λήψεις, έτοιμο για επισύναψη σε ένα issue στο GitHub. Το όνομα του φακέλου χρήστη αφαιρείται· οι σύνδεσμοι και οι τίτλοι των βίντεο παραμένουν."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Νέο: επιλέξτε Aurora ή Μινιμαλιστικό εδώ"

msgctxt "app.theme"
msgid "Theme"
msgstr "Θέμα"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Μεγέθυνση"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Σμίκρυνση"

msgctxt "common.back"
msgid "Back"
msgstr "Πίσω"

msgctxt "common.cancel"
msgid "Cancel"
msgstr "Ακύρωση"

msgctxt "common.close"
msgid "Close"
msgstr "Κλείσιμο"

msgctxt "common.continue"
msgid "Continue"
msgstr "Συνέχεια"

msgctxt "common.dismiss"
msgid "Dismiss"
msgstr "Απόρριψη"

msgctxt "common.loading"
msgid "Loading"
msgstr "Φόρτωση…"

msgctxt "common.retry"
msgid "Retry"
msgstr "Επανάληψη"

msgctxt "common.startOver"
msgid "Start over"
msgstr "Επανεκκίνηση"

msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Το Arroxy συνεχίζει να εκτελείται και ολοκληρώνει τις ενεργές λήψεις. Άλλαξέ το αργότερα στις Ρυθμίσεις για προχωρημένους."

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "Απόκρυψη στο δίσκο"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "Απόκρυψη Arroxy στο δίσκο συστήματος κατά το κλείσιμο;"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "Έξοδος"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "Να μη ζητηθεί ξανά"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "Ακύρωση λήψεων & Έξοδος"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "Κάνε παύση για να συνεχίσεις αργότερα ή ακύρωσε για να απορρίψεις την πρόοδο."

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "Συνέχεια λήψεων"

#. Plural form "one" for el: used for counts like 1.
msgctxt "dialogs.quitWithActiveDownloads.message_one"
msgid "{{count}} download in progress"
msgstr "{{count}} λήψη σε εξέλιξη"

#. Plural form "other" for el: used for counts like 0, 2, 3, 4, 5, 6.
msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "{{count}} λήψεις σε εξέλιξη"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "Παύση λήψεων και έξοδος"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "Η διαδικασία απόδοσης κατέρρευσε ({{reason}}). Ανανέωσε για να δοκιμάσεις ξανά."

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "Το Arroxy αντιμετώπισε πρόβλημα"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "Έξοδος"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "Ανανέωση"

msgctxt "donate.copied"
msgid "Copied!"
msgstr "Αντιγράφηκε!"

msgctxt "donate.copyAddress"
msgid "Copy address"
msgstr "Αντιγραφή διεύθυνσης"

msgctxt "donate.description"
msgid "Arroxy is free and open-source, with no ads or paid tier. Donations are optional and buy no influence over the roadmap."
msgstr "Το Arroxy είναι δωρεάν και ανοιχτού κώδικα, χωρίς διαφημίσεις ή επί πληρωμή πακέτο. Οι δωρεές είναι προαιρετικές και δεν δίνουν επιρροή στον οδικό χάρτη."

msgctxt "donate.footerLabel"
msgid "Donate"
msgstr "Δωρεά"

msgctxt "donate.footerTooltip"
msgid "Support Arroxy"
msgstr "Υποστηρίξτε το Arroxy"

msgctxt "donate.qrAlt"
msgid "{{coin}} donation address QR code"
msgstr "Κωδικός QR της διεύθυνσης δωρεάς {{coin}}"

msgctxt "donate.title"
msgid "Support Arroxy"
msgstr "Υποστηρίξτε το Arroxy"

msgctxt "donate.warning"
msgid "Crypto payments are irreversible. Send only on the network shown, and compare the whole address."
msgstr "Οι πληρωμές κρυπτονομισμάτων είναι μη αναστρέψιμες. Στείλτε μόνο μέσω του δικτύου που εμφανίζεται και συγκρίνετε ολόκληρη τη διεύθυνση."

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "Αυτό το βίντεο έχει περιορισμό ηλικίας και δεν μπορεί να ληφθεί χωρίς συνδεδεμένο λογαριασμό."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy updates its download engine on launch, so the fix lands automatically once it ships."
msgstr "Η προστασία bot ενεργοποιήθηκε. Η IP που χρησιμοποιείς είναι πιθανότατα επισημασμένη (εύρος datacenter ή πολυσύχναστη έξοδος VPN). Άλλαξε IP ή επέλεξε διαφορετικό endpoint VPN και δοκίμασε ξανά. Αν συνεχίζει να αποτυγχάνει, μπορεί να πρόκειται για προσωρινή αλλαγή από πλευράς του ιστότοπου — το Arroxy ενημερώνει τη μηχανή λήψης κατά την εκκίνηση, οπότε η επιδιόρθωση εφαρμόζεται αυτόματα μόλις κυκλοφορήσει."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream, and Arroxy gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "Ο διακομιστής διέκοπτε συνεχώς τη λήψη στη μέση και το Arroxy τα παράτησε μετά από επανειλημμένες προσπάθειες. Αυτό συμβαίνει συνήθως με τα μεγαλύτερα φορμά βίντεο (4K HDR / VP9 υψηλού ρυθμού μετάδοσης). Δοκίμασε ξανά, άλλαξε δίκτυο/VPN ή επέλεξε χαμηλότερη ανάλυση."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. Arroxy can't remove DRM, so the file can't be downloaded."
msgstr "Αυτό το βίντεο προστατεύεται από DRM. Το Arroxy δεν μπορεί να αφαιρέσει DRM, οπότε το αρχείο δεν μπορεί να ληφθεί."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "Αυτό το βίντεο δεν είναι διαθέσιμο στην περιοχή σου."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "Η διεύθυνση IP σου φαίνεται να έχει αποκλειστεί από το YouTube. Δοκίμασε αργότερα ή χρησιμοποίησε VPN."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "Αυτό το βίντεο απαιτεί λογαριασμό με σύνδεση."

msgctxt "errors.ytdlp.missingDependency"
msgid "Arroxy could not find FFmpeg or FFprobe. Run setup again or set an FFmpeg location, then retry the download."
msgstr "Το Arroxy δεν βρήκε το FFmpeg ή το FFprobe. Εκτέλεσε ξανά τη ρύθμιση ή όρισε μια τοποθεσία FFmpeg και μετά δοκίμασε ξανά τη λήψη."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "Σφάλμα δικτύου. Έλεγξε τη σύνδεσή σου και δοκίμασε ξανά."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "Δεν υπάρχει αρκετός χώρος στο δίσκο. Ελευθέρωσε χώρο και δοκίμασε ξανά."

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Το Arroxy δεν μπορεί να γράψει στον φάκελο λήψεων. Μπορεί να είναι μόνο για ανάγνωση, σε κλειδωμένη μονάδα δίσκου ή να μπλοκάρεται από τις ρυθμίσεις απορρήτου του συστήματός σου. Διάλεξε άλλον φάκελο ή επίτρεψε την πρόσβαση και δοκίμασε ξανά."

msgctxt "errors.ytdlp.outputPathExpands"
msgid "The download folder's path contains something the download engine reads as a variable, such as $HOME or %USERPROFILE%, so the files would be saved in another folder. Rename the folder or choose another one, then retry."
msgstr "Η διαδρομή του φακέλου λήψεων περιέχει κάτι που η μηχανή λήψης διαβάζει ως μεταβλητή, όπως $HOME ή %USERPROFILE%, οπότε τα αρχεία θα αποθηκεύονταν σε άλλον φάκελο. Μετονόμασε τον φάκελο ή διάλεξε άλλον και δοκίμασε ξανά."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. The site may have changed how it serves videos. Arroxy updates its download engine on launch — retry in a few minutes once the fix ships."
msgstr "Δεν ήταν δυνατή η ανάλυση της απάντησης από τον ιστότοπο. Ο ιστότοπος μπορεί να άλλαξε τον τρόπο με τον οποίο σερβίρει τα βίντεο. Το Arroxy ενημερώνει τη μηχανή λήψης κατά την εκκίνηση — δοκίμασε ξανά σε λίγα λεπτά μόλις κυκλοφορήσει η διόρθωση."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "The download finished, but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "Η λήψη ολοκληρώθηκε, αλλά η μετα-επεξεργασία (merge / mux / convert) απέτυχε. Συχνά πρόκειται για παροδικό πρόβλημα του ffmpeg — δοκίμασε ξανά και, αν επιμένει, δοκίμασε διαφορετικό συνδυασμό φορμά."

msgctxt "errors.ytdlp.rateLimit"
msgid "The site is rate-limiting requests from this connection."
msgstr "Ο ιστότοπος περιορίζει τα αιτήματα από αυτή τη σύνδεση."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "Αυτό το βίντεο δεν είναι διαθέσιμο — μπορεί να είναι ιδιωτικό, διαγραμμένο ή κλειδωμένο ανά περιοχή."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "Η λήψη απέτυχε. Δες το raw output παρακάτω."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "Arroxy doesn't support this URL. Try a link from a different site."
msgstr "Το Arroxy δεν υποστηρίζει αυτό το URL. Δοκίμασε έναν σύνδεσμο από διαφορετικό ιστότοπο."

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "Έλεγξε τη σύνδεσή σου και δοκίμασε ξανά."

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "Η σελίδα δεν φορτώθηκε"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "Άνοιγμα ρυθμίσεων"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "Έλεγξε το proxy στις Ρυθμίσεις και δοκίμασε ξανά."

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "Η Εξερεύνηση δεν μπορεί να συνδεθεί μέσω του proxy σου"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "Επανάληψη"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "Κάνε δεξί κλικ σε οποιονδήποτε σύνδεσμο βίντεο, λίστας αναπαραγωγής ή καναλιού στη σελίδα για να τον κατεβάσεις με το ενεργό προφίλ σου, να διαλέξεις άλλο προφίλ ή να ανοίξεις τη Διαδραστική λήψη."

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "Κάνε δεξί κλικ σε έναν σύνδεσμο για λήψη"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "Αντιγραφή συνδέσμου"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "Λήψη με"

msgctxt "explore.newBadge"
msgid "New"
msgstr "Νέο"

msgctxt "explore.notice.body"
msgid "Find a video on YouTube or any other site and download it from here — no copying links. Sign in to a site here to download videos that need an account."
msgstr "Βρες ένα βίντεο στο YouTube ή σε οποιονδήποτε άλλο ιστότοπο και κάνε λήψη από εδώ — χωρίς αντιγραφή συνδέσμων. Συνδέσου εδώ σε έναν ιστότοπο για να κατεβάζεις βίντεο που απαιτούν λογαριασμό."

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "Συνέχεια"

msgctxt "explore.notice.riskBody"
msgid "Sites like YouTube may flag — and sometimes ban — accounts used with download tools like Arroxy. Use an account you can afford to lose, not your main one."
msgstr "Ιστότοποι όπως το YouTube μπορεί να επισημάνουν — και μερικές φορές να αποκλείσουν — λογαριασμούς που χρησιμοποιούνται με εργαλεία λήψης όπως το Arroxy. Χρησιμοποίησε έναν λογαριασμό που αντέχεις να χάσεις, όχι τον κύριο."

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "Συνδέσου με δευτερεύοντα λογαριασμό"

msgctxt "explore.notice.title"
msgid "Browse the web right inside Arroxy"
msgstr "Περιήγηση στο διαδίκτυο μέσα στο Arroxy"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "Οι λήψεις χρησιμοποιούν τα cookies του προγράμματος περιήγησής σου, όχι τη σύνδεσή σου στην Εξερεύνηση."

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "Οι λήψεις χρησιμοποιούν το αρχείο cookies σου, όχι τη σύνδεσή σου στην Εξερεύνηση."

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "Όχι τώρα"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "Τα cookies είναι απενεργοποιημένα, οπότε οι λήψεις δεν χρησιμοποιούν τη σύνδεσή σου στην Εξερεύνηση."

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "Χρήση σύνδεσης Εξερεύνησης"

msgctxt "explore.settings.description"
msgid "Browse YouTube or any other site inside Arroxy, and sign in for videos that need an account."
msgstr "Περιηγήσου στο YouTube ή σε οποιονδήποτε άλλο ιστότοπο μέσα στο Arroxy και συνδέσου για βίντεο που απαιτούν λογαριασμό."

msgctxt "explore.settings.idleUnload"
msgid "Free memory while away"
msgstr "Αποδέσμευση μνήμης στο παρασκήνιο"

msgctxt "explore.settings.idleUnloadDescription"
msgid "After 5 minutes on another tab, closes the YouTube home or search page. Coming back reloads it, which takes a few seconds."
msgstr "Μετά από 5 λεπτά σε άλλη καρτέλα, κλείνει την αρχική σελίδα ή τη σελίδα αναζήτησης του YouTube. Με την επιστροφή, η σελίδα φορτώνεται ξανά, κάτι που διαρκεί λίγα δευτερόλεπτα."

msgctxt "explore.settings.searchEngine"
msgid "Search engine"
msgstr "Μηχανή αναζήτησης"

msgctxt "explore.settings.searchEngineDescription"
msgid "Where text typed in the address bar is searched. Links open as typed."
msgstr "Πού αναζητείται το κείμενο που πληκτρολογείται στη γραμμή διευθύνσεων. Οι σύνδεσμοι ανοίγουν όπως πληκτρολογήθηκαν."

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "Εμφάνιση της καρτέλας Εξερεύνηση"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "Η απενεργοποίηση σταματά επίσης τις λήψεις από το να χρησιμοποιούν τη σύνδεσή σου στην Εξερεύνηση."

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "Αποσύνδεση από την Εξερεύνηση"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "Αποσύνδεση"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your sign-ins and browsing data in Explore, on every site. Downloads that need an account will fail until you sign in again."
msgstr "Διαγράφει τις συνδέσεις σου και τα δεδομένα περιήγησης στην Εξερεύνηση, σε κάθε ιστότοπο. Οι λήψεις που απαιτούν λογαριασμό θα αποτυγχάνουν μέχρι να συνδεθείς ξανά."

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "Αποσύνδεση από την Εξερεύνηση;"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your sign-ins and browsing data in Explore, on every site."
msgstr "Διαγράφει τις συνδέσεις σου και τα δεδομένα περιήγησης στην Εξερεύνηση, σε κάθε ιστότοπο."

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "Εξερεύνηση"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "Εξερεύνηση"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "Το YouTube μπορεί να αντιδράσει στη φραγή διαφημίσεων για συνδεδεμένους λογαριασμούς."

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "Φραγή διαφημίσεων"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "Φραγή διαφημίσεων: ανενεργή — κάνε κλικ για ενεργοποίηση"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "Φραγή διαφημίσεων: ενεργή — κάνε κλικ για απενεργοποίηση"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "Φραγή διαφημίσεων: εκκίνηση — κάνε κλικ για απενεργοποίηση"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "Φραγή διαφημίσεων: μη διαθέσιμη, δεν ήταν δυνατή η λήψη των λιστών φίλτρων της — κάνε κλικ για απενεργοποίηση"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
msgstr "Διεύθυνση"

msgctxt "explore.toolbar.addressPlaceholder"
msgid "Search {{engine}} or open any site (Vimeo, Instagram…)"
