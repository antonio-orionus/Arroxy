msgid "About Arroxy"
msgstr "Apie „Arroxy“"

msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "Greita ir patogi YouTube bei daugiau nei 2000 kitų svetainių atsisiuntimo programa."

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "Peržiūrėti trečiųjų šalių pranešimus"

msgctxt "about.websiteLink"
msgid "Website"
msgstr "Svetainė"

msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Leisti"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube kai kuriuos senus vaizdo įrašus siūlo dydžiais, sukurtais naudojant dirbtinį intelektą. Pasirinkus „Praleisti“, paliekami originalūs srautai; išdidintą srautą vis tiek galite pasirinkti rankiniu būdu."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "DI išdidinti srautai"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Praleisti"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Atsiliepimai"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Patinka Arroxy? Norėčiau išgirsti jūsų nuomonę! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Žurnalai"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Įrašyti diagnostikos failą"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "Sudeda jūsų žurnalus ir programos informaciją į vieną failą aplanke „Atsisiuntimai“, kurį galite pridėti prie GitHub pranešimo apie problemą. Jūsų naudotojo aplanko pavadinimas pašalinamas; vaizdo įrašų nuorodos ir pavadinimai lieka."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Nauja: čia pasirinkite „Aurora“ arba „Minimalistinis“"

msgctxt "app.theme"
msgid "Theme"
msgstr "Tema"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Padidinti"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Sumažinti"

