msgstr "{resolution} negali būti aplanko pavadinimas – kokybė nežinoma, kol neprasideda atsisiuntimas."

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "Nesuporuotas { arba } – žymes, pvz., {title}, apgaubkite skliaustais."

