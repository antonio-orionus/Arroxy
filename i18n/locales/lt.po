msgstr "Greitasis režimas į eilę įtraukia įkeltus elementus su profiliu {{profileName}}. Interaktyvus leidžia pirmiausia peržiūrėti ar pasirinkti elementus."

msgctxt "wizard.url.mascotIdle"
msgid "Drop a link and let Arroxy pull it ✨"
msgstr "Įmeskite nuorodą ir leiskite Arroxy ją atsisiųsti ✨"

msgctxt "wizard.url.mascotMixed"
msgid "This link points at one video inside a collection. Arroxy will ask which one you want before probing."
msgstr "Ši nuoroda rodo į vieną vaizdo įrašą kolekcijoje. Arroxy paklaus, kurį norite, prieš nuskaitydama."

msgctxt "wizard.url.mascotPreparing"
msgid "{{quickDownload}} is reading this link and applying {{profileName}}."
msgstr "{{quickDownload}} skaito šią nuorodą ir taiko profilį {{profileName}}."

msgctxt "wizard.url.mascotQueued"
msgid "The queue is handling this download. You can paste another link while it works."
msgstr "Eilė tvarko šį atsisiuntimą. Kol jis vyksta, galite įklijuoti kitą nuorodą."

msgctxt "wizard.url.mascotSingle"
msgid "Quick starts one download with {{profileName}}. Use Interactive for one-off changes."
msgstr "Greitasis režimas pradeda vieną atsisiuntimą su profiliu {{profileName}}. Vienkartiniams pakeitimams naudokite interaktyvų."

msgctxt "wizard.url.nativeAudioPreference.compatible"
