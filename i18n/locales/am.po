msgstr "አገናኝ ከቅንጥብ ሰሌዳ ታክሏል"

msgctxt "wizard.url.clipboard.bulkHint"
msgid "Multiple links copied — use Bulk URLs to add them"
msgstr "ብዙ አገናኞች ተቀድተዋል — ለመጨመር «ብዙ URLዎች»ን ይጠቀሙ"

msgctxt "wizard.url.clipboard.dialog.cancelButton"
msgid "Cancel"
msgstr "ሰርዝ"

msgctxt "wizard.url.clipboard.replacedLink"
msgid "Replaced with copied link"
msgstr "በተቀዳው አገናኝ ተተክቷል"

msgctxt "wizard.url.clipboard.toggle"
msgid "Watch clipboard"
msgstr "ቅጂ ሰሌዳ ተቆጣጠር"

msgctxt "wizard.url.clipboard.toggleDescription"
msgid "Auto-fill the URL field when you copy a video link."
msgstr "YouTube አገናኝ ሲቀዱ የ URL መስክን በራስ ሞላ።"

msgctxt "wizard.url.clipboard.undo"
msgid "Undo"
msgstr "ቀልብስ"

msgctxt "wizard.url.closeToTray.toggle"
msgid "Hide to tray on close"
msgstr "ሲዘጋ ወደ ትሬ ደብቅ"

msgctxt "wizard.url.closeToTray.toggleDescription"
msgid "Continue downloads in the background after closing the window."
msgstr "መስኮት ሲዘጋ ዳውንሎዶችን ዳራ ቀጥል።"

msgctxt "wizard.url.concurrentDownloads.description"
msgid "How many queued items download at the same time. More at once finishes a long queue sooner, but raises the chance a site limits you."
msgstr "በተመሳሳይ ጊዜ ስንት የተሰለፉ ንጥሎች እንደሚወርዱ። ብዙ በአንድ ጊዜ ረጅም ሰልፍን ቶሎ ይጨርሳል፣ ነገር ግን ጣቢያው እንዲገድብዎ ዕድሉን ይጨምራል።"

msgctxt "wizard.url.concurrentDownloads.label"
msgid "Downloads at once"
msgstr "በአንድ ጊዜ ዳውንሎዶች"

msgctxt "wizard.url.concurrentDownloads.unit"
msgid "downloads"
msgstr "ዳውንሎዶች"

msgctxt "wizard.url.cookies.banWarning"
msgid "Sites like YouTube may flag — and sometimes ban — accounts whose cookies are used by download tools like Arroxy. Use a throwaway account when possible."
msgstr "እንደ YouTube ያሉ ጣቢያዎች Cookies-ቸው እንደ Arroxy ባሉ የማውረጃ መሣሪያዎች የሚጠቀሙባቸውን መለያዎች ሊጠቁሙ — እና አንዳንድ ጊዜ ሊያግዱ — ይችላሉ። ከተቻለ የሚጣል መለያ ይጠቀሙ።"

msgctxt "wizard.url.cookies.browserHelp"
msgid "Reads cookies directly from the browser. The browser must be closed for Chromium-family browsers."
msgstr "Cookies ቀጥታ ከአሳሹ ያነባል። Chromium-ቤተሰብ አሳሾች ሲጠቀሙ አሳሹ ዝጋ።"

msgctxt "wizard.url.cookies.browserLabel"
msgid "Browser"
msgstr "አሳሽ"

msgctxt "wizard.url.cookies.browserPlaceholder"
msgid "Pick a browser…"
