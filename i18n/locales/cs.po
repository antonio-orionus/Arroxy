msgstr "{{quickDownload}} čte tento odkaz a používá profil {{profileName}}."

msgctxt "wizard.url.mascotQueued"
msgid "The queue is handling this download. You can paste another link while it works."
msgstr "Toto stahování zpracovává fronta. Během práce můžete vložit další odkaz."

msgctxt "wizard.url.mascotSingle"
