msgid "Feedback"
msgstr "Zpětná vazba"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Líbí se vám Arroxy? Budu rád za vaši zpětnou vazbu! 💬"

