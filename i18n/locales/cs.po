msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Povolit"

msgctxt "aiUpscaled.allowedSummary"
msgid "AI-upscaled allowed"
msgstr "Streamy zvětšené pomocí AI jsou povoleny"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube nabízí některá stará videa ve velikostech vytvořených pomocí AI. Možnost Přeskočit ponechá původní streamy; ručně můžete stále vybrat i AI zvětšený stream."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "Streamy zvětšené pomocí AI"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Přeskočit"

