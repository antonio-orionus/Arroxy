msgctxt "wizard.url.mascotCollection"
msgid "Quick queues loaded items with {{profileName}}. Interactive lets you inspect or select items first."
msgstr "A Gyors a betöltött elemeket a(z) {{profileName}} profillal állítja sorba. Az Interaktívval előbb megvizsgálhatja vagy kijelölheti az elemeket."

msgctxt "wizard.url.mascotIdle"
msgid "Drop a link and let Arroxy pull it ✨"
msgstr "Dobjon be egy hivatkozást, és az Arroxy letölti ✨"

msgctxt "wizard.url.mascotMixed"
msgid "This link points at one video inside a collection. Arroxy will ask which one you want before probing."
msgstr "Ez a hivatkozás egy gyűjtemény egyik videójára mutat. Az Arroxy lekérdezés előtt megkérdezi, melyiket szeretné."

