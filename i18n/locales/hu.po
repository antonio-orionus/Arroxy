msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "Engedélyezés"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "A YouTube egyes régi videókat MI-vel készített méretekben is kínál. A Kihagyás megtartja az eredeti adatfolyamokat; felskálázottat továbbra is kiválaszthat kézzel."

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "MI-vel felskálázott adatfolyamok"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "Kihagyás"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "Visszajelzés"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Tetszik az Arroxy? Szívesen meghallgatom a véleményét! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "Naplók"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "Diagnosztikai fájl mentése"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "A naplókat és az alkalmazás adatait egyetlen fájlba menti a Letöltések mappába, amelyet csatolhat egy GitHub-hibajelentéshez. A felhasználói mappa neve eltávolításra kerül; a videók hivatkozásai és címei megmaradnak."

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "Új: itt választhat az Aurora és a Minimal között"

msgctxt "app.theme"
msgid "Theme"
msgstr "Téma"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "Nagyítás"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "Kicsinyítés"

