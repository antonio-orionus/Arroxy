msgctxt "donate.copied"
msgid "Copied!"
msgstr "کاپي شو!"

msgctxt "donate.copyAddress"
msgid "Copy address"
msgstr "پته کاپي کړئ"

msgctxt "donate.description"
msgid "Arroxy is free and open-source, with no ads or paid tier. Donations are optional and buy no influence over the roadmap."
msgstr "Arroxy وړیا او خلاص‌سرچینه دی، بې اعلانونو او بې د پیسو پلان. مرستې اختیاري دي او د پرمختګ پلان باندې اغېز نه لري."

msgctxt "donate.footerLabel"
msgid "Donate"
msgstr "مرسته"

msgctxt "donate.footerTooltip"
msgid "Support Arroxy"
msgstr "له Arroxy ملاتړ وکړئ"

msgctxt "donate.qrAlt"
msgid "{{coin}} donation address QR code"
msgstr "د {{coin}} د مرستې پتې QR کوډ"

msgctxt "donate.title"
msgid "Support Arroxy"
msgstr "له Arroxy ملاتړ وکړئ"

msgctxt "donate.warning"
msgid "Crypto payments are irreversible. Send only on the network shown, and compare the whole address."
msgstr "د کریپټو تادیې بیرته نه راګرځي. یوازې د ښودل شوې شبکې له لارې ولېږئ او ټوله پته پرتله کړئ."

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "دا ویډیو د عمر محدودیت لري او پرته د ننوتلي حساب نه شي ډاونلوډ کیدی."

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy updates its download engine on launch, so the fix lands automatically once it ships."
msgstr "د بوټ محافظت فعال شو. ستاسو IP پته ډیره احتمال نښه شوې (د ډیټاسینټر رینج یا ګڼ کارونکي VPN وتلو ټکی). خپل IP بدل کړئ یا بل VPN پای ټکی غوره کړئ او بیا هڅه وکړئ. که چیرې لا هم ناکامه وي، دا ممکن د سایټ خوا لنډمهاله بدلون وي — Arroxy د پیل پر وخت خپل د ډاونلوډ انجن تازه کوي، نو سمون به اتوماتیک راشي کله چې خپور شي."

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream, and Arroxy gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "سرور د ډاونلوډ پرمهال وصل کول پرې کاوه او Arroxy د بیا هڅولو وروسته پریښود. دا معمولاً د ترټولو لوی ویډیو فارمیټونو (4K HDR / لوړ بیټ ریټ VP9) سره پیښیږي. بیا هڅه وکړئ، شبکه/VPN بدل کړئ، یا ټیټ ریزولوشن فارمیټ غوره کړئ."

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. Arroxy can't remove DRM, so the file can't be downloaded."
msgstr "دا ویډیو د DRM لخوا خوندي ده. Arroxy نشي کولی DRM لیرې کړي، نو فایل نشي ډاونلوډ کیدی."

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "دا ویډیو ستاسو سیمه کې شتون نلري."

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "ستاسو IP پته ممکن د YouTube لخوا بنده شوې وي. وروسته بیا هڅه وکړئ یا VPN وکاروئ."

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "دا ویډیو ننوتي اکاونټ ته اړتیا لري."

msgctxt "errors.ytdlp.missingDependency"
msgid "Arroxy could not find FFmpeg or FFprobe. Run setup again or set an FFmpeg location, then retry the download."
msgstr "Arroxy FFmpeg یا FFprobe ونه موند. نصب بیا چل کړئ یا د FFmpeg ځای وټاکئ، بیا ډاونلوډ بیا وازمایئ."

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "د شبکې تېروتنه. خپله اړیکه وګورئ او بیا هڅه وکړئ."

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "د ډیسک کافي ځای نشته. ځای خالي کړئ او بیا هڅه وکړئ."

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Arroxy د ډاونلوډ فولډر ته نشي لیکلی. کېدای شي یوازې د لوستلو وړ وي، په تړل شوي ډرایو کې وي، یا ستاسو د سیسټم د محرمیت تنظیماتو بند کړی وي. بل فولډر وټاکئ یا لاسرسی ورکړئ، بیا هڅه وکړئ."

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. The site may have changed how it serves videos. Arroxy updates its download engine on launch — retry in a few minutes once the fix ships."
msgstr "د سایټ ځواب پارس نه شو. سایټ ممکن د ویډیوګانو د وړاندې کولو طریقه بدله کړې وي. Arroxy په پیلیدو سره خپل د ډاونلوډ انجن تازه کوي — څو دقیقې وروسته بیا هڅه وکړئ کله چې اصلاح راشي."

msgctxt "errors.ytdlp.postprocessFailure"
msgid "The download finished, but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "ډاونلوډ بشپړ شو، خو وروستی پروسس (یوځای کول / mux / بدلون) ناکام شو. ډیری وختونه دا د ffmpeg لنډمهاله ستونزه ده — بیا هڅه وکړئ، او که دوام ولري، بل فارمیټ ترکیب وازمویئ."

msgctxt "errors.ytdlp.rateLimit"
msgid "The site is rate-limiting requests from this connection."
msgstr "سایټ د دې اتصال غوښتنې محدودوي."

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "دا ویډیو شتون نلري — ممکن شخصي، حذف شوې، یا سیمه بنده وي."

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "ډاونلوډ ناکام شو. لاندې خام محصول وګورئ."

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "Arroxy doesn't support this URL. Try a link from a different site."
msgstr "Arroxy دا URL نه ملاتړ کوي. د بل سایټ لینک وازمویئ."

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "خپل اتصال وګورئ، ورپسې بیا هڅه وکړئ."

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "دا پاڼه بار نه شوه"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "امستنې پرانیزئ"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "په امستنو کې پراکسي وګورئ، ورپسې بیا هڅه وکړئ."

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "سپړنه ستاسو د پراکسي له لارې نه شي نښلېدای"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "بیا هڅه وکړه"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "په پاڼه کې د هر ویډیو، پلې‌لېست یا چینل پر لینک ښي کلیک وکړئ ترڅو د فعال پروفایل سره یې ډاونلوډ کړئ، بل پروفایل وټاکئ یا تعاملي ډاونلوډ پرانیزئ."

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "د ډاونلوډ لپاره پر لینک ښي کلیک وکړئ"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "لینک کاپي کړئ"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "په پروفایل ډاونلوډ"

msgctxt "explore.newBadge"
msgid "New"
msgstr "نوی"

msgctxt "explore.notice.body"
msgid "Find a video on YouTube or any other site and download it from here — no copying links. Sign in to a site here to download videos that need an account."
msgstr "په YouTube یا بل هر سایټ کې یو ویډیو ومومئ او له همدې ځایه یې ښکته کړئ — پرته له لینک کاپي کولو. هغه ویډیوګانې ښکته کولو لپاره چې حساب غواړي دلته په یو سایټ کې ننوځئ."

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "دوام ورکړه"

msgctxt "explore.notice.riskBody"
msgid "Sites like YouTube may flag — and sometimes ban — accounts used with download tools like Arroxy. Use an account you can afford to lose, not your main one."
msgstr "YouTube غوندې سایټونه ممکن هغه حسابونه چې د Arroxy غوندې د ښکته کولو وسیلو سره کارول کیږي نښه کړي او ځینې وختونه بنده کړي. هغه حساب وکاروئ چې له لاسه ورکول یې مهم نه وي، نه خپل اصلي حساب."

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "په دویم حساب ننوځئ"

msgctxt "explore.notice.title"
msgid "Browse the web right inside Arroxy"
msgstr "ویب د Arroxy دننه وګورئ"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "ښکته کول ستاسو د براوزر کوکیز کاروي، نه ستاسو د سپړنې ننوتل."

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "ښکته کول ستاسو د کوکیز فایل کاروي، نه ستاسو د سپړنې ننوتل."

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "اوس نه"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "کوکیز بند دي، نو ښکته کول ستاسو د سپړنې ننوتل نه کاروي."

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "د سپړنې ننوتل وکاروئ"

msgctxt "explore.settings.description"
msgid "Browse YouTube or any other site inside Arroxy, and sign in for videos that need an account."
msgstr "YouTube یا بل هر سایټ د Arroxy دننه وګورئ او هغو ویډیوګانو لپاره ننوځئ چې حساب غواړي."

msgctxt "explore.settings.idleUnload"
msgid "Free memory while away"
msgstr "د نشتوالي پر مهال حافظه آزاده کړئ"

msgctxt "explore.settings.idleUnloadDescription"
msgid "After 5 minutes on another tab, closes the YouTube home or search page. Coming back reloads it, which takes a few seconds."
msgstr "په بل ټب کې له ۵ دقیقو وروسته، د YouTube کور یا لټون پاڼه بندوي. د بېرته راتګ پر مهال بیا پورته کېږي، چې څو ثانیې وخت نیسي."

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "د سپړنې ټب ښکاره کړئ"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "که یې بند کړئ، ښکته کول به هم ستاسو د سپړنې ننوتل ونه کاروي."

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "له سپړنې څخه وتل"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "وتل"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your sign-ins and browsing data in Explore, on every site. Downloads that need an account will fail until you sign in again."
msgstr "دا په سپړنه کې په ټولو سایټونو کې ستاسو ننوتل او د کتلو معلومات پاکوي. هغه ښکته کول چې حساب غواړي به تر بیا ننوتلو ناکام وي."

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "له سپړنې څخه وځئ؟"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your sign-ins and browsing data in Explore, on every site."
msgstr "په سپړنه کې په ټولو سایټونو کې ستاسو ننوتل او د کتلو معلومات پاکوي."

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "سپړنه"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "سپړنه"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "YouTube کېدای شي د ننوتلو اکاونټونو لپاره د اعلان بلاکرونو پروړاندې مقاومت وکړي."

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "د اعلان بلاکر"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "د اعلان بلاکر: بند — د چالانولو لپاره کلیک وکړئ"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "د اعلان بلاکر: چالان — د بندولو لپاره کلیک وکړئ"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "د اعلان بلاکر: پیلېږي — د بندولو لپاره کلیک وکړئ"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "د اعلان بلاکر: شتون نلري، د دې د فلټر لیستونه ډاونلوډ نشول — د بندولو لپاره کلیک وکړئ"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
