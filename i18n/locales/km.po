msgctxt "about.button"
msgid "About"
msgstr "អំពី"

msgctxt "about.githubLink"
msgid "GitHub"
msgstr "GitHub"

msgctxt "about.licenseLine"
msgid "MIT License · by Antonio Orionus"
msgstr "អាជ្ញាប័ណ្ណ MIT · ដោយ Antonio Orionus"

msgctxt "about.openTitle"
msgid "About Arroxy"
msgstr "អំពី Arroxy"

msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "កម្មវិធីទាញយកលឿន និងងាយស្រួលសម្រាប់ YouTube និងគេហទំព័រជាង 2000 ផ្សេងទៀត។"

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "មើលសេចក្តីជូនដំណឹងភាគីទីបី"

msgctxt "about.websiteLink"
msgid "Website"
msgstr "គេហទំព័រ"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "មតិកែលម្អ"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "ចូលចិត្ត Arroxy ទេ? ខ្ញុំចង់ឮពីអ្នកណាស់! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "កំណត់ហេតុ"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "រក្សាទុកឯកសាររោគវិនិច្ឆ័យ"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "ដាក់កំណត់ហេតុ និងព័ត៌មានកម្មវិធីរបស់អ្នកទៅក្នុងឯកសារតែមួយក្នុង Downloads ដែលរួចរាល់សម្រាប់ភ្ជាប់ទៅ GitHub issue។ ឈ្មោះថតអ្នកប្រើរបស់អ្នកត្រូវបានលុបចេញ ប៉ុន្តែតំណ និងចំណងជើងវីដេអូនៅដដែល។"

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "ថ្មី៖ ជ្រើសរើស អូរ៉ូរ៉ា ឬ សាមញ្ញ នៅទីនេះ"

msgctxt "app.theme"
msgid "Theme"
msgstr "ធីម"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "ពង្រីក"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "បង្រួម"

msgctxt "common.back"
msgid "Back"
msgstr "ថយក្រោយ"

msgctxt "common.cancel"
msgid "Cancel"
msgstr "បោះបង់"

msgctxt "common.continue"
msgid "Continue"
msgstr "បន្ត"

msgctxt "common.dismiss"
msgid "Dismiss"
msgstr "បិទ"

msgctxt "common.loading"
msgid "Loading"
msgstr "កំពុងផ្ទុក"

msgctxt "common.retry"
msgid "Retry"
msgstr "ព្យាយាមម្តងទៀត"

msgctxt "common.startOver"
msgid "Start over"
msgstr "ចាប់ផ្តើមឡើងវិញ"

msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Arroxy បន្តដំណើរការ ហើយបញ្ចប់ការទាញយកសកម្ម។ ប្តូរវានៅពេលក្រោយក្នុងការកំណត់កម្រិតខ្ពស់។"

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "លាក់ទៅថាស"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "លាក់ Arroxy ទៅថាសប្រព័ន្ធនៅពេលបិទ?"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "ចាកចេញ"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "កុំសួរម្តងទៀត"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "បោះបង់ការទាញយក និងចាកចេញ"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "ផ្អាកដើម្បីបន្តនៅពេលក្រោយ ឬបោះបង់ដើម្បីលុបវឌ្ឍនភាព។"

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "បន្តទាញយក"

#. Plural form "other" for km: used for counts like 0, 1, 2, 3, 4, 5.
msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "ការទាញយក {{count}} កំពុងដំណើរការ"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "ផ្អាកការទាញយក និងចាកចេញ"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "ដំណើរការ renderer បានគាំង ({{reason}})។ ផ្ទុកឡើងវិញដើម្បីព្យាយាមម្តងទៀត។"

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "Arroxy បានជួបបញ្ហា"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "ចាកចេញ"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "ផ្ទុកឡើងវិញ"

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "វីដេអូនេះត្រូវបានកំណត់អាយុ ហើយមិនអាចទាញយកបានដោយគ្មានគណនីដែលបានចូលទេ។"

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy auto-updates yt-dlp on launch, so the fix lands automatically once upstream ships it."
msgstr "ការការពារ bot ត្រូវបានបង្ក។ IP ដែលអ្នកកំពុងប្រើទំនងជាត្រូវបានសម្គាល់ (ជួរ datacenter ឬច្រកចេញ VPN មមាញឹក)។ ប្តូរ IP របស់អ្នក ឬជ្រើសរើសចំណុច VPN ផ្សេង ហើយព្យាយាមម្តងទៀត។ ប្រសិនបើវានៅតែបរាជ័យ នេះអាចជាការផ្លាស់ប្តូរបណ្តោះអាសន្នពីគេហទំព័រ — Arroxy ធ្វើបច្ចុប្បន្នភាព yt-dlp ដោយស្វ័យប្រវត្តិនៅពេលបើក ដូច្នេះការជួសជុលនឹងមកដល់ដោយស្វ័យប្រវត្តិនៅពេលប្រភពដើមចេញផ្សាយវា។"

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream and yt-dlp gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "ម៉ាស៊ីនមេបានកាត់ការទាញយកពាក់កណ្តាលស្ទ្រីមជាបន្តបន្ទាប់ ហើយ yt-dlp បានឈប់បន្ទាប់ពីព្យាយាមម្តងទៀត។ នេះជាធម្មតាកើតឡើងចំពោះទម្រង់វីដេអូធំបំផុត (4K HDR / VP9 bitrate ខ្ពស់)។ ព្យាយាមម្តងទៀត ប្តូរបណ្តាញ/VPN ឬជ្រើសរើសទម្រង់គុណភាពបង្ហាញទាបជាង។"

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. yt-dlp can't strip DRM, so the file can't be downloaded."
msgstr "វីដេអូនេះត្រូវបានការពារដោយ DRM។ yt-dlp មិនអាចដក DRM បានទេ ដូច្នេះឯកសារមិនអាចទាញយកបានទេ។"

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "វីដេអូនេះមិនមាននៅក្នុងតំបន់របស់អ្នកទេ។"

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "អាសយដ្ឋាន IP របស់អ្នកហាក់ដូចជាត្រូវបានទប់ស្កាត់។ ព្យាយាមម្តងទៀតនៅពេលក្រោយ ឬប្រើ VPN។"

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "វីដេអូនេះត្រូវការគណនីដែលបានចូល។"

msgctxt "errors.ytdlp.missingDependency"
msgid "yt-dlp could not find ffmpeg or ffprobe. Repair the bundled binaries or set an FFmpeg location, then retry."
msgstr "yt-dlp រកមិនឃើញ ffmpeg ឬ ffprobe ទេ។ ជួសជុលឯកសារ binary ដែលភ្ជាប់មកជាមួយ ឬកំណត់ទីតាំង FFmpeg បន្ទាប់មកព្យាយាមម្តងទៀត។"

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "កំហុសបណ្តាញ។ ពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្តងទៀត។"

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "ទំហំថាសមិនគ្រប់គ្រាន់។ សម្អាតទំហំ ហើយព្យាយាមម្តងទៀត។"

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Arroxy មិនអាចសរសេរទៅថតទាញយកបានទេ។ វាអាចជាបានតែអាន នៅលើដ្រាយដែលបានចាក់សោ ឬត្រូវបានទប់ស្កាត់ដោយការកំណត់ឯកជនភាពនៃប្រព័ន្ធរបស់អ្នក។ ជ្រើសរើសថតផ្សេង ឬអនុញ្ញាតការចូលប្រើ បន្ទាប់មកព្យាយាមម្តងទៀត។"

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. yt-dlp's extractor may have drifted. Arroxy auto-updates yt-dlp on launch — retry in a few minutes once the fix ships."
msgstr "មិនអាចញែកការឆ្លើយតបពីគេហទំព័របានទេ។ extractor របស់ yt-dlp អាចហួសសម័យ។ Arroxy ធ្វើបច្ចុប្បន្នភាព yt-dlp ដោយស្វ័យប្រវត្តិនៅពេលបើក — ព្យាយាមម្តងទៀតក្នុងរយៈពេលពីរបីនាទីនៅពេលការជួសជុលចេញផ្សាយ។"

msgctxt "errors.ytdlp.postprocessFailure"
msgid "yt-dlp finished downloading but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "yt-dlp បានទាញយករួច ប៉ុន្តែការដំណើរការក្រោយ (បញ្ចូល / mux / បម្លែង) បានបរាជ័យ។ ជាញឹកញាប់នេះជាបញ្ហា ffmpeg បណ្តោះអាសន្ន — ព្យាយាមម្តងទៀត ហើយប្រសិនបើវានៅតែកើតឡើង សាកល្បងបន្សំទម្រង់ផ្សេង។"

msgctxt "errors.ytdlp.rateLimit"
msgid "Site is rate-limiting requests. Wait a minute then retry."
msgstr "គេហទំព័រកំពុងកំណត់អត្រាសំណើ។ រង់ចាំមួយនាទី បន្ទាប់មកព្យាយាមម្តងទៀត។"

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "វីដេអូនេះមិនអាចប្រើបាន — វាអាចជាឯកជន ត្រូវបានលុប ឬត្រូវបានចាក់សោតាមតំបន់។"

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "ការទាញយកបានបរាជ័យ។ មើលលទ្ធផលដើមខាងក្រោម។"

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "That URL isn't supported by yt-dlp. Try a different link from any of yt-dlp's supported sites."
msgstr "URL នោះមិនត្រូវបានគាំទ្រដោយ yt-dlp ទេ។ សាកល្បងតំណផ្សេងពីគេហទំព័រណាមួយដែល yt-dlp គាំទ្រ។"

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "ពិនិត្យការតភ្ជាប់របស់អ្នក បន្ទាប់មកព្យាយាមម្តងទៀត។"

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "ទំព័រនេះមិនបានផ្ទុកទេ"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "បើកការកំណត់"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "ពិនិត្យប្រូកស៊ីក្នុងការកំណត់ បន្ទាប់មកព្យាយាមម្តងទៀត។"

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "Explore មិនអាចតភ្ជាប់តាមប្រូកស៊ីរបស់អ្នកបានទេ"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "ព្យាយាមម្តងទៀត"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "ចុចខាងស្តាំលើតំណវីដេអូ បញ្ជីចាក់ ឬប៉ុស្តិ៍ណាមួយនៅលើទំព័រ ដើម្បីទាញយកដោយប្រើប្រវត្តិរូបសកម្ម ជ្រើសរើសប្រវត្តិរូបផ្សេង ឬបើកការទាញយកអន្តរកម្ម។"

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "ចុចខាងស្តាំលើតំណដើម្បីទាញយក"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "ចម្លងតំណ"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "ទាញយកដោយប្រើ"

msgctxt "explore.newBadge"
msgid "New"
msgstr "ថ្មី"

msgctxt "explore.notice.body"
msgid "Find a video, playlist, or channel and download it from here — no copying links. Sign in to YouTube here to download videos that need an account."
msgstr "ស្វែងរកវីដេអូ បញ្ជីចាក់ ឬប៉ុស្តិ៍ ហើយទាញយកវាពីទីនេះ — មិនចាំបាច់ចម្លងតំណទេ។ ចូលគណនី YouTube នៅទីនេះដើម្បីទាញយកវីដេអូដែលត្រូវការគណនី។"

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "បន្ត"

msgctxt "explore.notice.riskBody"
msgid "YouTube may flag — and sometimes ban — accounts used with download tools like yt-dlp. Use an account you can afford to lose, not your main one."
msgstr "YouTube អាចសម្គាល់ — ហើយពេលខ្លះហាមឃាត់ — គណនីដែលប្រើជាមួយឧបករណ៍ទាញយកដូចជា yt-dlp។ ប្រើគណនីដែលអ្នកអាចបាត់បង់បាន មិនមែនគណនីចម្បងរបស់អ្នកទេ។"

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "ចូលគណនីជាមួយគណនីបន្ទាប់បន្សំ"

msgctxt "explore.notice.title"
msgid "Browse YouTube right inside Arroxy"
msgstr "រុករក YouTube នៅក្នុង Arroxy ផ្ទាល់"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "ការទាញយកប្រើ cookies របស់កម្មវិធីរុករក មិនមែនការចូលគណនី Explore ទេ។"

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "ការទាញយកប្រើឯកសារ cookies របស់អ្នក មិនមែនការចូលគណនី Explore ទេ។"

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "មិនមែនឥឡូវទេ"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "Cookies ត្រូវបានបិទ ដូច្នេះការទាញយកមិនប្រើការចូលគណនី Explore របស់អ្នកទេ។"

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "ប្រើការចូលគណនី Explore"

msgctxt "explore.settings.description"
msgid "Browse YouTube inside Arroxy and sign in for videos that need an account."
msgstr "រុករក YouTube នៅក្នុង Arroxy ហើយចូលគណនីសម្រាប់វីដេអូដែលត្រូវការគណនី។"

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "បង្ហាញផ្ទាំង Explore"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "ការបិទវាក៏បញ្ឈប់ការទាញយកពីការប្រើការចូលគណនី Explore របស់អ្នកដែរ។"

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "ចាកចេញពី Explore"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "ចាកចេញ"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your YouTube sign-in and browsing data in Explore. Downloads that need an account will fail until you sign in again."
msgstr "វាសម្អាតការចូលគណនី YouTube និងទិន្នន័យរុករករបស់អ្នកក្នុង Explore។ ការទាញយកដែលត្រូវការគណនីនឹងបរាជ័យរហូតដល់អ្នកចូលគណនីម្តងទៀត។"

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "ចាកចេញពី Explore?"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your YouTube sign-in and browsing data in Explore."
msgstr "សម្អាតការចូលគណនី YouTube និងទិន្នន័យរុករករបស់អ្នកក្នុង Explore។"

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "Explore"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "Explore"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "YouTube អាចប្រឆាំងនឹងកម្មវិធីទប់ស្កាត់ពាណិជ្ជកម្មសម្រាប់គណនីដែលបានចូល។"

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "កម្មវិធីទប់ស្កាត់ពាណិជ្ជកម្ម"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "កម្មវិធីទប់ស្កាត់ពាណិជ្ជកម្ម៖ បិទ — ចុចដើម្បីបើក"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "កម្មវិធីទប់ស្កាត់ពាណិជ្ជកម្ម៖ បើក — ចុចដើម្បីបិទ"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "កម្មវិធីទប់ស្កាត់ពាណិជ្ជកម្ម៖ កំពុងចាប់ផ្តើម — ចុចដើម្បីបិទ"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "កម្មវិធីទប់ស្កាត់ពាណិជ្ជកម្ម៖ មិនអាចប្រើបាន បញ្ជីតម្រងរបស់វាមិនអាចទាញយកបានទេ — ចុចដើម្បីបិទ"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
msgstr "អាសយដ្ឋាន"

msgctxt "explore.toolbar.addressPlaceholder"
msgid "Search YouTube or paste a YouTube link"
msgstr "ស្វែងរក YouTube ឬបិទភ្ជាប់តំណ YouTube"

msgctxt "explore.toolbar.aria"
msgid "Explore browser controls"
msgstr "ការគ្រប់គ្រងកម្មវិធីរុករក Explore"

msgctxt "explore.toolbar.back"
msgid "Back"
msgstr "ថយក្រោយ"

msgctxt "explore.toolbar.compactLayout"
msgid "Compact layout"
msgstr "ប្លង់បង្រួម"

msgctxt "explore.toolbar.downloadWithProfile"
msgid "Download · {{profileName}}"
msgstr "ទាញយក · {{profileName}}"

msgctxt "explore.toolbar.forward"
msgid "Forward"
msgstr "ទៅមុខ"

msgctxt "explore.toolbar.fullLayout"
msgid "Show full layout"
msgstr "បង្ហាញប្លង់ពេញ"

msgctxt "explore.toolbar.grabUnavailable"
msgid "Open a video, playlist, or channel to download it"
msgstr "បើកវីដេអូ បញ្ជីចាក់ ឬប៉ុស្តិ៍ដើម្បីទាញយកវា"

msgctxt "explore.toolbar.home"
msgid "YouTube home"
msgstr "ទំព័រដើម YouTube"

msgctxt "explore.toolbar.interactiveHint"
msgid "Interactive Download: choose format, subtitles and more…"
msgstr "ទាញយកអន្តរកម្ម៖ ជ្រើសរើសទម្រង់ អក្សររត់ និងច្រើនទៀត…"

msgctxt "explore.toolbar.offsiteDownload"
msgid "Download this link"
msgstr "ទាញយកតំណនេះ"

msgctxt "explore.toolbar.offsiteHint"
msgid "Explore only browses YouTube."
msgstr "Explore រុករកតែ YouTube ប៉ុណ្ណោះ។"

msgctxt "explore.toolbar.offsiteHintHost"
msgid "Explore only browses YouTube. {{host}}"
msgstr "Explore រុករកតែ YouTube ប៉ុណ្ណោះ។ {{host}}"

msgctxt "explore.toolbar.reload"
msgid "Reload"
msgstr "ផ្ទុកឡើងវិញ"

msgctxt "explore.toolbar.searchTooLong"
msgid "That search is too long."
msgstr "ការស្វែងរកនោះវែងពេក។"

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "ជ្រើសរើសរបៀបដាក់ឈ្មោះឯកសារដែលបានទាញយក។ ចុចលើ token ដើម្បីបញ្ចូលវា។ ប្រើ / ដើម្បីតម្រៀបការទាញយកទៅក្នុងថត។"

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "បញ្ចូលគំរូឈ្មោះឯកសារ។"

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "លុប / ដែលលើស — ថតនីមួយៗត្រូវការឈ្មោះ។"

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "លុបតួអក្សរដែលមិនត្រូវបានអនុញ្ញាតក្នុងឈ្មោះឯកសារ៖ \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "ឈ្មោះថតនោះមិនត្រូវបានអនុញ្ញាតទេ។ ជៀសវាង . និង .. និងឈ្មោះបម្រុងទុកដូចជា CON។"

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "បន្ថែម {title} ឬ {id} ទៅឈ្មោះឯកសារ ដើម្បីឱ្យការទាញយកនីមួយៗមានឈ្មោះផ្ទាល់ខ្លួន។"

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} មិនអាចដាក់ឈ្មោះថតបានទេ — គុណភាពមិនត្រូវបានដឹងរហូតដល់ការទាញយកចាប់ផ្តើម។"

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "{ ឬ } មិនត្រូវគ្នា — រុំ token ដូចជា {title}។"

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "គំរូវែងពេក។"

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "token មិនស្គាល់ {{token}}។"

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "បើគ្មាន {id} Arroxy មិនអាចរកឃើញធាតុបញ្ជីចាក់ដែលបានទាញយករួច ឬបង្កើតបញ្ជីចាក់ .m3u បានទេ។"

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "គំរូឈ្មោះឯកសារ"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "មិនអាចប្រើបាន ដោយសារគំរូឈ្មោះឯកសាររបស់អ្នកមិនរួមបញ្ចូល {id} ឬតម្រៀបការទាញយកទៅក្នុងថត។"

msgctxt "filenameTemplate.previewPlaylist"
msgid "In a playlist"
msgstr "ក្នុងបញ្ជីចាក់"

msgctxt "filenameTemplate.previewSingle"
msgid "Single video"
msgstr "វីដេអូតែមួយ"

msgctxt "filenameTemplate.profileOverrideDescription"
msgid "Leave empty to inherit the global template."
msgstr "ទុកទទេដើម្បីទទួលយកគំរូសកល។"

msgctxt "filenameTemplate.profileOverrideLabel"
msgid "Filename template"
msgstr "គំរូឈ្មោះឯកសារ"

msgctxt "fileType.auto"
msgid "Auto"
msgstr "ស្វ័យប្រវត្តិ"

msgctxt "fileType.autoValue"
msgid "Auto (.{{ext}})"
msgstr "ស្វ័យប្រវត្តិ (.{{ext}})"

msgctxt "fileType.description.auto"
msgid "The picked streams decide the file type."
msgstr "ស្ទ្រីមដែលបានជ្រើសរើសកំណត់ប្រភេទឯកសារ។"

msgctxt "fileType.description.mkv"
msgid "Holds any codec. Some TVs and phones can't open it."
msgstr "ផ្ទុក codec បានគ្រប់ប្រភេទ។ ទូរទស្សន៍ និងទូរស័ព្ទមួយចំនួនមិនអាចបើកវាបានទេ។"

msgctxt "fileType.description.mp4"
msgid "Plays almost everywhere. VP9 in an MP4 won't play video in QuickTime."
msgstr "ចាក់បានស្ទើរតែគ្រប់ទីកន្លែង។ VP9 ក្នុង MP4 មិនបង្ហាញវីដេអូក្នុង QuickTime ទេ។"

msgctxt "fileType.description.webm"
msgid "Open format for browsers. Holds only VP9 or AV1 with Opus."
msgstr "ទម្រង់បើកចំហសម្រាប់កម្មវិធីរុករក។ ផ្ទុកតែ VP9 ឬ AV1 ជាមួយ Opus ប៉ុណ្ណោះ។"

msgctxt "fileType.mkv"
msgid "MKV"
msgstr "MKV"

msgctxt "fileType.mp4"
msgid "MP4"
msgstr "MP4"

msgctxt "fileType.mp4CaveatAv1"
msgid "AV1 in an MP4 needs a recent Mac to play in QuickTime. H.264 plays everywhere."
msgstr "AV1 ក្នុង MP4 ត្រូវការ Mac ថ្មីៗ ដើម្បីចាក់ក្នុង QuickTime។ H.264 ចាក់បានគ្រប់ទីកន្លែង។"

msgctxt "fileType.mp4CaveatVp9"
msgid "VP9 in an MP4 won't play video in QuickTime. H.264 plays everywhere."
msgstr "VP9 ក្នុង MP4 មិនបង្ហាញវីដេអូក្នុង QuickTime ទេ។ H.264 ចាក់បានគ្រប់ទីកន្លែង។"

msgctxt "fileType.profileMark"
msgid "Profile"
msgstr "ប្រវត្តិរូប"

msgctxt "fileType.smartTvNoWebm"
msgid "WebM isn't offered with Smart TV: it can't hold H.264."
msgstr "WebM មិនមានជាមួយ Smart TV ទេ: វាមិនអាចផ្ទុក H.264 បានទេ។"

msgctxt "fileType.webm"
msgid "WebM"
msgstr "WebM"

msgctxt "fileType.webmBlocked"
msgid "WebM can't hold {{codec}}. Choose MKV or MP4."
msgstr "WebM មិនអាចផ្ទុក {{codec}} បានទេ។ សូមជ្រើស MKV ឬ MP4។"

msgctxt "formatLabel.audioFallback"
msgid "Audio"
msgstr "សំឡេង"

msgctxt "formatLabel.audioOnlyDot"
msgid "Audio only · {{audio}}"
msgstr "តែសំឡេង · {{audio}}"

msgctxt "formatLabel.videoDot"
msgid "{{resolution}} · {{audio}}"
msgstr "{{resolution}} · {{audio}}"

msgctxt "hdrPreference.auto"
msgid "Auto"
msgstr "ស្វ័យប្រវត្តិ"

msgctxt "hdrPreference.description"
msgid "Auto picks HDR when this screen can show it, otherwise SDR. HDR looks washed out on regular screens."
msgstr "ស្វ័យប្រវត្តិជ្រើស HDR នៅពេលអេក្រង់នេះអាចបង្ហាញវាបាន បើមិនដូច្នោះទេ SDR។ HDR មើលទៅស្លេកលើអេក្រង់ធម្មតា។"

msgctxt "hdrPreference.hdr"
msgid "HDR"
msgstr "HDR"

msgctxt "hdrPreference.label"
