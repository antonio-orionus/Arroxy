msgstr "តាមដានក្តារតម្បៀតខ្ទាស់"

msgctxt "wizard.url.clipboard.toggleDescription"
msgid "Auto-fill the URL field when you copy a video link."
msgstr "បំពេញវាល URL ដោយស្វ័យប្រវត្តិនៅពេលអ្នកចម្លងតំណវីដេអូ។"

msgctxt "wizard.url.clipboard.useCopiedLink"
msgid "Use copied link"
