msgstr "បន្តការទាញយកនៅផ្ទៃខាងក្រោយបន្ទាប់ពីបិទផ្ទាំងបង្អួច។"

msgctxt "wizard.url.concurrentDownloads.description"
msgid "How many queued items download at the same time. More at once finishes a long queue sooner, but raises the chance a site limits you."
msgstr "ចំនួនធាតុក្នុងជួរដែលទាញយកក្នុងពេលតែមួយ។ ច្រើនក្នុងពេលតែមួយបញ្ចប់ជួរវែងលឿនជាង ប៉ុន្តែបង្កើនឱកាសដែលគេហទំព័រកំណត់អ្នក។"

msgctxt "wizard.url.concurrentDownloads.label"
msgid "Downloads at once"
msgstr "ការទាញយកក្នុងពេលតែមួយ"

msgctxt "wizard.url.concurrentDownloads.unit"
msgid "downloads"
msgstr "ការទាញយក"

msgctxt "wizard.url.cookies.banWarning"
msgid "Sites like YouTube may flag — and sometimes ban — accounts whose cookies are used by yt-dlp. Use a throwaway account when possible."
msgstr "គេហទំព័រដូចជា YouTube អាចសម្គាល់ — ហើយពេលខ្លះហាមឃាត់ — គណនីដែល cookies របស់វាត្រូវបានប្រើដោយ yt-dlp។ ប្រើគណនីបណ្តោះអាសន្ននៅពេលអាចធ្វើបាន។"

msgctxt "wizard.url.cookies.browserHelp"
msgid "Reads cookies directly from the browser. The browser must be closed for Chromium-family browsers."
msgstr "អាន cookies ដោយផ្ទាល់ពីកម្មវិធីរុករក។ កម្មវិធីរុករកត្រូវតែបិទសម្រាប់កម្មវិធីរុករកគ្រួសារ Chromium។"

