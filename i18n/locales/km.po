msgid "WebM can't hold {{codec}}, so the file type went back to Auto."
msgstr "WebM មិនអាចផ្ទុក {{codec}} បាន ដូច្នេះប្រភេទឯកសារបានត្រឡប់ទៅស្វ័យប្រវត្តិវិញ។"

msgctxt "wizard.formats.sizeUnknown"
msgid "Size unknown"
msgstr "មិនដឹងទំហំ"

