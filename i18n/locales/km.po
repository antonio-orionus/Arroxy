msgctxt "repair.causes.pairIncomplete.body"
msgid "Choose both below, or reset them to default."
msgstr "សូមជ្រើសរើសទាំងពីរនៅខាងក្រោម ឬកំណត់ឱ្យត្រឡប់ទៅលំនាំដើមវិញ។"

msgctxt "repair.causes.pairIncomplete.title"
msgid "FFmpeg and FFprobe have to be set together"
msgstr "FFmpeg និង FFprobe ត្រូវតែកំណត់ជាមួយគ្នា"

msgctxt "repair.causes.permissionDenied.body"
msgid "Try again. If it keeps failing, choose a copy you trust below."
msgstr "សូមព្យាយាមម្ដងទៀត។ បើនៅតែបរាជ័យ សូមជ្រើសរើសច្បាប់ចម្លងដែលអ្នកទុកចិត្តនៅខាងក្រោម។"

msgctxt "repair.causes.permissionDenied.title"
msgid "Your system won't let Arroxy run a tool"
msgstr "ប្រព័ន្ធរបស់អ្នកមិនអនុញ្ញាតឱ្យ Arroxy ដំណើរការឧបករណ៍មួយទេ"

msgctxt "repair.causes.spawnFailed.body"
msgid "Try again. If it keeps failing, choose a working copy below."
msgstr "សូមព្យាយាមម្ដងទៀត។ បើនៅតែបរាជ័យ សូមជ្រើសរើសច្បាប់ចម្លងដែលដំណើរការបាននៅខាងក្រោម។"

msgctxt "repair.causes.spawnFailed.title"
msgid "A tool is missing or won't start"
msgstr "ឧបករណ៍មួយបាត់ ឬមិនចាប់ផ្ដើម"

msgctxt "repair.causes.timeout.body"
msgid "This is often a security scan on first run. Try again."
msgstr "ជារឿយៗនេះគឺដោយសារការស្កេនសុវត្ថិភាពនៅពេលដំណើរការលើកដំបូង។ សូមព្យាយាមម្ដងទៀត។"

msgctxt "repair.causes.timeout.title"
msgid "A tool took too long to respond"
msgstr "ឧបករណ៍មួយឆ្លើយតបយូរពេក"

msgctxt "repair.causes.unknown.body"
msgid "Try again, or open the setup log for details."
msgstr "សូមព្យាយាមម្ដងទៀត ឬបើកកំណត់ហេតុការរៀបចំដើម្បីមើលព័ត៌មានលម្អិត។"

msgctxt "repair.causes.unknown.title"
msgid "Something went wrong during setup"
msgstr "មានអ្វីមួយមិនប្រក្រតីអំឡុងពេលរៀបចំ"

msgctxt "repair.deps.ffmpeg"
msgid "FFmpeg"
msgstr "FFmpeg"

msgctxt "repair.deps.ffprobe"
msgid "FFprobe"
msgstr "FFprobe"

msgctxt "repair.deps.ytDlp"
msgid "yt-dlp"
msgstr "yt-dlp"

msgctxt "repair.groups.engine"
msgid "Download engine"
msgstr "ម៉ាស៊ីនទាញយក"

msgctxt "repair.groups.media"
msgid "Media tools"
msgstr "ឧបករណ៍មេឌៀ"

msgctxt "repair.installing.homebrew"
msgid "Installing with Homebrew… This can take a few minutes."
msgstr "កំពុងដំឡើងជាមួយ Homebrew… នេះអាចចំណាយពេលពីរបីនាទី។"

msgctxt "repair.installing.winget"
msgid "Installing with WinGet… This can take a few minutes."
msgstr "កំពុងដំឡើងជាមួយ WinGet… នេះអាចចំណាយពេលពីរបីនាទី។"

msgctxt "repair.manual.intro"
msgid "Point Arroxy at copies you already have, or install them another way."
msgstr "ចង្អុលឱ្យ Arroxy ទៅកាន់ច្បាប់ចម្លងដែលអ្នកមានរួចហើយ ឬដំឡើងវាតាមវិធីផ្សេង។"

msgctxt "repair.manual.linuxHint"
msgid "You can also install yt-dlp and ffmpeg with your package manager, then click Try again."
msgstr "អ្នកក៏អាចដំឡើង yt-dlp និង ffmpeg ដោយប្រើកម្មវិធីគ្រប់គ្រងកញ្ចប់របស់អ្នក រួចចុច \"ព្យាយាមម្ដងទៀត\"។"

msgctxt "repair.manual.toggle"
msgid "Set it up manually"
msgstr "រៀបចំដោយខ្លួនឯង"

msgctxt "repair.stopped.body"
msgid "Try again, or point Arroxy at tools you already have below."
msgstr "សូមព្យាយាមម្ដងទៀត ឬចង្អុលឱ្យ Arroxy ទៅកាន់ឧបករណ៍ដែលអ្នកមានរួចហើយនៅខាងក្រោម។"

msgctxt "repair.stopped.title"
msgid "Setup stopped"
msgstr "ការរៀបចំបានឈប់"

msgctxt "repair.title"
msgid "Setup needs your help"
msgstr "ការរៀបចំត្រូវការជំនួយពីអ្នក"

msgctxt "selectionOrder.editorTitle"
msgid "How this profile picks"
msgstr "របៀបដែលប្រវត្តិរូបនេះជ្រើសរើស"

msgctxt "selectionOrder.rank.aacFileType.label"
msgid "AAC audio"
msgstr "សំឡេង AAC"

msgctxt "selectionOrder.rank.aacFileType.reason"
msgid "fits MP4 players"
msgstr "សមនឹងកម្មវិធីចាក់ MP4"

msgctxt "selectionOrder.rank.aacSmartTv.label"
msgid "AAC audio"
msgstr "សំឡេង AAC"

msgctxt "selectionOrder.rank.aacSmartTv.reason"
msgid "plays everywhere"
msgstr "ចាក់បានគ្រប់ទីកន្លែង"

msgctxt "selectionOrder.rank.codec.label"
msgid "AV1, then VP9, then H.264"
msgstr "AV1 បន្ទាប់មក VP9 បន្ទាប់មក H.264"

msgctxt "selectionOrder.rank.codec.reason"
msgid "sharpest at a given size"
msgstr "ច្បាស់បំផុតក្នុងទំហំដូចគ្នា"

msgctxt "selectionOrder.rank.codecH264First.label"
msgid "H.264, then VP9, then AV1"
msgstr "H.264 បន្ទាប់មក VP9 បន្ទាប់មក AV1"

msgctxt "selectionOrder.rank.codecH264First.reason"
msgid "this profile's codec"
msgstr "កូឌិករបស់ប្រវត្តិរូបនេះ"

msgctxt "selectionOrder.rank.codecVp9First.label"
msgid "VP9, then H.264, then AV1"
msgstr "VP9 បន្ទាប់មក H.264 បន្ទាប់មក AV1"

msgctxt "selectionOrder.rank.codecVp9First.reason"
msgid "this profile's codec"
msgstr "កូឌិករបស់ប្រវត្តិរូបនេះ"

msgctxt "selectionOrder.rank.fps.label"
msgid "Highest frame rate"
msgstr "អត្រាស៊ុមខ្ពស់បំផុត"

msgctxt "selectionOrder.rank.fps.reason"
msgid "smoother motion"
msgstr "ចលនារលូនជាង"

msgctxt "selectionOrder.rank.h264.label"
msgid "H.264 video"
msgstr "វីដេអូ H.264"

msgctxt "selectionOrder.rank.h264.reason"
msgid "plays on every device"
msgstr "ចាក់បានលើគ្រប់ឧបករណ៍"

msgctxt "selectionOrder.rank.hdrFirst.label"
msgid "HDR before SDR"
msgstr "HDR មុន SDR"

msgctxt "selectionOrder.rank.hdrFirst.reason"
msgid "richer colour on HDR screens"
msgstr "ពណ៌សម្បូរជាងលើអេក្រង់ HDR"

msgctxt "selectionOrder.rank.hdrFirst.reasonScreen"
msgid "this screen shows HDR"
msgstr "អេក្រង់នេះបង្ហាញ HDR"

msgctxt "selectionOrder.rank.hdrSdrFirst.label"
msgid "SDR before HDR"
msgstr "SDR មុន HDR"

msgctxt "selectionOrder.rank.hdrSdrFirst.reason"
msgid "looks right on any screen"
msgstr "មើលទៅត្រឹមត្រូវលើគ្រប់អេក្រង់"

msgctxt "selectionOrder.rank.hdrSdrFirst.reasonScreen"
msgid "this screen isn't HDR"
msgstr "អេក្រង់នេះមិនបង្ហាញ HDR"

msgctxt "selectionOrder.rank.mp4Streams.label"
msgid "MP4 streams"
msgstr "ស្ទ្រីម MP4"

msgctxt "selectionOrder.rank.mp4Streams.reason"
msgid "ready for an MP4 file"
msgstr "រួចរាល់សម្រាប់ឯកសារ MP4"

msgctxt "selectionOrder.rank.nativeCompatible.label"
msgid "Stereo audio"
msgstr "សំឡេង Stereo"

msgctxt "selectionOrder.rank.nativeSource.profile"
msgid "this profile"
msgstr "ប្រវត្តិរូបនេះ"

msgctxt "selectionOrder.rank.nativeSource.settings"
msgid "from Settings"
msgstr "ពីការកំណត់"

msgctxt "selectionOrder.rank.nativeSurround.label"
msgid "Surround audio when offered"
msgstr "សំឡេង Surround នៅពេលមាន"

msgctxt "selectionOrder.rank.opus.label"
msgid "Opus audio"
msgstr "សំឡេង Opus"

msgctxt "selectionOrder.rank.opus.reason"
msgid "fits WebM"
msgstr "សមនឹង WebM"

msgctxt "selectionOrder.rank.original.label"
msgid "Original streams, not AI-upscaled ones"
msgstr "ស្ទ្រីមដើម មិនមែនស្ទ្រីមដែលពង្រីកដោយ AI"

msgctxt "selectionOrder.rank.original.reason"
msgid "an upscaled copy is taller but adds no real detail"
msgstr "ច្បាប់ដែលពង្រីកខ្ពស់ជាង ប៉ុន្តែមិនបន្ថែមលម្អិតពិតទេ"

msgctxt "selectionOrder.rank.protocol.label"
msgid "Direct downloads before streamed copies"
msgstr "ការទាញយកដោយផ្ទាល់ មុនច្បាប់ចម្លងស្ទ្រីម"

msgctxt "selectionOrder.rank.protocol.reason"
msgid "the same picture, downloaded faster"
msgstr "រូបភាពដូចគ្នា ទាញយកលឿនជាង"

msgctxt "selectionOrder.rank.resolution.label"
msgid "Up to {{tier}}p"
msgstr "រហូតដល់ {{tier}}p"

msgctxt "selectionOrder.rank.resolution.reason"
msgid "your limit"
msgstr "ដែនកំណត់របស់អ្នក"

msgctxt "selectionOrder.rank.resolutionBest.label"
msgid "Highest resolution"
msgstr "គុណភាពបង្ហាញខ្ពស់បំផុត"

msgctxt "selectionOrder.rank.resolutionBest.reason"
msgid "no limit set"
msgstr "មិនបានកំណត់ដែនកំណត់"

msgctxt "selectionOrder.rank.sitePreference.label"
msgid "Streams the site does not mark down"
msgstr "ស្ទ្រីមដែលគេហទំព័រមិនដាក់ចំណាត់ថ្នាក់ទាប"

msgctxt "selectionOrder.rank.sitePreference.reason"
msgid "skips damaged, watermarked and fallback copies"
msgstr "រំលងច្បាប់ខូច ច្បាប់មានវ៉ាត់ម៉ាក និងច្បាប់បម្រុង"

msgctxt "selectionOrder.rank.size.label"
msgid "Larger file"
msgstr "ឯកសារធំជាង"

msgctxt "selectionOrder.rank.size.reason"
msgid "more detail at the same settings"
msgstr "លម្អិតជាងនៅការកំណត់ដូចគ្នា"

msgctxt "selectionOrder.rank.source.label"
msgid "Enhanced-bitrate streams first"
msgstr "ស្ទ្រីម Bitrate ប្រសើរជាង មុនគេ"

msgctxt "selectionOrder.rank.source.reason"
msgid "more detail at the same resolution"
msgstr "លម្អិតជាងនៅគុណភាពបង្ហាញដូចគ្នា"

msgctxt "selectionOrder.summary.fileType.auto"
msgid "file type from the streams"
msgstr "ប្រភេទឯកសារតាមស្ទ្រីម"

msgctxt "selectionOrder.summary.fileType.explicit"
msgid "saves as .{{ext}}"
msgstr "រក្សាទុកជា .{{ext}}"

msgctxt "selectionOrder.summary.goal.bestPicture"
msgid "best picture"
msgstr "រូបភាពល្អបំផុត"

msgctxt "selectionOrder.summary.goal.smartTv"
msgid "plays on any device"
msgstr "ចាក់បានលើគ្រប់ឧបករណ៍"

msgctxt "selectionOrder.whyLabel"
msgid "Why this one?"
msgstr "ហេតុអ្វីជាមួយនេះ?"

msgctxt "selectionOrder.whyTitle"
msgid "Why the profile picked this"
msgstr "ហេតុអ្វីប្រវត្តិរូបជ្រើសរើសមួយនេះ"

msgctxt "share.copied"
msgid "Copied!"
msgstr "បានចម្លង!"

msgctxt "share.copyLink"
msgid "Copy link"
msgstr "ចម្លងតំណ"

msgctxt "share.defaultMessage"
msgid ""
"Arroxy — free, open-source video downloader for Windows, macOS & Linux. Works with YouTube, Vimeo, Twitch, and 2000+ sites.\n"
"4K · HDR · MP3 · Shorts · Subtitles · SponsorBlock"
msgstr ""
"Arroxy — កម្មវិធីទាញយកវីដេអូឥតគិតថ្លៃ និងកូដចំហសម្រាប់ Windows, macOS និង Linux។ ដំណើរការជាមួយ YouTube, Vimeo, Twitch និងគេហទំព័រជាង 2000។\n"
"4K · HDR · MP3 · Shorts · អក្សររត់ · SponsorBlock"

msgctxt "share.description"
msgid "Arroxy is free and open-source. Sharing helps more people discover it."
msgstr "Arroxy ឥតគិតថ្លៃ និងជាកូដចំហ។ ការចែករំលែកជួយឱ្យមនុស្សកាន់តែច្រើនស្គាល់វា។"

msgctxt "share.footerLabel"
msgid "Share"
msgstr "ចែករំលែក"

msgctxt "share.footerTooltip"
msgid "Share Arroxy"
msgstr "ចែករំលែក Arroxy"

msgctxt "share.shareAction"
msgid "Share Arroxy"
msgstr "ចែករំលែក Arroxy"

msgctxt "share.title"
msgid "Share Arroxy"
msgstr "ចែករំលែក Arroxy"

msgctxt "splash.cancel"
msgid "Having trouble? Set it up manually"
msgstr "មានបញ្ហា? រៀបចំដោយដៃ"

msgctxt "splash.greeting"
msgid "Hey, welcome back!"
msgstr "សួស្តី សូមស្វាគមន៍ការត្រឡប់មកវិញ!"

msgctxt "splash.setup.bytes"
msgid "{{done}} of {{total}}"
msgstr "{{done}} ក្នុងចំណោម {{total}}"

#. Plural form "other" for km: used for counts like 0, 1, 2, 3, 4, 5.
msgctxt "splash.setup.left.minutes_other"
msgid "about {{count}} min left"
msgstr "នៅសល់ប្រហែល {{count}} នាទី"

msgctxt "splash.setup.left.underMinute"
msgid "less than a minute left"
msgstr "នៅសល់តិចជាងមួយនាទី"

msgctxt "splash.setup.note.engine"
msgid "Keeps downloads working when sites change."
msgstr "ធ្វើឱ្យការទាញយកនៅតែដំណើរការ នៅពេលគេហទំព័រផ្លាស់ប្ដូរ។"

msgctxt "splash.setup.note.firstRun"
msgid "This happens once. Arroxy keeps these tools and updates them itself."
msgstr "នេះកើតឡើងតែម្ដងប៉ុណ្ណោះ។ Arroxy រក្សាទុកឧបករណ៍ទាំងនេះ ហើយធ្វើបច្ចុប្បន្នភាពវាដោយខ្លួនឯង។"

msgctxt "splash.setup.note.media"
msgid "This happens once. Arroxy keeps them for future updates."
msgstr "នេះកើតឡើងតែម្ដងប៉ុណ្ណោះ។ Arroxy រក្សាទុកវាសម្រាប់ការធ្វើបច្ចុប្បន្នភាពនៅពេលក្រោយ។"

msgctxt "splash.setup.stage.checking"
msgid "Checking everything works"
msgstr "កំពុងពិនិត្យថាអ្វីៗដំណើរការល្អ"

msgctxt "splash.setup.stage.connecting"
msgid "Connecting…"
msgstr "កំពុងតភ្ជាប់…"

msgctxt "splash.setup.stage.downloadingBoth"
msgid "Downloading the download engine and media tools"
msgstr "កំពុងទាញយកម៉ាស៊ីនទាញយក និងឧបករណ៍មេឌៀ"

msgctxt "splash.setup.stage.downloadingEngine"
msgid "Downloading the download engine"
msgstr "កំពុងទាញយកម៉ាស៊ីនទាញយក"

msgctxt "splash.setup.stage.downloadingMedia"
msgid "Downloading the media tools"
msgstr "កំពុងទាញយកឧបករណ៍មេឌៀ"

msgctxt "splash.setup.stage.unpacking"
msgid "Unpacking the media tools"
msgstr "កំពុងបកឧបករណ៍មេឌៀ"

msgctxt "splash.setup.title.engine"
msgid "Updating the download engine"
