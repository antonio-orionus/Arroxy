msgstr "ផ្លូវកាត់នេះត្រូវបានប្រើដោយកម្មវិធីផ្សេង — ជ្រើសរើសមួយផ្សេងទៀត។"

msgctxt "wizard.url.hotkey.hintLabel"
msgid "Or press"
msgstr "ឬចុច"

msgctxt "wizard.url.hotkey.hintTooltip"
msgid "Copy a video link anywhere, press this shortcut, and Arroxy queues it with your active profile — no need to switch windows."
msgstr "ចម្លងតំណវីដេអូពីកន្លែងណាក៏ដោយ ចុចផ្លូវកាត់នេះ ហើយ Arroxy ដាក់វាក្នុងជួរជាមួយប្រវត្តិរូបសកម្មរបស់អ្នក — មិនចាំបាច់ប្តូរផ្ទាំងបង្អួចទេ។"

msgctxt "wizard.url.hotkey.hintTooltipSettings"
msgid "Change or turn it off in Settings."
msgstr "ប្តូរ ឬបិទវានៅក្នុងការកំណត់។"

msgctxt "wizard.url.hotkey.recording"
