msgid "Back"
msgstr "Enrere"

msgctxt "common.cancel"
msgid "Cancel"
msgstr "Cancel·la"

msgctxt "common.close"
msgid "Close"
msgstr "Tanca"

msgctxt "common.continue"
msgid "Continue"
msgstr "Continua"

msgctxt "common.dismiss"
msgid "Dismiss"
msgstr "Descarta"

msgctxt "common.loading"
msgid "Loading"
msgstr "S'està carregant"

msgctxt "common.retry"
