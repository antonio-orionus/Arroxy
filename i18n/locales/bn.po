msgctxt "about.button"
msgid "About"
msgstr "সম্পর্কে"

msgctxt "about.githubLink"
msgid "GitHub"
msgstr "GitHub"

msgctxt "about.licenseLine"
msgid "MIT License · by Antonio Orionus"
msgstr "MIT লাইসেন্স · Antonio Orionus দ্বারা"

msgctxt "about.openTitle"
msgid "About Arroxy"
msgstr "Arroxy সম্পর্কে"

msgctxt "about.tagline"
msgid "Fast, friendly downloader for YouTube and 2000+ other sites."
msgstr "YouTube ও 2000+ অন্যান্য সাইটের জন্য দ্রুত ও সহজ ডাউনলোডার।"

msgctxt "about.thirdPartyNotices"
msgid "View third-party notices"
msgstr "তৃতীয়-পক্ষ নোটিশ দেখুন"

msgctxt "about.websiteLink"
msgid "Website"
msgstr "ওয়েবসাইট"

msgctxt "aiUpscaled.allow"
msgid "Allow"
msgstr "অনুমতি দিন"

msgctxt "aiUpscaled.description"
msgid "YouTube offers some old videos in sizes it made with AI. Skip keeps the original streams; you can still pick an upscaled one by hand."
msgstr "YouTube কিছু পুরোনো ভিডিও এমন আকারে দেয় যা সে AI দিয়ে বানিয়েছে। “বাদ দিন” মূল স্ট্রিমগুলো রাখে; তবু আপনি নিজে একটি আপস্কেল করা স্ট্রিম বেছে নিতে পারেন।"

msgctxt "aiUpscaled.label"
msgid "AI-upscaled streams"
msgstr "AI দিয়ে আপস্কেল করা স্ট্রিম"

msgctxt "aiUpscaled.skip"
msgid "Skip"
msgstr "বাদ দিন"

msgctxt "app.feedback"
msgid "Feedback"
msgstr "মতামত"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "Arroxy পছন্দ হচ্ছে? আপনার মতামত জানাতে চাই! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "লগ"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "ডায়াগনস্টিক ফাইল সংরক্ষণ করুন"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "আপনার লগ ও অ্যাপের তথ্য Downloads ফোল্ডারে একটি ফাইলে রাখে, যা GitHub issue-তে সংযুক্ত করার জন্য প্রস্তুত। আপনার ব্যবহারকারী ফোল্ডারের নাম সরিয়ে দেওয়া হয়; ভিডিও লিংক ও শিরোনাম থেকে যায়।"

msgctxt "app.styleHint"
msgid "New: choose Aurora or Minimal here"
msgstr "নতুন: এখানে Aurora বা মিনিমাল বেছে নিন"

msgctxt "app.theme"
msgid "Theme"
msgstr "থিম"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "জুম ইন"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "জুম আউট"

msgctxt "common.back"
msgid "Back"
msgstr "পেছনে"

msgctxt "common.cancel"
msgid "Cancel"
msgstr "বাতিল"

msgctxt "common.continue"
msgid "Continue"
msgstr "চালিয়ে যান"

msgctxt "common.dismiss"
msgid "Dismiss"
msgstr "বন্ধ করুন"

msgctxt "common.loading"
msgid "Loading"
msgstr "লোড হচ্ছে…"

msgctxt "common.retry"
msgid "Retry"
msgstr "আবার চেষ্টা করুন"

msgctxt "common.startOver"
msgid "Start over"
msgstr "নতুন করে শুরু করুন"

msgctxt "dialogs.closeToTray.detail"
msgid "Arroxy keeps running and finishes active downloads. Change this later in Advanced settings."
msgstr "Arroxy চলতে থাকে এবং সক্রিয় ডাউনলোড শেষ করে। পরে উন্নত সেটিংসে পরিবর্তন করুন।"

msgctxt "dialogs.closeToTray.hide"
msgid "Hide to tray"
msgstr "ট্রেতে লুকান"

msgctxt "dialogs.closeToTray.message"
msgid "Hide Arroxy to the system tray when closing?"
msgstr "বন্ধ করার সময় Arroxy সিস্টেম ট্রেতে লুকাবে?"

msgctxt "dialogs.closeToTray.quit"
msgid "Quit"
msgstr "বন্ধ করুন"

msgctxt "dialogs.closeToTray.remember"
msgid "Don't ask again"
msgstr "আর জিজ্ঞেস করবেন না"

msgctxt "dialogs.quitWithActiveDownloads.confirm"
msgid "Cancel Downloads & Quit"
msgstr "ডাউনলোড বাতিল করুন ও বন্ধ করুন"

msgctxt "dialogs.quitWithActiveDownloads.detail"
msgid "Pause to resume later, or cancel to discard progress."
msgstr "পরে আবার শুরু করতে বিরতি দিন, অথবা অগ্রগতি বাতিল করতে বাতিল করুন।"

msgctxt "dialogs.quitWithActiveDownloads.keep"
msgid "Keep Downloading"
msgstr "ডাউনলোড চালিয়ে যান"

#. Plural form "one" for bn: used for counts like 0, 1.
msgctxt "dialogs.quitWithActiveDownloads.message_one"
msgid "{{count}} download in progress"
msgstr "{{count}}টি ডাউনলোড চলছে"

#. Plural form "other" for bn: used for counts like 2, 3, 4, 5, 6, 7.
msgctxt "dialogs.quitWithActiveDownloads.message_other"
msgid "{{count}} downloads in progress"
msgstr "{{count}}টি ডাউনলোড চলছে"

msgctxt "dialogs.quitWithActiveDownloads.pause"
msgid "Pause Downloads & Quit"
msgstr "ডাউনলোড বিরতি দিয়ে বের হন"

msgctxt "dialogs.rendererCrashed.detail"
msgid "The renderer process crashed ({{reason}}). Reload to try again."
msgstr "রেন্ডারার প্রক্রিয়া ক্র্যাশ হয়েছে ({{reason}})। আবার চেষ্টা করতে পুনরায় লোড করুন।"

msgctxt "dialogs.rendererCrashed.message"
msgid "Arroxy encountered a problem"
msgstr "Arroxy একটি সমস্যার সম্মুখীন হয়েছে"

msgctxt "dialogs.rendererCrashed.quit"
msgid "Quit"
msgstr "বন্ধ করুন"

msgctxt "dialogs.rendererCrashed.reload"
msgid "Reload"
msgstr "পুনরায় লোড করুন"

msgctxt "donate.copied"
msgid "Copied!"
msgstr "কপি হয়েছে!"

msgctxt "donate.copyAddress"
msgid "Copy address"
msgstr "ঠিকানা কপি করুন"

msgctxt "donate.description"
msgid "Arroxy is free and open-source, with no ads or paid tier. Donations are optional and buy no influence over the roadmap."
msgstr "Arroxy বিনামূল্যের ও ওপেন-সোর্স, কোনো বিজ্ঞাপন বা পেইড প্ল্যান নেই। দান ঐচ্ছিক এবং রোডম্যাপে কোনো প্রভাব দেয় না।"

msgctxt "donate.footerLabel"
msgid "Donate"
msgstr "দান করুন"

msgctxt "donate.footerTooltip"
msgid "Support Arroxy"
msgstr "Arroxy-কে সমর্থন করুন"

msgctxt "donate.qrAlt"
msgid "{{coin}} donation address QR code"
msgstr "{{coin}} দানের ঠিকানার QR কোড"

msgctxt "donate.title"
msgid "Support Arroxy"
msgstr "Arroxy-কে সমর্থন করুন"

msgctxt "donate.warning"
msgid "Crypto payments are irreversible. Send only on the network shown, and compare the whole address."
msgstr "ক্রিপ্টো পেমেন্ট ফেরত নেওয়া যায় না। শুধু দেখানো নেটওয়ার্কে পাঠান এবং পুরো ঠিকানা মিলিয়ে নিন।"

msgctxt "errors.ytdlp.ageRestricted"
msgid "This video is age-restricted and cannot be downloaded without a signed-in account."
msgstr "এই ভিডিওটি বয়স-সীমাবদ্ধ এবং লগইন করা অ্যাকাউন্ট ছাড়া ডাউনলোড করা যাবে না।"

msgctxt "errors.ytdlp.botBlock"
msgid "Bot protection triggered. The IP you're using is most likely flagged (datacenter range or busy VPN exit). Change your IP or pick a different VPN endpoint and retry. If it keeps failing, this may be a temporary site-side change — Arroxy updates its download engine on launch, so the fix lands automatically once it ships."
msgstr "বট সুরক্ষা চালু হয়েছে। আপনি যে IP ব্যবহার করছেন সেটি সম্ভবত ফ্ল্যাগ করা (ডেটাসেন্টার রেঞ্জ বা ব্যস্ত VPN এক্সিট)। আপনার IP পরিবর্তন করুন বা ভিন্ন VPN এন্ডপয়েন্ট বেছে নিন এবং আবার চেষ্টা করুন। যদি বারবার ব্যর্থ হয়, এটি সাইটের দিক থেকে সাময়িক পরিবর্তন হতে পারে — Arroxy চালু হওয়ার সময় ডাউনলোড ইঞ্জিন আপডেট করে, তাই সমাধান এলে আপনাআপনি পৌঁছে যাবে।"

msgctxt "errors.ytdlp.chunkTransferFailure"
msgid "The server kept cutting the download mid-stream, and Arroxy gave up after retrying. This usually hits the largest video formats (4K HDR / high-bitrate VP9). Retry, switch network/VPN, or pick a lower-resolution format."
msgstr "সার্ভার বারবার ডাউনলোড মাঝপথে কেটে দিচ্ছিল এবং Arroxy বারবার চেষ্টার পর হাল ছেড়ে দিয়েছে। এটি সাধারণত সবচেয়ে বড় ভিডিও ফরম্যাটে (4K HDR / উচ্চ বিটরেট VP9) হয়। আবার চেষ্টা করুন, নেটওয়ার্ক/VPN বদলান, অথবা কম রেজোলিউশনের ফরম্যাট বেছে নিন।"

msgctxt "errors.ytdlp.drmProtected"
msgid "This video is DRM-protected. Arroxy can't remove DRM, so the file can't be downloaded."
msgstr "এই ভিডিওটি DRM-সুরক্ষিত। Arroxy DRM সরাতে পারে না, তাই ফাইলটি ডাউনলোড করা যাবে না।"

msgctxt "errors.ytdlp.geoBlocked"
msgid "This video is not available in your region."
msgstr "এই ভিডিওটি আপনার অঞ্চলে পাওয়া যায় না।"

msgctxt "errors.ytdlp.ipBlock"
msgid "Your IP address appears to be blocked. Try again later or use a VPN."
msgstr "আপনার IP ঠিকানা YouTube দ্বারা ব্লক মনে হচ্ছে। পরে আবার চেষ্টা করুন বা VPN ব্যবহার করুন।"

msgctxt "errors.ytdlp.loginRequired"
msgid "This video needs a signed-in account."
msgstr "এই ভিডিওর জন্য সাইন ইন করা অ্যাকাউন্ট লাগবে।"

msgctxt "errors.ytdlp.missingDependency"
msgid "Arroxy could not find FFmpeg or FFprobe. Run setup again or set an FFmpeg location, then retry the download."
msgstr "Arroxy FFmpeg বা FFprobe খুঁজে পায়নি। আবার সেটআপ চালান বা FFmpeg-এর অবস্থান ঠিক করে দিন, তারপর ডাউনলোড আবার করুন।"

msgctxt "errors.ytdlp.network"
msgid "Network error. Check your connection and retry."
msgstr "নেটওয়ার্ক ত্রুটি। আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন।"

msgctxt "errors.ytdlp.outOfDiskSpace"
msgid "Not enough disk space. Free up space and retry."
msgstr "পর্যাপ্ত ডিস্ক স্পেস নেই। জায়গা খালি করে আবার চেষ্টা করুন।"

msgctxt "errors.ytdlp.outputNotWritable"
msgid "Arroxy can't write to the download folder. It may be read-only, on a locked drive, or blocked by your system's privacy settings. Choose another folder or allow access, then retry."
msgstr "Arroxy ডাউনলোড ফোল্ডারে লিখতে পারছে না। ফোল্ডারটি শুধু-পঠনযোগ্য হতে পারে, লক করা ড্রাইভে থাকতে পারে, অথবা আপনার সিস্টেমের গোপনীয়তা সেটিংস দ্বারা অবরুদ্ধ হতে পারে। অন্য ফোল্ডার বেছে নিন বা অ্যাক্সেসের অনুমতি দিন, তারপর আবার চেষ্টা করুন।"

msgctxt "errors.ytdlp.parse"
msgid "Couldn't parse the response from the site. The site may have changed how it serves videos. Arroxy updates its download engine on launch — retry in a few minutes once the fix ships."
msgstr "সাইট থেকে আসা রেসপন্স পার্স করা যায়নি। সাইটটি হয়তো ভিডিও সরবরাহের পদ্ধতি বদলেছে। Arroxy চালু হওয়ার সময় ডাউনলোড ইঞ্জিন আপডেট করে — কয়েক মিনিট পর ফিক্স আসলে আবার চেষ্টা করুন।"

msgctxt "errors.ytdlp.postprocessFailure"
msgid "The download finished, but post-processing (merge / mux / convert) failed. Often this is a transient ffmpeg issue — retry, and if it persists try a different format combination."
msgstr "ডাউনলোড শেষ হয়েছে কিন্তু post-processing (merge / mux / convert) ব্যর্থ হয়েছে। প্রায়ই এটি একটি সাময়িক ffmpeg সমস্যা — আবার চেষ্টা করুন, এবং সমস্যা চলতে থাকলে অন্য একটি ফরম্যাট কম্বিনেশন চেষ্টা করুন।"

msgctxt "errors.ytdlp.rateLimit"
msgid "The site is rate-limiting requests from this connection."
msgstr "সাইটটি এই সংযোগ থেকে আসা অনুরোধ সীমিত করছে।"

msgctxt "errors.ytdlp.unavailable"
msgid "This video is unavailable — it may be private, deleted, or region-locked."
msgstr "এই ভিডিওটি পাওয়া যাচ্ছে না — এটি ব্যক্তিগত, মুছে ফেলা বা অঞ্চল-লক হতে পারে।"

msgctxt "errors.ytdlp.unknown"
msgid "Download failed. See the raw output below."
msgstr "ডাউনলোড ব্যর্থ। নিচে raw output দেখুন।"

msgctxt "errors.ytdlp.unsupportedUrl"
msgid "Arroxy doesn't support this URL. Try a link from a different site."
msgstr "Arroxy এই URL সমর্থন করে না। অন্য কোনো সাইটের লিংক চেষ্টা করুন।"

msgctxt "explore.error.loadBody"
msgid "Check your connection, then try again."
msgstr "আপনার সংযোগ পরীক্ষা করুন, তারপর আবার চেষ্টা করুন।"

msgctxt "explore.error.loadTitle"
msgid "This page didn't load"
msgstr "এই পৃষ্ঠাটি লোড হয়নি"

msgctxt "explore.error.openSettings"
msgid "Open Settings"
msgstr "সেটিংস খুলুন"

msgctxt "explore.error.proxyBody"
msgid "Check the proxy in Settings, then try again."
msgstr "সেটিংসে প্রক্সি পরীক্ষা করুন, তারপর আবার চেষ্টা করুন।"

msgctxt "explore.error.proxyTitle"
msgid "Explore can't connect through your proxy"
msgstr "অন্বেষণ আপনার প্রক্সির মাধ্যমে সংযোগ করতে পারছে না"

msgctxt "explore.error.retry"
msgid "Retry"
msgstr "আবার চেষ্টা করুন"

msgctxt "explore.linkCallout.body"
msgid "Right-click any video, playlist or channel link on the page to download it with your active profile, pick another profile, or open the step-by-step flow."
msgstr "পেজের যেকোনো ভিডিও, প্লেলিস্ট বা চ্যানেলের লিংকে রাইট-ক্লিক করে সক্রিয় প্রোফাইল দিয়ে ডাউনলোড করুন, অন্য প্রোফাইল বেছে নিন, অথবা ইন্টারঅ্যাকটিভ ডাউনলোড খুলুন।"

msgctxt "explore.linkCallout.title"
msgid "Right-click a link to download it"
msgstr "ডাউনলোড করতে লিংকে রাইট-ক্লিক করুন"

msgctxt "explore.linkMenu.copyLink"
msgid "Copy link"
msgstr "লিঙ্ক কপি করুন"

msgctxt "explore.linkMenu.downloadWith"
msgid "Download with"
msgstr "প্রোফাইল দিয়ে ডাউনলোড"

msgctxt "explore.newBadge"
msgid "New"
msgstr "নতুন"

msgctxt "explore.notice.body"
msgid "Find a video on YouTube or any other site and download it from here — no copying links. Sign in to a site here to download videos that need an account."
msgstr "YouTube বা যেকোনো অন্য সাইটে ভিডিও খুঁজে এখান থেকেই ডাউনলোড করুন — লিংক কপি করতে হবে না। অ্যাকাউন্ট প্রয়োজন এমন ভিডিও ডাউনলোড করতে এখানে কোনো সাইটে সাইন ইন করুন।"

msgctxt "explore.notice.continue"
msgid "Continue"
msgstr "চালিয়ে যান"

msgctxt "explore.notice.riskBody"
msgid "Sites like YouTube may flag — and sometimes ban — accounts used with download tools like Arroxy. Use an account you can afford to lose, not your main one."
msgstr "YouTube-এর মতো সাইট Arroxy-এর মতো ডাউনলোড টুলের সঙ্গে ব্যবহৃত অ্যাকাউন্ট ফ্ল্যাগ — এবং কখনও কখনও নিষিদ্ধ — করতে পারে। যে অ্যাকাউন্ট হারালে ক্ষতি নেই সেটি ব্যবহার করুন, আপনার মূল অ্যাকাউন্ট নয়।"

msgctxt "explore.notice.riskTitle"
msgid "Sign in with a secondary account"
msgstr "একটি দ্বিতীয় অ্যাকাউন্ট দিয়ে সাইন ইন করুন"

msgctxt "explore.notice.title"
msgid "Browse the web right inside Arroxy"
msgstr "Arroxy-এর ভেতরেই ওয়েব ব্রাউজ করুন"

msgctxt "explore.nudge.browser"
msgid "Downloads use your browser's cookies, not your Explore sign-in."
msgstr "ডাউনলোডে আপনার ব্রাউজারের কুকিজ ব্যবহার হয়, অন্বেষণের সাইন-ইন নয়।"

msgctxt "explore.nudge.file"
msgid "Downloads use your cookies file, not your Explore sign-in."
msgstr "ডাউনলোডে আপনার কুকিজ ফাইল ব্যবহার হয়, অন্বেষণের সাইন-ইন নয়।"

msgctxt "explore.nudge.notNow"
msgid "Not now"
msgstr "এখন নয়"

msgctxt "explore.nudge.off"
msgid "Cookies are off, so downloads don't use your Explore sign-in."
msgstr "কুকিজ বন্ধ আছে, তাই ডাউনলোডে আপনার অন্বেষণের সাইন-ইন ব্যবহার হয় না।"

msgctxt "explore.nudge.useExplore"
msgid "Use Explore sign-in"
msgstr "অন্বেষণের সাইন-ইন ব্যবহার করুন"

msgctxt "explore.settings.description"
msgid "Browse YouTube or any other site inside Arroxy, and sign in for videos that need an account."
msgstr "Arroxy-এর ভেতরে YouTube বা যেকোনো অন্য সাইট ব্রাউজ করুন, এবং অ্যাকাউন্ট প্রয়োজন এমন ভিডিওর জন্য সাইন ইন করুন।"

msgctxt "explore.settings.idleUnload"
msgid "Free memory while away"
msgstr "দূরে থাকার সময় মেমরি খালি করুন"

msgctxt "explore.settings.idleUnloadDescription"
msgid "After 5 minutes on another tab, closes the YouTube home or search page. Coming back reloads it, which takes a few seconds."
msgstr "অন্য ট্যাবে ৫ মিনিট পর YouTube-এর হোম বা সার্চ পেজ বন্ধ করে দেয়। ফিরে এলে এটি আবার লোড হয়, যাতে কয়েক সেকেন্ড লাগে।"

msgctxt "explore.settings.searchEngine"
msgid "Search engine"
msgstr "সার্চ ইঞ্জিন"

msgctxt "explore.settings.searchEngineDescription"
msgid "Where text typed in the address bar is searched. Links open as typed."
msgstr "ঠিকানা বারে লেখা টেক্সট কোথায় খোঁজা হবে। লিংক যেমন লেখা হয় তেমনই খোলে।"

msgctxt "explore.settings.showTab"
msgid "Show the Explore tab"
msgstr "অন্বেষণ ট্যাব দেখান"

msgctxt "explore.settings.showTabDescription"
msgid "Turning it off also stops downloads from using your Explore sign-in."
msgstr "এটি বন্ধ করলে ডাউনলোডেও আপনার অন্বেষণের সাইন-ইন ব্যবহার হওয়া বন্ধ হয়।"

msgctxt "explore.settings.signOut"
msgid "Sign out of Explore"
msgstr "অন্বেষণ থেকে সাইন আউট করুন"

msgctxt "explore.settings.signOutConfirm"
msgid "Sign out"
msgstr "সাইন আউট"

msgctxt "explore.settings.signOutConfirmBody"
msgid "This clears your sign-ins and browsing data in Explore, on every site. Downloads that need an account will fail until you sign in again."
msgstr "এতে অন্বেষণে সব সাইটে আপনার সাইন-ইন ও ব্রাউজিং ডেটা মুছে যাবে। আবার সাইন ইন না করা পর্যন্ত অ্যাকাউন্ট প্রয়োজন এমন ডাউনলোড ব্যর্থ হবে।"

msgctxt "explore.settings.signOutConfirmTitle"
msgid "Sign out of Explore?"
msgstr "অন্বেষণ থেকে সাইন আউট করবেন?"

msgctxt "explore.settings.signOutDescription"
msgid "Clears your sign-ins and browsing data in Explore, on every site."
msgstr "অন্বেষণে সব সাইটে আপনার সাইন-ইন ও ব্রাউজিং ডেটা মুছে দেয়।"

msgctxt "explore.settings.title"
msgid "Explore"
msgstr "অন্বেষণ"

msgctxt "explore.tabLabel"
msgid "Explore"
msgstr "অন্বেষণ"

msgctxt "explore.toolbar.adBlock.accountNote"
msgid "YouTube may push back on ad blockers for signed-in accounts."
msgstr "সাইন ইন করা অ্যাকাউন্টের ক্ষেত্রে YouTube অ্যাড ব্লকারে বাধা দিতে পারে।"

msgctxt "explore.toolbar.adBlock.aria"
msgid "Ad blocker"
msgstr "অ্যাড ব্লকার"

msgctxt "explore.toolbar.adBlock.off"
msgid "Ad blocker: off — click to turn on"
msgstr "অ্যাড ব্লকার: বন্ধ — চালু করতে ক্লিক করুন"

msgctxt "explore.toolbar.adBlock.on"
msgid "Ad blocker: on — click to turn off"
msgstr "অ্যাড ব্লকার: চালু — বন্ধ করতে ক্লিক করুন"

msgctxt "explore.toolbar.adBlock.starting"
msgid "Ad blocker: starting — click to turn off"
msgstr "অ্যাড ব্লকার: চালু হচ্ছে — বন্ধ করতে ক্লিক করুন"

msgctxt "explore.toolbar.adBlock.unavailable"
msgid "Ad blocker: unavailable, its filter lists couldn't be downloaded — click to turn off"
msgstr "অ্যাড ব্লকার: পাওয়া যাচ্ছে না, এর ফিল্টার তালিকা ডাউনলোড করা যায়নি — বন্ধ করতে ক্লিক করুন"

msgctxt "explore.toolbar.addressAria"
msgid "Address"
msgstr "ঠিকানা"

msgctxt "explore.toolbar.addressPlaceholder"
msgid "Search {{engine}} or open any site (Vimeo, Instagram…)"
msgstr "{{engine}} দিয়ে খুঁজুন বা যেকোনো সাইট খুলুন (Vimeo, Instagram…)"

msgctxt "explore.toolbar.aria"
msgid "Explore browser controls"
msgstr "অন্বেষণ ব্রাউজার নিয়ন্ত্রণ"

msgctxt "explore.toolbar.back"
msgid "Back"
msgstr "পেছনে"

msgctxt "explore.toolbar.compactLayout"
msgid "Compact layout"
msgstr "কমপ্যাক্ট লেআউট"

msgctxt "explore.toolbar.downloadWithProfile"
msgid "Download · {{profileName}}"
msgstr "ডাউনলোড · {{profileName}}"

msgctxt "explore.toolbar.forward"
msgid "Forward"
msgstr "সামনে"

msgctxt "explore.toolbar.fullLayout"
msgid "Show full layout"
msgstr "পূর্ণ লেআউট দেখান"

msgctxt "explore.toolbar.grabUnavailable"
msgid "Open a video, playlist, or channel to download it"
msgstr "ডাউনলোড করতে একটি ভিডিও, প্লেলিস্ট বা চ্যানেল খুলুন"

msgctxt "explore.toolbar.home"
msgid "YouTube home"
msgstr "YouTube হোম"

msgctxt "explore.toolbar.interactiveHint"
msgid "Interactive Download: choose format, subtitles and more…"
msgstr "ইন্টারঅ্যাকটিভ ডাউনলোড: ফরম্যাট, সাবটাইটেল ও আরও বেছে নিন…"

msgctxt "explore.toolbar.refusedHint"
msgid "Explore can't open that address."
msgstr "অন্বেষণ ওই ঠিকানাটি খুলতে পারছে না।"

msgctxt "explore.toolbar.reload"
msgid "Reload"
msgstr "রিলোড করুন"

msgctxt "explore.toolbar.searchTooLong"
msgid "That search is too long."
msgstr "এই সার্চটি অনেক বড়।"

msgctxt "filenameTemplate.description"
msgid "Choose how downloaded files are named. Click a token to insert it. Use / to sort downloads into folders."
msgstr "ডাউনলোড করা ফাইলের নাম কীভাবে হবে তা বেছে নিন। যুক্ত করতে একটি টোকেনে ক্লিক করুন। ডাউনলোডগুলো ফোল্ডারে সাজাতে / ব্যবহার করুন।"

msgctxt "filenameTemplate.error.empty"
msgid "Enter a filename template."
msgstr "একটি ফাইলের নামের টেমপ্লেট লিখুন।"

msgctxt "filenameTemplate.error.empty-segment"
msgid "Remove the extra / — every folder needs a name."
msgstr "বাড়তি / সরান — প্রতিটি ফোল্ডারের একটি নাম দরকার।"

msgctxt "filenameTemplate.error.forbidden-char"
msgid "Remove characters that aren't allowed in filenames: \\ : * ? \" < > |"
msgstr "ফাইলের নামে অনুমোদিত নয় এমন অক্ষর সরান: \\ : * ? \" < > |"

msgctxt "filenameTemplate.error.invalid-segment"
msgid "That folder name isn't allowed. Avoid . and .. and reserved names like CON."
msgstr "এই ফোল্ডারের নাম অনুমোদিত নয়। . এবং .. এবং CON-এর মতো সংরক্ষিত নাম এড়িয়ে চলুন।"

msgctxt "filenameTemplate.error.no-unique-token"
msgid "Add {title} or {id} to the filename so each download gets its own name."
msgstr "প্রতিটি ডাউনলোড যেন নিজস্ব নাম পায় সে জন্য ফাইলের নামে {title} বা {id} যোগ করুন।"

msgctxt "filenameTemplate.error.resolution-in-dir"
msgid "{resolution} can't name a folder — the quality isn't known until the download starts."
msgstr "{resolution} দিয়ে ফোল্ডারের নাম দেওয়া যায় না — ডাউনলোড শুরু না হওয়া পর্যন্ত মান জানা যায় না।"

msgctxt "filenameTemplate.error.stray-brace"
msgid "Unmatched { or } — wrap tokens like {title}."
msgstr "জোড়াহীন { বা } — টোকেন {title} এর মতো লিখুন।"

msgctxt "filenameTemplate.error.too-long"
msgid "Template is too long."
msgstr "টেমপ্লেটটি অনেক দীর্ঘ।"

msgctxt "filenameTemplate.error.unknown-token"
msgid "Unknown token {{token}}."
msgstr "অজানা টোকেন {{token}}।"

msgctxt "filenameTemplate.idWarning"
msgid "Without {id}, Arroxy can't detect already-downloaded playlist items or generate .m3u playlists."
msgstr "{id} ছাড়া Arroxy আগে ডাউনলোড করা প্লেলিস্ট আইটেম শনাক্ত করতে বা .m3u প্লেলিস্ট তৈরি করতে পারে না।"

msgctxt "filenameTemplate.label"
msgid "Filename template"
msgstr "ফাইলের নামের টেমপ্লেট"

msgctxt "filenameTemplate.m3uDisabled"
msgid "Unavailable because your filename template either doesn't include {id} or sorts downloads into folders."
msgstr "উপলব্ধ নয়, কারণ আপনার ফাইলের নামের টেমপ্লেটে {id} নেই অথবা এটি ডাউনলোডগুলো ফোল্ডারে সাজায়।"

msgctxt "filenameTemplate.previewPlaylist"
msgid "In a playlist"
msgstr "প্লেলিস্টে"

msgctxt "filenameTemplate.previewSingle"
msgid "Single video"
msgstr "একক ভিডিও"

msgctxt "filenameTemplate.profileOverrideDescription"
msgid "Leave empty to inherit the global template."
msgstr "সাধারণ টেমপ্লেট ব্যবহার করতে ফাঁকা রাখুন।"

msgctxt "filenameTemplate.profileOverrideLabel"
msgid "Filename template"
msgstr "ফাইলের নামের টেমপ্লেট"

msgctxt "fileType.auto"
msgid "Auto"
msgstr "অটো"

msgctxt "fileType.autoValue"
msgid "Auto (.{{ext}})"
msgstr "অটো (.{{ext}})"

msgctxt "fileType.description.auto"
msgid "The picked streams decide the file type."
msgstr "বেছে নেওয়া স্ট্রিম ফাইলের ধরন ঠিক করে।"

msgctxt "fileType.description.mkv"
msgid "Holds any codec. Some TVs and phones can't open it."
msgstr "যেকোনো কোডেক রাখতে পারে। কিছু টিভি ও ফোন এটি খুলতে পারে না।"

msgctxt "fileType.description.mp4"
msgid "Plays almost everywhere. VP9 in an MP4 won't play video in QuickTime."
msgstr "প্রায় সব জায়গায় চলে। MP4-এ VP9 থাকলে QuickTime-এ ভিডিও চলবে না।"

msgctxt "fileType.description.webm"
msgid "Open format for browsers. Holds only VP9 or AV1 with Opus."
msgstr "ব্রাউজারের জন্য উন্মুক্ত ফরম্যাট। শুধু Opus সহ VP9 বা AV1 রাখতে পারে।"

msgctxt "fileType.mkv"
msgid "MKV"
msgstr "MKV"

msgctxt "fileType.mp4"
msgid "MP4"
msgstr "MP4"

msgctxt "fileType.mp4CaveatAv1"
msgid "AV1 in an MP4 needs a recent Mac to play in QuickTime. H.264 plays everywhere."
msgstr "MP4-এ AV1 QuickTime-এ চালাতে নতুন Mac লাগবে। H.264 সব জায়গায় চলে।"

msgctxt "fileType.mp4CaveatVp9"
msgid "VP9 in an MP4 won't play video in QuickTime. H.264 plays everywhere."
msgstr "MP4-এ VP9 থাকলে QuickTime-এ ভিডিও চলবে না। H.264 সব জায়গায় চলে।"

msgctxt "fileType.profileMark"
msgid "Profile"
msgstr "প্রোফাইল"

msgctxt "fileType.smartTvNoWebm"
msgid "WebM isn't offered with Smart TV: it can't hold H.264."
msgstr "স্মার্ট TV-তে WebM দেওয়া হয় না: এটি H.264 রাখতে পারে না।"

msgctxt "fileType.webm"
msgid "WebM"
msgstr "WebM"

msgctxt "fileType.webmBlocked"
msgid "WebM can't hold {{codec}}. Choose MKV or MP4."
msgstr "WebM {{codec}} রাখতে পারে না। MKV বা MP4 বেছে নিন।"

msgctxt "formatLabel.audioFallback"
msgid "Audio"
msgstr "অডিও"

msgctxt "formatLabel.audioOnlyDot"
msgid "Audio only · {{audio}}"
msgstr "শুধু অডিও · {{audio}}"

msgctxt "formatLabel.videoDot"
msgid "{{resolution}} · {{audio}}"
msgstr "{{resolution}} · {{audio}}"

msgctxt "hdrPreference.auto"
msgid "Auto"
msgstr "অটো"

msgctxt "hdrPreference.description"
msgid "Auto picks HDR when this screen can show it, otherwise SDR. HDR looks washed out on regular screens."
msgstr "এই স্ক্রিন HDR দেখাতে পারলে অটো HDR বেছে নেয়, নইলে SDR। সাধারণ স্ক্রিনে HDR ফ্যাকাশে দেখায়।"

msgctxt "hdrPreference.hdr"
msgid "HDR"
msgstr "HDR"

msgctxt "hdrPreference.label"
msgid "HDR video"
msgstr "HDR ভিডিও"

msgctxt "hdrPreference.sdr"
msgid "SDR"
msgstr "SDR"

msgctxt "language.label"
msgid "Language"
msgstr "ভাষা"

#. Plural form "one" for bn: used for counts like 0, 1.
msgctxt "notifications.exploreSignInRetrying_one"
msgid "Signed in with Explore — retrying 1 link"
msgstr "অন্বেষণ দিয়ে সাইন ইন হয়েছে — 1টি লিংক আবার চেষ্টা হচ্ছে"

#. Plural form "other" for bn: used for counts like 2, 3, 4, 5, 6, 7.
msgctxt "notifications.exploreSignInRetrying_other"
msgid "Signed in with Explore — retrying {{count}} links"
msgstr "অন্বেষণ দিয়ে সাইন ইন হয়েছে — {{count}}টি লিংক আবার চেষ্টা হচ্ছে"

msgctxt "notifications.exploreSignOutFailed"
msgid "Could not sign out of Explore. Try again."
msgstr "অন্বেষণ থেকে সাইন আউট করা যায়নি। আবার চেষ্টা করুন।"

msgctxt "notifications.filenameFolderTooDeep"
msgid "This folder is too deep for your system. The download may still fail — pick a shorter folder."
msgstr "এই ফোল্ডারটি আপনার সিস্টেমের জন্য অনেক গভীরে। ডাউনলোড তবুও ব্যর্থ হতে পারে — একটি ছোট ফোল্ডার বেছে নিন।"

msgctxt "notifications.filenameTemplateCannotFit"
msgid "This video's name can't fit every part of your template, so the default name was used."
msgstr "এই ভিডিওর নাম আপনার টেমপ্লেটের প্রতিটি অংশে আঁটে না, তাই ডিফল্ট নাম ব্যবহার করা হয়েছে।"

msgctxt "notifications.folderSelectFailed"
