msgctxt "wizard.url.clipboard.toggle"
msgid "Watch clipboard"
msgstr "ক্লিপবোর্ড দেখুন"

msgctxt "wizard.url.clipboard.toggleDescription"
msgid "Auto-fill the URL field when you copy a video link."
msgstr "YouTube লিংক কপি করলে URL ফিল্ড স্বয়ংক্রিয়ভাবে পূরণ হবে।"

