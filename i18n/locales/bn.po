msgstr "ডাউনলোড প্রোফাইল বদলান: {{profileName}}"

msgctxt "wizard.url.profile.switchTitle"
msgid "Switch download profile"
msgstr "ডাউনলোড প্রোফাইল বদলান"

msgctxt "wizard.url.proxy.clear"
msgid "Clear"
msgstr "মুছুন"

msgctxt "wizard.url.proxy.description"
msgid "Route traffic through a proxy — useful for geo-restricted content."
msgstr "প্রক্সির মাধ্যমে ট্র্যাফিক রাউট করুন — ভৌগোলিকভাবে সীমাবদ্ধ কন্টেন্টের জন্য উপযোগী।"

msgctxt "wizard.url.proxy.label"
msgid "Proxy URL"
msgstr "Proxy URL"

msgctxt "wizard.url.proxy.placeholder"
msgid "http://host:port"
msgstr "http://host:port"

msgctxt "wizard.url.quickBulkAllFailed"
msgid "None of those URLs could be prepared"
msgstr "এই URLগুলোর কোনোটি প্রস্তুত করা যায়নি"

msgctxt "wizard.url.quickDownload"
msgid "Quick Download"
msgstr "দ্রুত ডাউনলোড"

msgctxt "wizard.url.quickDownloadTooltip"
msgid "Will download using: {{profileName}}"
msgstr "{{profileName}} ব্যবহার করে ডাউনলোড হবে"

msgctxt "wizard.url.quickFailed"
msgid "Couldn't add this one: {{error}}"
msgstr "এটি যোগ করা যায়নি: {{error}}"

#. Plural form "one" for bn: used for counts like 0, 1.
msgctxt "wizard.url.quickPartialFailed_one"
msgid "Queued what worked. {{count}} URL could not be prepared."
msgstr "যা কাজ করেছে তা কিউতে যোগ হয়েছে। {{count}}টি URL প্রস্তুত করা যায়নি।"

#. Plural form "other" for bn: used for counts like 2, 3, 4, 5, 6, 7.
msgctxt "wizard.url.quickPartialFailed_other"
msgid "Queued what worked. {{count}} URLs could not be prepared."
msgstr "যা কাজ করেছে তা কিউতে যোগ হয়েছে। {{count}}টি URL প্রস্তুত করা যায়নি।"

msgctxt "wizard.url.quickPrepareFailed"
msgid "Queue item could not be prepared"
msgstr "কিউ আইটেম প্রস্তুত করা যায়নি"

msgctxt "wizard.url.quickPreparing"
msgid "Preparing"
msgstr "প্রস্তুত হচ্ছে"

msgctxt "wizard.url.quickProbeFailed"
msgid "Probe failed"
msgstr "প্রোব ব্যর্থ হয়েছে"

msgctxt "wizard.url.quickQueued"
msgid "Added to queue"
msgstr "কিউতে যোগ করা হয়েছে"

msgctxt "wizard.url.quickSingleOnly"
msgid "Paste a video, playlist, channel, or search URL to get started."
msgstr "শুরু করতে ভিডিও, প্লেলিস্ট, চ্যানেল বা সার্চ URL পেস্ট করুন।"

msgctxt "wizard.url.settings.behaviorDescription"
msgid "Global behavior that affects profile-driven downloads too."
msgstr "গ্লোবাল আচরণ যা প্রোফাইল-চালিত ডাউনলোডকেও প্রভাবিত করে।"

msgctxt "wizard.url.settings.behaviorHeading"
msgid "Download behavior"
msgstr "ডাউনলোড আচরণ"

msgctxt "wizard.url.settings.inputHeading"
msgid "Input"
msgstr "ইনপুট"

msgctxt "wizard.url.style.aurora.description"
msgid "Glass panels over a moving sky. Needs graphics acceleration."
msgstr "চলমান আকাশের ওপর কাচের মতো প্যানেল। গ্রাফিক্স অ্যাক্সেলারেশন লাগে।"

msgctxt "wizard.url.style.aurora.label"
msgid "Aurora"
msgstr "Aurora"

msgctxt "wizard.url.style.minimal.description"
msgid "Solid, quiet surfaces. Runs light on any computer."
msgstr "নিরেট, শান্ত পৃষ্ঠতল। যেকোনো কম্পিউটারে হালকাভাবে চলে।"

msgctxt "wizard.url.style.minimal.label"
msgid "Minimal"
msgstr "মিনিমাল"

msgctxt "wizard.url.style.modeDescription"
msgid "Both styles come in light and dark."
msgstr "দুটি স্টাইলই লাইট ও ডার্ক মোডে পাওয়া যায়।"

msgctxt "wizard.url.style.modeLabel"
msgid "Style"
msgstr "স্টাইল"

msgctxt "wizard.url.style.panelDescription"
msgid "How Arroxy looks. Switch between light and dark in the footer."
msgstr "Arroxy দেখতে কেমন হবে। নিচের ফুটারে লাইট ও ডার্কের মধ্যে বদলান।"

msgctxt "wizard.url.style.panelTitle"
msgid "Appearance"
msgstr "চেহারা"

msgctxt "wizard.url.style.unavailableNotice"
msgid "{{style}} needs graphics acceleration, which isn't available right now, so Arroxy is showing {{fallback}}."
msgstr "{{style}}-এর জন্য গ্রাফিক্স অ্যাক্সেলারেশন দরকার, যা এখন পাওয়া যাচ্ছে না, তাই Arroxy {{fallback}} দেখাচ্ছে।"

msgctxt "wizard.url.tabs.profiles"
msgid "Profiles"
msgstr "প্রোফাইল"

msgctxt "wizard.url.tabs.settings"
msgid "Settings"
msgstr "সেটিংস"
