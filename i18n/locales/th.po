msgctxt "app.feedback"
msgid "Feedback"
msgstr "ข้อเสนอแนะ"

msgctxt "app.feedbackNudge"
msgid "Enjoying Arroxy? I'd love to hear from you! 💬"
msgstr "ชอบ Arroxy ไหม? ฉันอยากฟังความคิดเห็นของคุณ! 💬"

msgctxt "app.logs"
msgid "Logs"
msgstr "บันทึก"

msgctxt "app.saveDiagnostics"
msgid "Save diagnostics file"
msgstr "บันทึกไฟล์การวินิจฉัย"

msgctxt "app.saveDiagnosticsDescription"
msgid "Puts your logs and app details into one file in Downloads, ready to attach to a GitHub issue. Your user folder name is removed; video links and titles stay."
msgstr "รวมบันทึกและรายละเอียดแอปไว้ในไฟล์เดียวในโฟลเดอร์ดาวน์โหลด พร้อมแนบกับ issue บน GitHub ชื่อโฟลเดอร์ผู้ใช้ของคุณจะถูกลบออก แต่ลิงก์และชื่อวิดีโอจะยังคงอยู่"

msgctxt "app.zoomIn"
msgid "Zoom in"
msgstr "ซูมเข้า"

msgctxt "app.zoomOut"
msgid "Zoom out"
msgstr "ซูมออก"

