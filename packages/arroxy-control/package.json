{
	"name": "arroxy-control",
	"version": "0.1.0",
	"description": "Zod schemas and JSON Schema for the Arroxy Control API: the versioned, public protocol that phones, local AI agents and scripts use to drive the Arroxy desktop app.",
	"keywords": [
		"arroxy",
		"control-api",
		"downloader",
		"esm",
		"json-schema",
		"mcp",
		"protocol",
		"remote-control",
		"schema",
		"typescript",
		"yt-dlp",
		"zod"
	],
	"homepage": "https://github.com/antonio-orionus/Arroxy/tree/main/packages/arroxy-control#readme",
	"bugs": {
		"url": "https://github.com/antonio-orionus/Arroxy/issues"
	},
	"license": "MIT",
	"author": "Antonio Orionus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/antonio-orionus/Arroxy.git",
		"directory": "packages/arroxy-control"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vp test run",
		"build": "vp pack",
		"prepack": "bun run typecheck && bun run test && bun run build",
		"pack:dry-run": "bun pm pack --dry-run"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"typescript": "6.0.3",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.2"
}
