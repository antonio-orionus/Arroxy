{
	"name": "arroxy-control",
	"version": "0.1.0",
	"private": true,
	"description": "Zod schemas and JSON Schema for the Arroxy Control API: the versioned, public protocol that phones, local AI agents and scripts use to drive the Arroxy desktop app.",
	"license": "MIT",
	"author": "Antonio Orionus",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vp test run",
		"build": "vp pack"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"typescript": "6.0.3",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.2"
}
