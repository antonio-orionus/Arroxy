{
	"media with a temp folder writes the info-json there": {
		"cwd": "/out",
		"args": [
			"--progress",
			"--progress-template",
			"download:[yt-dlp-bridge:progress] {\"progress\":%(progress.{status,downloaded_bytes,total_bytes,total_bytes_estimate,speed,eta,elapsed,fragment_index,fragment_count})j,\"format_id\":%(info.format_id|null)j}",
			"--print",
			"before_dl:[yt-dlp-bridge:formats] {\"format_id\":%(format_id|null)j,\"filesize\":%(filesize|null)j,\"filesize_approx\":%(filesize_approx|null)j,\"tbr\":%(tbr|null)j,\"duration\":%(duration|null)j,\"requested\":%(requested_formats.:.{format_id,filesize,filesize_approx,tbr}|null)j}",
			"--no-quiet",
			"--no-playlist",
			"--continue",
			"--http-chunk-size",
			"10M",
			"--retries",
			"20",
			"--fragment-retries",
			"20",
			"--retry-sleep",
			"fragment:exp=1:20",
			"--socket-timeout",
			"20",
			"--abort-on-unavailable-fragments",
			"--no-write-subs",
			"--no-write-auto-subs",
			"-f",
			"137+140",
			"--paths",
			"temp:./.arroxy-temp/job/",
			"-o",
			"%(title).200B.%(ext)s",
			"--write-info-json",
			"-o",
			"infojson:.arroxy-temp/job/_arroxy",
			"https://www.youtube.com/watch?v=test"
		]
	},
	"media replaying an info-json under its own base name": {
		"cwd": "/out",
		"args": [
			"--progress",
			"--progress-template",
			"download:[yt-dlp-bridge:progress] {\"progress\":%(progress.{status,downloaded_bytes,total_bytes,total_bytes_estimate,speed,eta,elapsed,fragment_index,fragment_count})j,\"format_id\":%(info.format_id|null)j}",
			"--print",
			"before_dl:[yt-dlp-bridge:formats] {\"format_id\":%(format_id|null)j,\"filesize\":%(filesize|null)j,\"filesize_approx\":%(filesize_approx|null)j,\"tbr\":%(tbr|null)j,\"duration\":%(duration|null)j,\"requested\":%(requested_formats.:.{format_id,filesize,filesize_approx,tbr}|null)j}",
			"--no-quiet",
			"--no-playlist",
			"--load-info-json",
			"./.arroxy-temp/job/item.info.json",
			"--continue",
			"--http-chunk-size",
			"10M",
			"--retries",
			"3",
			"--fragment-retries",
			"20",
			"--retry-sleep",
			"fragment:exp=1:20",
			"--socket-timeout",
			"15",
			"--abort-on-unavailable-fragments",
			"--no-write-subs",
			"--no-write-auto-subs",
			"-f",
			"18",
			"--paths",
			"temp:./.arroxy-temp/job/",
			"-o",
			"%(id)s.%(ext)s",
			"--write-info-json",
			"-o",
			"infojson:.arroxy-temp/job/item"
		]
	},
