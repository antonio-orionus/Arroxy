{
	"name": "yt-dlp-bridge",
	"version": "0.5.0",
	"description": "TypeScript library for safe, no-shell yt-dlp integration: workflow planning, argv generation, process execution, output parsing, and structured errors.",
	"keywords": [
		"argv",
		"command-builder",
		"esm",
		"ffmpeg",
		"mcp",
		"media-downloader",
		"metadata-extraction",
		"no-shell",
		"redaction",
		"structured-errors",
		"subprocess",
		"typescript",
		"video-downloader",
		"youtube-dl",
		"yt-dlp",
		"yt-dlp-node",
		"zod"
	],
	"homepage": "https://github.com/antonio-orionus/Arroxy/tree/main/packages/yt-dlp-bridge#readme",
	"bugs": {
		"url": "https://github.com/antonio-orionus/Arroxy/issues"
	},
	"license": "MIT",
	"author": "Antonio Orionus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/antonio-orionus/Arroxy.git",
		"directory": "packages/yt-dlp-bridge"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./audio-conversion": {
			"types": "./dist/audio-conversion.d.ts",
			"import": "./dist/audio-conversion.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./environment": {
			"types": "./dist/environment.d.ts",
			"import": "./dist/environment.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"import": "./dist/errors.js"
		},
		"./filesystem": {
			"types": "./dist/filesystem.d.ts",
			"import": "./dist/filesystem.js"
		},
		"./info": {
			"types": "./dist/info.d.ts",
			"import": "./dist/info.js"
		},
		"./option-catalog": {
			"types": "./dist/option-catalog.d.ts",
			"import": "./dist/option-catalog.js"
		},
		"./parsers": {
			"types": "./dist/parsers.d.ts",
			"import": "./dist/parsers.js"
		},
		"./redaction": {
			"types": "./dist/redaction.d.ts",
			"import": "./dist/redaction.js"
		},
		"./runner": {
			"types": "./dist/runner.d.ts",
			"import": "./dist/runner.js"
		},
		"./schemas": {
			"types": "./dist/schemas.d.ts",
			"import": "./dist/schemas.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
		"generate:options": "node scripts/generate-ytdlp-option-catalog.mjs",
		"verify:options": "node scripts/verify-ytdlp-option-catalog.mjs",
		"test": "vp test run",
		"typecheck": "tsc --noEmit",
		"prepack": "bun run build",
		"pack:dry-run": "bun pm pack --dry-run"
	},
	"dependencies": {
		"ytdlp-errors": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"typescript": "6.0.3",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=22.13"
	},
	"packageManager": "bun@1.4.2"
}
