{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"ignoreDeprecations": "6.0",
		"lib": ["ES2022"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"declaration": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": false,
		"types": ["node"],
		// Type-check against arroxy-control's sources, so `vp check` needs no
		// build of it first. Bundling still treats it as an external dependency.
		"paths": {"arroxy-control": ["../arroxy-control/src/index.ts"]}
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
