<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.antonio_orionus.Arroxy</id>

  <name>Arroxy</name>
  <summary>Video and audio downloader for YouTube and 2000+ other sites</summary>
  <summary xml:lang="de">Video- und Audio-Downloader für YouTube und über 2000 weitere Websites</summary>
  <summary xml:lang="es">Descargador de vídeo y audio para YouTube y más de 2000 sitios</summary>
  <summary xml:lang="fr">Téléchargeur de vidéo et d'audio pour YouTube et plus de 2000 autres sites</summary>
  <summary xml:lang="hi">YouTube और 2000+ अन्य साइटों के लिए वीडियो और ऑडियो डाउनलोडर</summary>
  <summary xml:lang="ja">YouTube など 2000 以上のサイトに対応した動画・音声ダウンローダー</summary>
  <summary xml:lang="ru">Загрузчик видео и аудио с YouTube и более 2000 других сайтов</summary>
  <summary xml:lang="uk">Завантажувач відео та аудіо з YouTube і понад 2000 інших сайтів</summary>
  <summary xml:lang="zh">从 YouTube 及 2000 多个其他网站下载视频和音频</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Arroxy is a free, open-source desktop app for downloading video and audio from YouTube
      and 2000+ other sites. Paste a link, or browse any site in the built-in Explore browser
      and download what you are watching.
    </p>
    <p>Features:</p>
    <ul>
      <li>Videos, Shorts, playlists and channels in up to 8K HDR at 60 fps</li>
      <li>Audio as MP3, M4A or Opus</li>
      <li>Download profiles that remember how you like each download</li>
      <li>Subtitles in any language, embedded or as separate files</li>
      <li>SponsorBlock and partial downloads built in</li>
      <li>Sign in once in Explore to download private, members-only and age-restricted videos your account can watch</li>
      <li>A download queue with live progress</li>
      <li>Works on Linux, Windows and macOS</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.antonio_orionus.Arroxy.desktop</launchable>

  <url type="homepage">https://github.com/antonio-orionus/Arroxy</url>
  <url type="bugtracker">https://github.com/antonio-orionus/Arroxy/issues</url>

  <keywords>
    <keyword>youtube</keyword>
    <keyword>downloader</keyword>
    <keyword>video</keyword>
    <keyword>audio</keyword>
    <keyword>music</keyword>
    <keyword>mp3</keyword>
    <keyword>mp4</keyword>
    <keyword>subtitle</keyword>
    <keyword>playlist</keyword>
    <keyword>shorts</keyword>
    <keyword>4K</keyword>
    <keyword>HDR</keyword>
  </keywords>

