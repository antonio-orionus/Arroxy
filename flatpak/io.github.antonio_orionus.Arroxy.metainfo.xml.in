      <image>https://raw.githubusercontent.com/antonio-orionus/Arroxy/main/build/Choosing-format-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Choose where to save</caption>
      <image>https://raw.githubusercontent.com/antonio-orionus/Arroxy/main/build/Choosing-destination-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Download queue with parallel progress</caption>
      <image>https://raw.githubusercontent.com/antonio-orionus/Arroxy/main/build/Downloading-in-parallel-screenshot.png</image>
