{
	"name": "arroxy",
	"version": "0.7.3",
	"private": true,
	"description": "Free, open-source video downloader for YouTube and 2000+ other sites, with a built-in browser for sites that need a sign-in.",
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "Antonio Orionus",
		"email": "orionusAI@proton.me",
		"url": "https://x.com/OrionusAI"
	},
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"agents:skills:restore": "bunx skills experimental_install && bun run agents:sync",
		"agents:sync": "bun scripts/agents-sync.ts",
		"bootstrap": "bun scripts/dev-env.ts bootstrap",
		"internal:save": "bun scripts/internal-docs.ts save",
		"internal:sync": "bun scripts/internal-docs.ts link",
		"repair": "bun scripts/dev-env.ts repair",
		"doctor": "bun scripts/dev-env.ts doctor",
		"doctor:json": "bun scripts/dev-env.ts doctor --json",
		"dev": "bun scripts/dev-env.ts run electron",
		"dev:gpu": "bun scripts/dev-env.ts run electron --gpu=force",
		"dev:swiftshader": "bun scripts/dev-env.ts run electron --gpu=swiftshader",
		"dev:sandbox": "bun scripts/dev-env.ts run electron --sandbox",
		"dev:fresh": "bun scripts/dev-env.ts run electron --fresh",
		"dev:anon": "bun scripts/dev-env.ts run electron --anon",
		"dev:mock": "bun scripts/dev-env.ts run mock",
		"gpu:probe": "ELECTRON_DISABLE_SANDBOX=1 electron scripts/electron-gpu-probe.mjs",
		"gpu:probe:force": "ELECTRON_DISABLE_SANDBOX=1 electron scripts/electron-gpu-probe.mjs --mode=force",
		"gpu:probe:sandbox": "electron scripts/electron-gpu-probe.mjs",
		"gpu:probe:software": "ELECTRON_DISABLE_SANDBOX=1 electron scripts/electron-gpu-probe.mjs --mode=software",
		"gpu:probe:swiftshader": "ELECTRON_DISABLE_SANDBOX=1 electron scripts/electron-gpu-probe.mjs --mode=swiftshader",
		"embed:fetch:host": "bun scripts/build/fetchEmbeddedHost.ts",
		"runtime-manifest:generate": "bun scripts/build/runtimeBinaryManifest.ts generate",
		"runtime-manifest:validate": "bun scripts/build/runtimeBinaryManifest.ts validate",
		"runtime-manifest:sign": "bun scripts/build/runtimeBinaryManifest.ts sign",
		"runtime-manifest:local": "bun scripts/build/runtimeBinaryManifest.ts local",
		"with-runtime-manifest": "bash scripts/with-runtime-manifest.sh",
		"dev:runtime-manifest": "bash scripts/with-runtime-manifest.sh bun run dev",
		"dev:local-manifest": "bun run runtime-manifest:local && bash scripts/with-runtime-manifest.sh bun run dev",
		"dev:fresh:runtime-manifest": "bash scripts/with-runtime-manifest.sh bun run dev:fresh",
		"dev:fresh:local-manifest": "bun run runtime-manifest:local && bash scripts/with-runtime-manifest.sh bun run dev:fresh",
		"clean": "rm -rf dist out",
		"build": "bun run errors:build && vp check --no-fmt --no-lint && electron-vite build && bun run check:preload-bundle && bun run check:main-bundle",
		"dist": "bun run clean && bun run build && electron-builder --publish never",
		"dist:win": "bun run clean && bun run build && electron-builder --win --publish never",
		"dist:win:nsis": "bun run clean && bun run build && electron-builder --win nsis --publish never",
		"dist:win:portable": "bun run clean && bun run build && electron-builder --win portable --publish never",
		"dist:win:dir": "bun run clean && bun run build && electron-builder --win dir --publish never",
		"dist:mac": "bun run clean && bun run build && electron-builder --mac --publish never",
		"dist:mac:dir": "bun run clean && bun run build && electron-builder --mac dir --publish never",
		"dist:mac:x64:dir": "bun run clean && bun run build && electron-builder --mac dir --x64 --publish never",
		"dist:mac:arm64:dir": "bun run clean && bun run build && electron-builder --mac dir --arm64 --publish never",
		"dist:linux": "bun run clean && bun run build && ELECTRON_BUILDER_COMPRESSION_LEVEL=5 electron-builder --linux --publish never",
		"dist:linux:arm64": "bun run build && ELECTRON_BUILDER_COMPRESSION_LEVEL=5 electron-builder --linux AppImage tar.gz --arm64 --publish never -c.appImage.artifactName='${productName}-linux-arm64.${ext}'",
		"dist:linux:dir": "bun run clean && bun run build && electron-builder --linux dir --publish never",
		"dist:release": "bun run clean && bun run build && electron-builder --publish always",
		"dist:release:win": "bun run clean && bun run build && electron-builder --win --publish always",
		"dist:release:mac": "bun run clean && bun run build && electron-builder --mac --publish always",
		"dist:release:linux": "bun run clean && bun run build && ELECTRON_BUILDER_COMPRESSION_LEVEL=5 electron-builder --linux --publish always",
		"preview": "electron-vite preview",
		"preview:installer": "electron-builder --mac dmg --arm64 --prepackaged dist/mac-arm64/Arroxy.app --publish never && node -e \"require('node:child_process').execFileSync('open', ['dist/Arroxy-mac-arm64.dmg'])\"",
		"check:static": "bun run errors:build && vp check",
		"check:shell": "node scripts/check-shell.mjs",
		"check:tooling-parity": "node scripts/check-tooling-parity.mjs",
		"check:tooling-contract": "node scripts/check-tooling-contract.mjs",
		"knip": "knip",
		"knip:test-only": "node scripts/find-test-only-exports.mjs",
		"check:loc": "node scripts/check-ts-max-loc.mjs",
		"check:selection-parity": "bun scripts/check-selection-parity.ts",
		"check:pins": "node scripts/check-dependency-pins.mjs",
		"check:filename-parity": "bun scripts/check-filename-parity.ts",
		"check:donation-addresses": "node scripts/check-donation-addresses.mjs",
		"check:changelog": "bun scripts/changelog.ts check",
		"changelog:assemble": "bun scripts/changelog.ts assemble",
		"deps:vuln": "bun scripts/depsVuln.ts",
		"deps:vuln:strict": "bun scripts/depsVuln.ts --threshold moderate",
		"errors:build": "bun run --filter ytdlp-errors build",
		"errors:check": "bun run --filter ytdlp-errors typecheck && bun run --filter ytdlp-errors test && bun run errors:build && bun run --filter ytdlp-errors pack:dry-run",
		"bridge:check": "bun run errors:build && bun run --filter yt-dlp-bridge typecheck && bun run --filter yt-dlp-bridge test && bun run --filter yt-dlp-bridge build && bun run --filter yt-dlp-bridge pack:dry-run",
		"control:check": "bun run --filter arroxy-control typecheck && bun run --filter arroxy-control test && bun run --filter arroxy-control build",
		"mcp:check": "bun run --filter arroxy-mcp typecheck && bun run --filter arroxy-mcp test && bun run --filter arroxy-mcp build",
		"packages:verify-metadata": "node scripts/check-package-publish-metadata.mjs",
		"packages:check": "bun run errors:check && bun run bridge:check && bun run control:check && bun run mcp:check && bun run packages:verify-metadata",
		"check": "vp run quality-gate",
		"test": "vp test run --project node --project jsdom",
		"test:watch": "vp test --project node --project jsdom",
		"test:e2e": "bun run build && xvfb-run -a playwright test",
		"verify:startup": "bunx playwright test tests/e2e/startup-journeys.spec.ts --config playwright.config.ts",
		"probe-sources:capture": "bun scripts/capture-probe-sources.ts",
		"test:e2e:fixtures:dev": "node scripts/e2e-fixtures.mjs",
		"test:e2e:fixtures": "VITE_RELEASE_FLAGS=on bun run build && node scripts/e2e-fixtures.mjs",
		"test:e2e:fixtures:ci": "bun run embed:fetch:host && VITE_RELEASE_FLAGS=on bun run build && node scripts/e2e-fixtures.mjs",
		"test:browser": "bun scripts/dev-env.ts run browser-test",
		"test:browser:smoke": "bun scripts/dev-env.ts run browser-smoke",
		"screenshots:readme": "bun scripts/dev-env.ts run screenshots",
		"profile:backdrop": "node scripts/profile-backdrop.mjs",
		"profile:backdrop:weak": "node scripts/profile-backdrop.mjs --weak-cpu --quick",
		"build:readme": "bun readme-src/build.mjs",
		"check:readme": "bun readme-src/build.mjs --strict",
		"i18n:extract": "bun scripts/i18n-catalog.ts extract",
		"i18n:sync": "bun scripts/i18n-catalog.ts sync",
		"i18n:compile": "bun scripts/i18n-catalog.ts compile",
		"i18n:format": "bun scripts/i18n-catalog.ts format",
		"i18n:status": "bun scripts/i18n-catalog.ts status",
		"i18n:check": "bun scripts/i18n-catalog.ts check",
		"check:app": "bun scripts/check-app-i18n.ts && bun run i18n:check",
		"check:app:unused": "bun scripts/check-app-i18n-unused.ts",
		"check:preload-bundle": "bun scripts/check-preload-bundle.ts",
		"check:main-bundle": "bun scripts/check-main-bundle.ts",
		"check:locales": "bun scripts/check-locale-parity.ts",
		"check:i18n": "bun run check:locales && bun run build:readme && bun run check:app && bun run check:app:unused --strict",
		"check:i18n:complete": "bun scripts/check-app-i18n.ts --strict && bun scripts/i18n-catalog.ts check --complete && bun run check:readme && vp test run --project i18n-complete",
		"smoke": "bun scripts/smoke-youtube.ts",
		"smoke:playlist": "bun scripts/smoke-playlist-presets.ts",
		"smoke:download": "bun scripts/smoke-download.ts",
		"release:beta": "bash scripts/release.sh beta",
		"release:stable": "bash scripts/release.sh stable",
		"prepare": "vp config --no-agent",
		"postinstall": "bun scripts/dev-env.ts electron-payload",
		"react-doctor": "react-doctor",
		"youtube:url-contract": "bun scripts/youtube-url-contract.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@counterscale/tracker": "3.4.1",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/noto-sans-khmer": "5.3.0",
		"@fontsource/poppins": "5.3.0",
		"@ghostery/adblocker-electron": "2.20.1",
		"@tanstack/react-table": "9.3.1",
		"@tanstack/react-virtual": "3.14.17",
		"@url-sanitize/clearurls": "2.0.2",
		"@url-sanitize/core": "2.0.2",
		"arroxy-control": "workspace:*",
		"cacache": "21.0.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"electron-context-menu": "5.1.0",
		"electron-log": "5.4.4",
		"electron-store": "12.0.0",
		"electron-updater": "6.8.9",
		"electron-window-state": "5.0.3",
		"entities": "8.1.0",
		"i18next": "26.4.4",
		"iso-639-2": "3.0.2",
		"lucide-react": "1.55.0",
		"make-fetch-happen": "16.0.1",
		"marked": "18.1.1",
		"pretty-bytes": "7.2.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "17.0.16",
		"semver": "7.8.5",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tar-stream": "3.2.2",
		"tw-animate-css": "1.4.0",
		"yauzl": "3.4.0",
		"yt-dlp-bridge": "workspace:*",
		"ytdlp-errors": "workspace:*",
		"zod": "4.6.7",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@iconify-json/logos": "1.2.16",
		"@iconify-json/simple-icons": "1.2.100",
		"@oxlint/plugins": "1.87.0",
		"@playwright/test": "1.64.0",
		"@svgr/core": "8.1.0",
		"@svgr/plugin-jsx": "8.1.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/cacache": "20.0.1",
		"@types/culori": "4.0.1",
		"@types/gettext-parser": "9.0.0",
		"@types/js-yaml": "4.0.9",
		"@types/make-fetch-happen": "10.0.4",
		"@types/node": "26.6.5",
		"@types/picomatch": "4.0.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/semver": "7.8.0",
		"@types/tar-stream": "3.1.5",
		"@types/yauzl": "3.4.0",
		"@vitejs/plugin-react": "6.1.2",
		"acorn": "8.19.0",
		"culori": "4.0.2",
		"electron": "44.7.0",
		"electron-builder": "26.17.0",
		"electron-vite": "5.0.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-security": "4.2.0",
		"gettext-parser": "9.1.1",
		"js-yaml": "4.3.2",
		"jsdom": "30.1.2",
		"knip": "6.41.0",
		"madge": "8.0.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"picomatch": "4.0.7",
		"postcss": "8.5.30",
		"react-doctor": "0.9.17",
		"shadcn": "4.21.4",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"unplugin-icons": "24.0.0",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"overrides": {
		"@babel/core": "7.29.7",
		"@hono/node-server": "2.1.0",
		"@types/react": "19.2.17",
		"app-builder-lib": "26.15.7",
		"body-parser": "2.3.0",
		"brace-expansion": "5.0.12",
		"builder-util": "26.15.3",
		"dmg-builder": "26.15.7",
		"electron-builder-squirrel-windows": "26.15.7",
		"electron-publish": "26.15.3",
		"esbuild": "0.28.1",
		"fast-uri": "3.1.8",
		"form-data": "4.0.6",
		"hono": "4.13.1",
		"http-cache-semantics": "4.3.0",
		"ip-address": "10.5.0",
		"js-yaml": "4.3.2",
		"nanoid": "3.3.18",
		"postcss": "8.5.30",
		"qs": "6.15.3",
		"tar": "7.5.22",
		"tmp": "0.2.7",
		"undici": "7.29.1",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"bun": "1.4.2",
		"node": "24.21.0"
	},
	"packageManager": "bun@1.4.2",
	"catalog": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vitest": "5.0.3",
		"vite-plus": "1.1.0"
	},
	"desktopName": "arroxy.desktop"
}
